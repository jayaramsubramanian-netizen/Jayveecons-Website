---
/**
 * ApplySection.astro
 * Background: WHITE + blue square grid
 * Max-width: 1440px
 * Layout: two columns — LEFT: copy | RIGHT: contact card
 */
---

<section class="apply-section" id="apply" aria-labelledby="apply-heading">
  <div class="apply-inner">
    <div class="apply-grid">

      <!-- LEFT: intro copy -->
      <div class="apply-left reveal">

        <div class="section-tag">
          <div class="tag-line"></div>
          <span>How to Apply</span>
        </div>

        <h2 class="section-headline" id="apply-heading">
          Send Us <span class="accent">Your CV</span>
        </h2>

        <p>
          We keep the process straightforward. Send your CV and a brief note on what
          you are looking for to our HR team. If your background matches a current
          or upcoming requirement, we will respond within one to two weeks.
        </p>
        <p>
          You do not need to wait for a specific vacancy.
          <strong>We prefer to meet strong candidates before we have an urgent opening</strong>
          — it gives both sides more time to assess the fit properly.
        </p>
        <p>
          Applications are reviewed by Mrs. Sreenandini Jayaram, HR Manager,
          who works closely with engineering and operations leadership on all hiring decisions.
          For other enquiries, visit our <a href="/contact">contact page</a>.
        </p>

      </div>

      <!-- RIGHT: contact card -->
      <div class="apply-right reveal">
        <div class="apply-contact-block" aria-label="HR contact information">

          <div>
            <div class="acb-label">Send your application to</div>
            <div class="acb-value">hr@jayveecons.com</div>
            <p class="acb-sub">Include your CV and a brief note on the type of role you are seeking</p>
            <a href="mailto:hr@jayveecons.com" class="acb-email" aria-label="Email HR at hr@jayveecons.com">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              hr@jayveecons.com
            </a>
          </div>

          <div class="acb-divider" role="separator"></div>

          <div>
            <div class="acb-label">HR Contact</div>
            <div class="acb-hr-name">Mrs. Sreenandini Jayaram</div>
            <div class="acb-hr-role">Human Resource Manager — Jayveecons Group</div>
          </div>

          <div class="acb-divider" role="separator"></div>

          <div>
            <div class="acb-label">Office</div>
            <address class="acb-address">
              The Jayveecons Group<br>
              1st Phase, Plot 87/D2, Mcnally Rd,<br>
              Industrial Estate, Malur,<br>
              Karnataka 563130, India<br>
              <span class="acb-hours">Mon – Sat · 9:00 AM – 6:00 PM IST</span>
            </address>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .apply-section {
    padding: clamp(52px, 7vh, 84px) 0;
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 40px 40px;
    position: relative;
    z-index: 1;
    isolation: isolate;
  }

  .apply-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .apply-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(36px, 5vw, 56px);
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .apply-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── LEFT COLUMN ── */
  .apply-left {
    display: flex;
    flex-direction: column;
    gap: 0;
    justify-content: center;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .accent { color: #c0181e; }
  .tag-line { width: 28px; height: 2px; background: #c0181e; flex-shrink: 0; }
  .section-tag span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #c0181e;
  }

  .section-headline {
    font-family: var(--font-head);
    font-weight: 800; 
    font-size:clamp(32px,4.5vw,56px);
    text-transform: uppercase;
    line-height: .97;
    color: rgba(8,56,146,.9);
    margin-bottom: 20px;
  }

  .apply-left p {
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 400;
    color: #2a3550;
    line-height: 1.85;
    margin-bottom: 14px;
  }
  .apply-left p strong { color: #0d1a3a; font-weight: 600; }
  .apply-left a {
    color: #0d7a6e;
    text-decoration: none;
    transition: color .2s;
  }
  .apply-left a:hover { color: #0a0c12; }

  /* ── RIGHT COLUMN ── */
  .apply-right {
    display: flex;
    flex-direction: column;
  }

  .apply-contact-block {
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.14) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.25) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1;
  }

  .acb-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #ff7070;
    margin-bottom: 4px;
  }
  .acb-value {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(16px, 2vw, 22px);
    color: var(--white);
    letter-spacing: .04em;
    text-transform: uppercase;
    word-break: break-word;
  }
  .acb-sub {
    font-size: 13px;
    font-weight: 300;
    color: #ffffff;
    margin-top: 4px;
    line-height: 1.5;
  }
  .acb-email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .1em;
    color: var(--teal-l);
    text-decoration: none;
    transition: color .2s;
    min-height: 44px;
  }
  .acb-email:hover { color: var(--white); }
  .acb-divider { height: 1px; background: rgba(51,96,184,.2); }
  .acb-hr-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 17px;
    color: var(--chrome);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .acb-hr-role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #5580cc;
    margin-top: 3px;
  }
  .acb-address {
    font-size: 14px;
    font-weight: 300;
    color: #c8d8ec;
    line-height: 1.7;
    font-style: normal;
  }
  .acb-hours {
    display: block;
    margin-top: 4px;
    color: #9ab0d0;
    font-size: 13px;
  }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
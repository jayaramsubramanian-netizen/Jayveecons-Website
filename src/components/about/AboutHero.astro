---
import WorldMap from './WorldMap.astro';
---

<style>
  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    z-index: 2;
    padding: clamp(110px, 16vh, 156px) 0 clamp(52px, 8vh, 80px);
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,.85) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    display: flex;
    flex-direction: column;
  }

  .about-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,24,30,.3) 50%, transparent);
  }

  /* ── Flow column — right side, desktop only ── */
  .ch-flow-col {
    position: absolute;
    top: 0; bottom: 0;
    right: calc(clamp(48px, 6vw, 96px) + 200px);
    width: 2px;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 900px) { .ch-flow-col { display: block; } }

  .ch-flow-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(208,212,220,.12) 8%,
      rgba(208,212,220,.12) 92%,
      transparent 100%
    );
  }

  .ch-flow-glow {
    position: absolute;
    left: 50%;
    margin-left: -3px;
    top: 0;
    width: 6px;
    height: 100px;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(106,166,255,.12) 10%,
      rgba(106,166,255,.9)  40%,
      rgba(180,220,255,1)   50%,
      rgba(106,166,255,.9)  60%,
      rgba(106,166,255,.12) 90%,
      transparent 100%
    );
    border-radius: 3px;
    z-index: 3;
    will-change: top, opacity;
  }

  /* ── Inner ── */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
    flex: 1;
  }
  @media (min-width: 1024px) { .hero-inner { grid-template-columns: 1fr 1fr; } }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .breadcrumb a        { color: #7a8499; text-decoration: none; transition: color .2s; min-height: 44px; display: flex; align-items: center; }
  .breadcrumb a:hover  { color: var(--fog); }
  .breadcrumb .sep     { color: #3a4255; }
  .breadcrumb .current { color: #ff7070; }

  /* Eyebrow */
  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    animation: fadeUp .7s ease .1s both;
  }
  .page-eyebrow-line { width: 40px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .page-eyebrow span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #ff7070;
  }

  /* H1 */
  .page-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: .93;
    letter-spacing: -.01em;
    margin-bottom: 22px;
    animation: fadeUp .7s ease .2s both;
  }
  .page-title .accent { color: var(--crimson-l); }
  .page-title .chrome {
    background: linear-gradient(135deg, var(--chrome-l, #e8eaec), var(--chrome, #d0d4dc));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtext */
  .page-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 300;
    color: var(--fog);
    line-height: 1.75;
    margin-bottom: 28px;
    animation: fadeUp .7s ease .3s both;
  }

  /* Map container */
  .header-map {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: left;
    animation: fadeUp .8s ease .4s both;
    width: 150%;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow, .page-title, .page-sub, .header-map { animation: none; }
  }
</style>

<header class="about-hero" role="banner">

  <div class="ch-flow-col" aria-hidden="true">
    <div class="ch-flow-line"></div>
    <div class="ch-flow-glow" id="about-flow-glow"></div>
  </div>

  <div class="hero-inner">

    <!-- LEFT: copy -->
    <div class="header-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">About Us</span>
      </nav>

      <div class="page-eyebrow">
        <div class="page-eyebrow-line"></div>
        <span>Our Story</span>
      </div>

      <h1 class="page-title">
        <span id="hdr-years" class="accent">38 Years</span> of<br>
        Moving<br>
        <span class="chrome">Industry Forward</span>
      </h1>

      <p class="page-sub">
        From a single-room consulting firm in Bengaluru to a manufacturing company serving
        clients across India and internationally — this is the Jayveecons story.
      </p>
    </div>

    <!-- RIGHT: World Map -->
    <div class="header-map">
      <WorldMap />
    </div>

  </div>
</header>

<script>
(function () {
  const CYCLE_MS    = 5500;
  const FLOW_HEIGHT = 100;

  const section = document.querySelector('.about-hero') as HTMLElement | null;
  const col     = section?.querySelector('.ch-flow-col') as HTMLElement | null;
  const glow    = document.getElementById('about-flow-glow');
  if (!section || !col || !glow) return;

  let rafId:     number | null = null;
  let startTime: number | null = null;

  function frame(now: number) {
    if (!startTime) startTime = now;
    const y = -FLOW_HEIGHT + (col.offsetHeight + FLOW_HEIGHT) * ((now - startTime) % CYCLE_MS / CYCLE_MS);
    glow.style.top = `${y}px`;
    rafId = requestAnimationFrame(frame);
  }

  function start() {
    if (rafId) return;
    glow.style.opacity = '1';
    startTime = null;
    rafId = requestAnimationFrame(frame);
  }

  function stop() {
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    glow.style.opacity = '0';
    glow.style.top     = '0px';
  }

  new IntersectionObserver(entries => {
    entries[0].isIntersecting ? start() : stop();
  }, { threshold: 0.05 }).observe(section);

  document.addEventListener('astro:before-swap', stop);

  const hdrYears = document.getElementById('hdr-years');
  if (hdrYears) hdrYears.textContent = (new Date().getFullYear() - 1987) + ' Years';
})();
</script>
---
// AboutCTA.astro
// Final call-to-action band — dynamic year, two buttons.
---

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(64px, 9vh, 104px);
    background:
      radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
  }
  .cta-band::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 110%, rgba(192,24,30,.1), transparent 60%);
    pointer-events: none;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,24,30,.3) 50%, transparent);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    color: #ff7070;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .cta-headline {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(36px, 5.5vw, 68px);
    text-transform: uppercase;
    line-height: .97;
    margin-bottom: 16px;
    color: var(--white);
  }
  .cta-headline .accent { color: var(--crimson-l); }

  .cta-sub {
    font-size: clamp(14px, 1.6vw, 16px);
    font-weight: 300;
    color: var(--fog);
    margin-bottom: 40px;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>

<section class="cta-band" aria-labelledby="cta-about-heading">
  <div class="cta-inner">
    <div class="cta-eyebrow reveal">Work with Us</div>
    <h2 class="cta-headline reveal" id="cta-about-heading">
      Ready to Build<br><span class="accent">Something Great?</span>
    </h2>
    <p class="cta-sub reveal" id="cta-years-text">
      39 years of engineering experience, at your project's service.
    </p>
    <div class="cta-actions reveal">
      <a href="/careers" class="about-btn-secondary">
        Join Us →</a>
      <a href="/contact" class="about-btn-primary">
        Request a Quote
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="/products" class="about-btn-secondary">View Our Products →</a>
    </div>
    
  </div>
</section>

<script>
  (() => {
    const yr = new Date().getFullYear() - 1987;
    const el = document.getElementById('cta-years-text');
    if (el) el.textContent = `${yr} years of engineering experience, at your project's service.`;
  })();
</script>
---
// ServicesCta.astro — white grid background · trapezoidal buttons
---
<section class="cta-section">
  <div class="cta-inner">
    <div class="cta-eyebrow reveal">Start a Conversation</div>
    <h2 class="cta-headline reveal">
      What Can We<br>
      <span class="accent">Build for You?</span>
    </h2>
    <p class="cta-sub reveal">New project, replacement parts, repair, or refurbishment — our engineers are ready to respond within 24 hours.</p>

    <div class="cta-actions reveal">
      <a href="/contact" class="cta-btn cta-btn-primary">
        Request a Quote
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/products" class="cta-btn cta-btn-secondary">View Products</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(64px, 9vh, 104px);
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    border-top: 1px solid rgba(8,56,146,.08);
  }
  /* Top crimson accent */
  .cta-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, #c0181e 30%, #c0181e 70%, transparent);
    pointer-events: none;
  }

  .cta-inner {
    position: relative; z-index: 1;
    width: 100%; max-width: 900px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    box-sizing: border-box;
  }

  .cta-eyebrow {
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: .22em; text-transform: uppercase;
    color: #c0181e; margin-bottom: 14px;
  }

  .cta-headline {
    font-family: var(--font-head); font-weight: 800;
    font-size: clamp(34px, 5vw, 64px);
    text-transform: uppercase; line-height: .97;
    color: rgba(8,56,146,.9); margin-bottom: 16px;
  }
  .cta-headline .accent { color: #c0181e; }

  .cta-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 300; color: #2a3550;
    line-height: 1.75; max-width: 520px;
    margin-inline: auto; margin-bottom: 44px;
  }

  /* Trapezoidal buttons */
  .cta-actions {
    display: flex; justify-content: center;
    gap: clamp(20px, 3vw, 50px);
    flex-wrap: wrap; align-items: center;
  }

  .cta-btn {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-head); font-weight: 700;
    font-size: 15px; letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; padding: 16px 44px;
    white-space: nowrap; cursor: pointer; border: none;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    transition: filter .2s, transform .2s; min-height: 48px;
  }
  .cta-btn:hover { filter: brightness(1.1); transform: translateY(-2px); }
  .cta-btn:focus-visible { outline: 2px solid #c0181e; outline-offset: 3px; }

  .cta-btn-primary  { background: #c0181e; color: #ffffff; }
  .cta-btn-secondary { background: #163060; color: #e2ecf8; }

  @media (max-width: 560px) {
    .cta-actions { flex-direction: column; gap: 10px; width: 100%; }
    .cta-btn { clip-path: none; border-radius: 2px; width: 100%; justify-content: center; }
  }

  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
</section>

<script>
(function () {
  const blocks = document.querySelectorAll('.svc-block[id]'); // only numbered services, not header
  if (!blocks.length) return;

  const obs = new IntersectionObserver(
    (entries) => entries.forEach(e =>
      e.target.classList.toggle('svc-active', e.isIntersecting)
    ),
    {
      threshold:   0.2,
      rootMargin: '-5% 0px -40% 0px'   // fires when service is ~25-55% into view
    }
  );

  blocks.forEach(block => obs.observe(block));
})();
</script>


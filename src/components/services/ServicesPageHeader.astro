---
// ServicesPageHeader.astro
// Unified with CareersHero pattern: flow line, eyebrow, H1 size, breadcrumb
---

<section class="sph-section" aria-label="Services page header">

  <!-- Flow line — right side, desktop only — matches CareersHero exactly -->
  <div class="ch-flow-col" aria-hidden="true">
    <div class="ch-flow-line"></div>
    <div class="ch-flow-glow" id="svc-flow-glow"></div>
  </div>

  <!-- Blueprint background image -->
  <div class="sph-blueprint" aria-hidden="true">
    <img src="/images/bucket_elevator_bp.png" alt="" draggable="false" />
  </div>

  <div class="sph-inner">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current" aria-current="page">Services</span>
    </nav>

    <div class="page-eyebrow">
      <div class="page-eyebrow-line"></div>
      <span>End-to-End Capability</span>
    </div>

    <h1 class="page-title">
      From First
      <span class="accent">Drawing</span><br>
      To <span class="chrome">Last Bolt</span>
    </h1>

    <p class="page-sub">
      Jayveecons doesn't hand off. We design it, fabricate it, install it, and support it —
      from the initial engineering brief to long-term parts and maintenance, under one roof,
      under one team's accountability.
    </p>

  </div>
</section>

<style>
  /* ── Section shell ── */
  .sph-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(100px, 14vh, 140px) clamp(48px, 7vh, 80px);
  }
  .sph-section::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,24,30,.3) 50%, transparent);
    pointer-events: none;
  }

  /* ── Blueprint image ──
     The bucket elevator is portrait/tall, so we anchor it to the right,
     let it be taller than the section, and clip via overflow:hidden on the section.
     The mask fades the left edge so it dissolves into the text area.        */
  .sph-blueprint {
    position: absolute;
    top: 30%;
    right: 1%;
    transform: translateY(-50%);
    /* Tall portrait image — constrain by height so it fills the section vertically */
    height: 130%;
    width: auto;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent  0%,
      rgba(0,0,0,0.4) 15%,
      rgba(0,0,0,1)   40%
    );
    mask-image: linear-gradient(
      to right,
      transparent  0%,
      rgba(0,0,0,0.4) 15%,
      rgba(0,0,0,1)   40%
    );
  }
  .sph-blueprint img {
    display: block;
    height: 180%;
    width: auto;
    opacity: 0.25;
    object-fit: contain;
    filter: grayscale(30%) brightness(1.15);
    user-select: none;
  }
  @media (max-width: 700px) {
    .sph-blueprint { display: none; }
  }

  /* ── Flow column ── */
  .ch-flow-col {
    position: absolute;
    top: 0; bottom: 0;
    right: calc(clamp(48px, 6vw, 96px) + 200px);
    width: 2px;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 900px) { .ch-flow-col { display: block; } }

  .ch-flow-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(208,212,220,.12) 8%,
      rgba(208,212,220,.12) 92%,
      transparent 100%
    );
  }
  .ch-flow-glow {
    position: absolute;
    left: 50%;
    margin-left: -3px;
    top: 0;
    width: 6px;
    height: 100px;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(106,166,255,.12) 10%,
      rgba(106,166,255,.9)  40%,
      rgba(180,220,255,1)   50%,
      rgba(106,166,255,.9)  60%,
      rgba(106,166,255,.12) 90%,
      transparent 100%
    );
    border-radius: 3px;
    z-index: 3;
    will-change: top, opacity;
  }

  /* ── Inner container ── */
  .sph-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .breadcrumb a        { color: var(--mist); text-decoration: none; transition: color .2s; min-height: 44px; display: flex; align-items: center; }
  .breadcrumb a:hover  { color: var(--white); }
  .breadcrumb .sep     { color: var(--crimson); opacity: .6; }
  .breadcrumb .current { color: #ff7070; }

  /* ── Eyebrow ── */
  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    animation: fadeUp .7s ease .1s both;
  }
  .page-eyebrow-line { width: 40px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .page-eyebrow span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #ff7070;
  }

  /* ── H1 ── */
  .page-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: .93;
    letter-spacing: -.01em;
    color: var(--white);
    margin-bottom: 20px;
    animation: fadeUp .7s ease .2s both;
  }
  .page-title .accent { color: var(--crimson-l); }
  .page-title .chrome {
    background: linear-gradient(135deg, var(--chrome-l), var(--chrome));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Sub copy ── */
  .page-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 300;
    color: var(--fog);
    max-width: 640px;
    line-height: 1.75;
    animation: fadeUp .7s ease .3s both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow, .page-title, .page-sub { animation: none; }
  }
</style>

<script>
(function () {
  const CYCLE_MS    = 5500;
  const FLOW_HEIGHT = 100;

  const section = document.querySelector('.sph-section');
  const col     = section?.querySelector('.ch-flow-col');
  const glow    = document.getElementById('svc-flow-glow');
  if (!section || !col || !glow) return;

  let rafId = null, startTime = null;

  function frame(now) {
    if (!startTime) startTime = now;
    const progress = (now - startTime) % CYCLE_MS / CYCLE_MS;
    const y = -FLOW_HEIGHT + (col.offsetHeight + FLOW_HEIGHT) * progress;
    glow.style.top = y + 'px';
    rafId = requestAnimationFrame(frame);
  }
  function start() {
    if (rafId) return;
    glow.style.opacity = '1'; startTime = null;
    rafId = requestAnimationFrame(frame);
  }
  function stop() {
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    glow.style.opacity = '0'; glow.style.top = '0px';
  }

  new IntersectionObserver(e => { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.05 }).observe(section);
  document.addEventListener('astro:before-swap', stop);
})();
</script>
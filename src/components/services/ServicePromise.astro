---
// ServicePromise.astro — blue gradient background (inverted from original)
// Stat cards → WHITE (inverted since section is now dark)
const yearsOld = new Date().getFullYear() - 1987;
---

<section class="sp-section" id="promise">
  <div class="sp-inner">
    <div class="promise-grid">

      <!-- Left: copy -->
      <div class="promise-copy reveal">
        <div class="section-tag">
          <div class="line"></div>
          <span>Our Service Promise</span>
        </div>
        <h2 class="section-headline">
          Why Single-Source<br><span class="accent">Matters</span>
        </h2>
        <p class="body-text">In industrial equipment, the weakest link is almost always the handoff. When a design firm passes a drawing to a fabricator, and the fabricator passes equipment to an installation contractor, and the contractor hands over to a maintenance team — critical knowledge is lost at every transfer. Nobody owns the outcome.</p>
        <p class="body-text"><strong>Jayveecons is built to eliminate that problem.</strong> The engineer who designed your conveyor is available to answer your installation team's questions. The fabricator who built your kiln can diagnose why a component has worn faster than expected. The commissioning engineer can write the maintenance procedure because they ran the machine.</p>
        <blockquote>
          <p>"Customer satisfaction comes in providing cost-effective and superior products and services coupled with technological innovation."</p>
        </blockquote>
        <p class="body-text">That philosophy was written into our founding mission in 1987. Every service we offer exists to deliver on it.</p>
      </div>

      <!-- Right: stat cards (WHITE on dark section) -->
      <div class="promise-stats reveal">

        <div class="pstat">
          <div class="pstat-num">{yearsOld}<span class="u"> +</span></div>
          <div class="pstat-label">Years of Continuous Operation</div>
          <div class="pstat-desc">Uninterrupted service delivery since 1987</div>
        </div>

        <div class="pstat">
          <div class="pstat-num">24<span class="u"> h</span></div>
          <div class="pstat-label">Response Commitment</div>
          <div class="pstat-desc">All project and parts enquiries responded to within one business day</div>
        </div>

        <div class="pstat">
          <div class="pstat-num">90<span class="u"> K</span></div>
          <div class="pstat-label">Sq.ft Workshop Capacity</div>
          <div class="pstat-desc">Full machining and fabrication in-house, no subcontracting of critical work</div>
        </div>

        <div class="pstat">
          <div class="pstat-num">100<span class="u"> %</span></div>
          <div class="pstat-label">In-House Engineering</div>
          <div class="pstat-desc">Design, fabrication, erection, and support — all one team</div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section — Option E blue gradient ── */
  .sp-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(52px, 7vh, 88px);
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.14) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.25) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
  }
  /* Metallic top sheen */
  .sp-section::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(200,225,255,.45) 50%, transparent);
    pointer-events: none;
  }

  .sp-inner {
    position: relative; z-index: 1;
    width: 100%; max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    box-sizing: border-box;
  }

  .promise-grid {
    display: grid; grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 72px); align-items: center;
  }
  @media (min-width: 1024px) { .promise-grid { grid-template-columns: 1fr 1fr; } }

  /* Section tag — light on dark */
  .section-tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .section-tag .line { width: 28px; height: 2px; background: #c0181e; flex-shrink: 0; }
  .section-tag span {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: .2em; text-transform: uppercase; color: #ff7070;
  }

  /* Headline — white on dark */
  .section-headline {
    font-family: var(--font-head); font-weight: 800;
    font-size: clamp(32px,4.5vw,56px);
    text-transform: uppercase; line-height: .97;
    color: #ffffff; margin-bottom: clamp(28px, 4vh, 44px);
  }
  .section-headline .accent { color: #ff7070; }

  /* Body text — E-3: #e2ecf8 · 16px · 300 */
  .body-text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 300; color: #e2ecf8;
    line-height: 1.8; margin-bottom: 16px;
  }
  .body-text strong { color: #ffffff; font-weight: 600; }

  /* Blockquote — on dark bg */
  blockquote {
    border-left: 3px solid #c0181e;
    padding: 16px 20px;
    background: rgba(255,255,255,.06);
    margin: 20px 0;
    border-radius: 0 4px 4px 0;
  }
  blockquote p {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-style: italic; font-weight: 300;
    color: #e2ecf8; line-height: 1.65; margin: 0;
  }

  /* Stats 2×2 grid */
  .promise-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* ── Stat card — WHITE (inverted: section is dark) ── */
  .pstat {
    position: relative; overflow: hidden;
    background: #ffffff;
    border-top: 3px solid transparent;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,.18);
    padding: clamp(18px, 2.5vw, 28px);
    transition: border-top-color .3s, box-shadow .3s;
  }
  .pstat::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(8,56,146,.2) 50%, transparent);
    pointer-events: none;
  }
  .pstat:hover {
    border-top-color: #c0181e;
    box-shadow: 0 8px 32px rgba(0,0,0,.28);
  }

  /* Stat number — navy on white card */
  .pstat-num {
    font-family: var(--font-head); font-weight: 800;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1; color: rgba(8,56,146,.9);
    letter-spacing: -.02em;
  }
  .pstat-num .u { font-size: .75em; color: #c0181e; font-weight: 700; }

  .pstat-label {
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: .14em; text-transform: uppercase;
    color: #c0181e; margin-top: 5px; margin-bottom: 4px;
  }
  .pstat-desc {
    font-family: var(--font-body); font-size: 12px;
    font-weight: 300; color: #4a5068; line-height: 1.5;
  }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
---
// ProductsPageHeader.astro — unified with CareersHero pattern
---

<section class="pph-section" aria-label="Products page header">

  <div class="ch-flow-col" aria-hidden="true">
    <div class="ch-flow-line"></div>
    <div class="ch-flow-glow" id="prd-flow-glow"></div>
  </div>

  <!-- Blueprint background image -->
  <div class="pph-blueprint" aria-hidden="true">
    <img src="/images/rotary_dryer_bp.png" alt="" draggable="false" />
  </div>

  <div class="pph-inner">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current" aria-current="page">Products</span>
    </nav>

    <div class="page-eyebrow">
      <div class="page-eyebrow-line"></div>
      <span>VECTOMEC™ Equipment Line</span>
    </div>

    <h1 class="page-title">
      Engineered to
      <span class="accent">Move</span>
      &amp;
      <span class="chrome">Process</span>
    </h1>

    <p class="page-sub">
      The complete VECTOMEC™ catalogue — material handling systems, processing equipment,
      and ancillary hardware for every stage of your bulk processing operation.
    </p>

    <div class="vectomec-badge">
      <span class="vhb-label">Product line</span>
      <span class="vhb-name">VECTOMEC™</span>
      <span class="vhb-desc">by Jayveecons · Bengaluru, India · Est. 1987</span>
    </div>

  </div>
</section>

<style>
  .pph-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    padding-block: clamp(100px, 14vh, 140px) clamp(48px, 7vh, 80px);
  }
  .pph-section::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,24,30,.3) 50%, transparent);
    pointer-events: none;
  }

  /* ── Blueprint image ──
     Rotary dryer is landscape/wide — anchored right, vertically centred.
     Slightly larger than previous blueprints to show the full drum length.  */
  .pph-blueprint {
    position: absolute;
    top: 70%;
    right: -3%;
    transform: translateY(-50%);
    width: clamp(500px, 64vw, 1000px);
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent     0%,
      rgba(0,0,0,.4)  16%,
      rgba(0,0,0,1)   40%
    );
    mask-image: linear-gradient(
      to right,
      transparent     0%,
      rgba(0,0,0,.4)  16%,
      rgba(0,0,0,1)   40%
    );
  }
  .pph-blueprint img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.25;
    object-fit: contain;
    filter: grayscale(30%) brightness(1.15);
    user-select: none;
  }
  @media (max-width: 700px) {
    .pph-blueprint { display: none; }
  }

  /* ── Flow column ── */
  .ch-flow-col {
    position: absolute;
    top: 0; bottom: 0;
    right: calc(clamp(48px, 6vw, 96px) + 200px);
    background: linear-gradient(180deg, transparent, rgba(208,212,220,.1) 30%, rgba(208,212,220,.05) 70%, transparent);
    width: 2px;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 900px) { .ch-flow-col { display: block; } }

  .ch-flow-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(208,212,220,.12) 8%,
      rgba(208,212,220,.12) 92%,
      transparent 100%
    );
  }
  .ch-flow-glow {
    position: absolute;
    left: 50%; margin-left: -3px;
    top: 0; width: 6px; height: 100px; opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(106,166,255,.12) 10%,
      rgba(106,166,255,.9)  40%,
      rgba(180,220,255,1)   50%,
      rgba(106,166,255,.9)  60%,
      rgba(106,166,255,.12) 90%,
      transparent 100%
    );
    border-radius: 3px;
    z-index: 3;
    will-change: top, opacity;
  }

  /* ── Inner container ── */
  .pph-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .breadcrumb a        { color: var(--mist); text-decoration: none; transition: color .2s; min-height: 44px; display: flex; align-items: center; }
  .breadcrumb a:hover  { color: var(--white); }
  .breadcrumb .sep     { color: var(--crimson); opacity: .6; }
  .breadcrumb .current { color: #ff7070; }

  /* ── Eyebrow ── */
  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    animation: fadeUp .7s ease .1s both;
  }
  .page-eyebrow-line { width: 40px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .page-eyebrow span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #ff7070;
  }

  /* ── H1 ── */
  .page-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: .93;
    letter-spacing: -.01em;
    color: var(--white);
    margin-bottom: 20px;
    animation: fadeUp .7s ease .2s both;
  }
  .page-title .accent { color: var(--crimson-l); }
  .page-title .chrome {
    background: linear-gradient(135deg, var(--chrome-l), var(--chrome));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Sub copy ── */
  .page-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 300;
    color: var(--fog);
    max-width: 600px;
    line-height: 1.75;
    margin-bottom: clamp(24px, 3vh, 36px);
    animation: fadeUp .7s ease .3s both;
  }

  /* ── VECTOMEC badge ── */
  .vectomec-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(8px, 1.5vw, 16px);
    background: rgba(13,26,58,.6);
    border: 1px solid rgba(192,24,30,.3);
    border-left: 3px solid var(--crimson);
    padding: 12px 20px;
    animation: fadeUp .7s ease .4s both;
  }
  .vhb-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .vhb-name {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 24px);
    letter-spacing: .12em;
    background: linear-gradient(135deg, var(--chrome-l), var(--chrome));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-transform: uppercase;
  }
  .vhb-desc {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: var(--mist);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow, .page-title, .page-sub, .vectomec-badge { animation: none; }
  }
</style>

<script>
(function () {
  const CYCLE_MS = 5500, FLOW_HEIGHT = 100;
  const section = document.querySelector('.pph-section');
  const col     = section?.querySelector('.ch-flow-col');
  const glow    = document.getElementById('prd-flow-glow');
  if (!section || !col || !glow) return;

  let rafId = null, startTime = null;

  function frame(now) {
    if (!startTime) startTime = now;
    const y = -FLOW_HEIGHT + (col.offsetHeight + FLOW_HEIGHT) * ((now - startTime) % CYCLE_MS / CYCLE_MS);
    glow.style.top = y + 'px';
    rafId = requestAnimationFrame(frame);
  }
  function start() {
    if (rafId) return;
    glow.style.opacity = '1';
    startTime = null;
    rafId = requestAnimationFrame(frame);
  }
  function stop() {
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    glow.style.opacity = '0';
    glow.style.top = '0px';
  }

  new IntersectionObserver(e => { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.05 }).observe(section);
  document.addEventListener('astro:before-swap', stop);
})();
</script>
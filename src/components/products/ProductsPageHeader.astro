---
/**
 * ProductsPageHeader.astro — DARK navy gradient
 * Matches ServicesPageHeader and ContactHero patterns exactly.
 * No props needed — all content is static.
 */
---

<section class="pph-section" aria-label="Products page header">
  <div class="pph-inner">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current">Products</span>
    </nav>

    <!-- Eyebrow -->
    <div class="page-eyebrow">
      <div class="page-eyebrow-line"></div>
      <span>VECTOMEC™ Equipment Line</span>
    </div>

    <!-- Headline -->
    <h1 class="page-title">
      Engineered to
      <span class="accent">Move</span>
      &amp;
      <span class="chrome">Process</span>
    </h1>

    <!-- Sub copy -->
    <p class="page-sub">
      The complete VECTOMEC™ catalogue — material handling systems, processing equipment,
      and ancillary hardware for every stage of your bulk processing operation.
    </p>

    <!-- VECTOMEC badge -->
    <div class="vectomec-badge">
      <span class="vhb-label">Product line</span>
      <span class="vhb-name">VECTOMEC™</span>
      <span class="vhb-desc">by Jayveecons · Bengaluru, India · Est. 1987</span>
    </div>

  </div>
</section>

<style>
  /* ── Section shell — dark navy gradient ── */
  .pph-section {
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    padding-block: clamp(100px,14vh,140px) clamp(48px,7vh,80px);
    position: relative;
    overflow: hidden;
  }

  /* Subtle vertical divider line — matches HeroSection */
  .pph-section::after {
    content: '';
    position: absolute;
    top: 0; right: 22%; width: 1px; height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(208,212,220,.1) 30%,
      rgba(208,212,220,.05) 70%,
      transparent
    );
    pointer-events: none;
  }

  /* ── Container token ── */
  .pph-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
    box-sizing: border-box;
  }
  @media (min-width: 480px)  { .pph-inner { padding-inline: 20px; } }
  @media (min-width: 768px)  { .pph-inner { padding-inline: 32px; } }
  @media (min-width: 1024px) { .pph-inner { padding-inline: 48px; } }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .breadcrumb a        { color: var(--mist); text-decoration: none; transition: color .2s; }
  .breadcrumb a:hover  { color: var(--white); }
  .breadcrumb .sep     { color: var(--crimson); opacity: .6; }
  .breadcrumb .current { color: var(--crimson-l); }

  /* ── Eyebrow ── */
  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    animation: fadeUp .7s ease .1s both;
  }
  .page-eyebrow-line {
    width: 30px; height: 2px;
    background: var(--crimson);
    flex-shrink: 0;
  }
  .page-eyebrow span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--crimson-l);
  }

  /* ── H1 ── */
  .page-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(44px, 6.5vw, 84px);
    text-transform: uppercase;
    line-height: .93;
    letter-spacing: -.01em;
    color: var(--white);
    margin-bottom: 20px;
    animation: fadeUp .7s ease .2s both;
  }
  .page-title .accent { color: var(--crimson-l); }
  .page-title .chrome {
    background: linear-gradient(135deg, var(--chrome-l), var(--chrome));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Sub copy ── */
  .page-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 300;
    color: var(--fog);
    max-width: 600px;
    line-height: 1.75;
    margin-bottom: clamp(24px, 3vh, 36px);
    animation: fadeUp .7s ease .3s both;
  }

  /* ── VECTOMEC badge ── */
  .vectomec-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(8px, 1.5vw, 16px);
    background: rgba(13,26,58,.6);
    border: 1px solid rgba(192,24,30,.3);
    border-left: 3px solid var(--crimson);
    padding: 12px 20px;
    animation: fadeUp .7s ease .4s both;
  }
  .vhb-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .vhb-name {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 24px);
    letter-spacing: .12em;
    background: linear-gradient(135deg, var(--chrome-l), var(--chrome));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-transform: uppercase;
  }
  .vhb-desc {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: var(--mist);
  }

  /* ── Animations ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow, .page-title, .page-sub, .vectomec-badge {
      animation: none;
    }
  }
</style>
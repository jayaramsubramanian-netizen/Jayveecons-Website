---
/**
 * ProductGrid.astro
 * FIXES:
 *  1. handling starts LIGHT (white grid) so it doesn't clash with dark header
 *  2. Cards INVERT their host section: white cards on dark sections, blue cards on light sections
 *  3. Alternating: handling=light, processing=dark, ancillary=light, accessories=dark
 */
import type { Product } from '../../data/products';

interface Props { products: Product[]; }
const { products } = Astro.props;

type CatMeta = {
  id:    string;
  num:   string;
  label: string;
  badge: string;
  desc:  string;
  theme: 'dark' | 'light';
};

const categories: CatMeta[] = [
  { id: 'handling',    num: '01 / 04', label: 'Material Handling Systems',   badge: 'VECTOMEC™ Conveying Range',  desc: 'Continuous, reliable bulk material movement — from raw input to process feed to finished product transfer.',   theme: 'light' },
  { id: 'processing',  num: '02 / 04', label: 'Material Processing Systems', badge: 'VECTOMEC™ Processing Range', desc: 'High-performance equipment that transforms raw bulk material into finished product.',                        theme: 'dark'  },
  { id: 'ancillary',   num: '03 / 04', label: 'Ancillary Equipment',         badge: 'VECTOMEC™ Support Range',    desc: 'Storage, containment, flow control, and structural equipment that supports your primary systems.',          theme: 'light' },
  { id: 'accessories', num: '04 / 04', label: 'Accessories & Parts',         badge: 'VECTOMEC™ Parts & Spares',   desc: 'Mechanical components, drives, wear parts, and replacement items for new builds and long-term maintenance.', theme: 'dark'  },
];

function byCategory(cat: string) {
  return products.filter(p => p.category === cat);
}
---

<div id="product-grid">
  {categories.map(cat => {
    const catProducts = byCategory(cat.id);
    return (
      <section
        class={`cat-section cat-section--${cat.theme}`}
        id={`${cat.id}-section`}
        data-cat={cat.id}
        aria-labelledby={`cat-heading-${cat.id}`}
      >
        <div class="cat-inner">

          <div class="cat-header reveal">
            <div class="cat-header-left">
              <div class="cat-num">{cat.num}</div>
              <h2 class="cat-title" id={`cat-heading-${cat.id}`}>{cat.label}</h2>
              <p class="cat-desc">{cat.desc}</p>
            </div>
            <div class="cat-badge">{cat.badge}</div>
          </div>

          <div class="prod-grid" role="list">
            {catProducts.map(p => (
              <article
                class="prod-card"
                data-id={p.id}
                data-cat={p.category}
                data-search={`${p.name} ${p.apps.join(' ')} ${p.modalApps.join(' ')}`.toLowerCase()}
                role="listitem"
                id={p.id}
              >
                <div class="prod-img" aria-hidden="true">
                  {p.image
                    ? <img src={p.image} alt={p.name} loading="lazy" decoding="async" width="400" height="220"/>
                    : <div class="prod-img-placeholder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
                      </div>
                  }
                  <span class="prod-series">{p.series}</span>
                </div>

                <div class="prod-body">
                  <div class="prod-category">{p.category.charAt(0).toUpperCase() + p.category.slice(1)}</div>
                  <h3 class="prod-name">{p.name}</h3>
                  <p class="prod-desc">{p.shortDesc}</p>
                  <ul class="prod-apps" aria-label="Industries">
                    {p.apps.map(app => <li class="prod-app">{app}</li>)}
                  </ul>
                  <div class="prod-footer">
                    <a href={`/contact?product=${p.id}`} class="prod-rfq" aria-label={`Request a quote for ${p.name}`}>
                      Request Quote
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                    <button class="prod-detail-btn" data-product-id={p.id} aria-label={`View details for ${p.name}`} aria-haspopup="dialog">
                      Details
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="no-results" aria-live="polite" hidden>
            <p>No products match your search in this category.</p>
          </div>

        </div>
      </section>
    );
  })}
</div>

<script is:inline define:vars={{ products }}>
  window.__PRODUCTS__ = products;
</script>

<style>
  /* ══════════════════════════════════════════
     SECTION BACKGROUNDS
     light = white 60px grid  |  dark = blue gradient
  ══════════════════════════════════════════ */
  .cat-section--light {
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    padding-block: clamp(48px, 7vh, 80px);
    border-top: 1px solid rgba(8,56,146,.07);
    border-bottom: 1px solid rgba(8,56,146,.07);
  }

  .cat-section--dark {
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.10) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.22) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(48px, 7vh, 80px);
  }

  /* ── Container ── */
  .cat-inner {
    width: 100%; max-width: 1440px;
    margin-inline: auto; padding-inline: 16px; box-sizing: border-box;
  }
  @media (min-width: 480px)  { .cat-inner { padding-inline: 20px; } }
  @media (min-width: 768px)  { .cat-inner { padding-inline: 32px; } }
  @media (min-width: 1024px) { .cat-inner { padding-inline: 48px; } }

  /* ══════════════════════════════════════════
     CATEGORY HEADER
  ══════════════════════════════════════════ */
  .cat-header {
    display: flex; align-items: flex-start;
    justify-content: space-between; flex-wrap: wrap;
    gap: 16px;
    margin-bottom: clamp(24px, 4vh, 40px);
    padding-bottom: clamp(16px, 2vh, 24px);
    border-bottom: 1px solid rgba(51,96,184,.15);
  }

  .cat-num {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .18em; text-transform: uppercase; margin-bottom: 6px;
  }
  .cat-section--light .cat-num { color: #c0181e; opacity: .8; }
  .cat-section--dark  .cat-num { color: #ff7070; opacity: .7; }

  .cat-title {
    font-family: var(--font-head); font-weight: 800;
    font-size: clamp(26px, 3.5vw, 44px);
    text-transform: uppercase; letter-spacing: .02em;
    line-height: 1; margin-bottom: 8px;
  }
  .cat-section--light .cat-title { color: #1a1d24; }
  .cat-section--dark  .cat-title { color: #ffffff; }

  .cat-desc {
    font-family: var(--font-body); font-size: clamp(13px, 1.4vw, 15px);
    font-weight: 300; line-height: 1.6; max-width: 560px;
  }
  .cat-section--light .cat-desc { color: #4a5068; }
  .cat-section--dark  .cat-desc { color: #e2ecf8; }

  .cat-badge {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: .12em; text-transform: uppercase;
    padding: 6px 14px; white-space: nowrap;
    align-self: flex-start; flex-shrink: 0;
  }
  .cat-section--light .cat-badge { background: rgba(8,56,146,.07);  border: 1px solid rgba(8,56,146,.18);  color: rgba(8,56,146,.8); }
  .cat-section--dark  .cat-badge { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.7); }

  /* ══════════════════════════════════════════
     PRODUCT GRID
  ══════════════════════════════════════════ */
  .prod-grid {
    display: grid; grid-template-columns: 1fr; gap: 16px;
  }
  @media (min-width: 480px)  { .prod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  @media (min-width: 900px)  { .prod-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; } }
  @media (min-width: 1280px) { .prod-grid { grid-template-columns: repeat(4, 1fr); } }

  /* ══════════════════════════════════════════
     PRODUCT CARD — INVERTED from host section
     Light section → blue gradient card
     Dark section  → white card
  ══════════════════════════════════════════ */
  .prod-card {
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
    border-radius: 4px;
    border-left: 3px solid transparent;
    transition: border-left-color .3s, transform .2s, box-shadow .2s;
    cursor: pointer;
  }

  /* Metallic sheen on every card */
  .prod-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1; pointer-events: none;
  }

  .prod-card:hover { border-left-color: #c0181e; transform: translateY(-2px); }

  /* ── LIGHT section → BLUE GRADIENT card ── */
  .cat-section--light .prod-card {
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.14) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.25) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    box-shadow:
      0 4px 16px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(180,210,255,.12);
  }
  .cat-section--light .prod-card:hover {
    box-shadow:
      0 10px 30px rgba(0,0,0,.28),
      inset 0 1px 0 rgba(192,24,30,.2);
  }

  /* ── DARK section → WHITE card ── */
  .cat-section--dark .prod-card {
    background: #ffffff;
    border: 1px solid rgba(8,56,146,.09);
    border-left: 3px solid transparent;
    box-shadow: 0 2px 10px rgba(0,0,0,.1);
  }
  .cat-section--dark .prod-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.18);
    border-left-color: #c0181e;
  }

  /* ── Image area ── */
  .prod-img {
    position: relative;
    height: clamp(140px, 18vw, 200px);
    overflow: hidden; flex-shrink: 0;
  }
  .cat-section--light .prod-img { background: #0e2454; }
  .cat-section--dark  .prod-img { background: #e8ecf4; }

  .prod-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: grayscale(20%) contrast(1.08);
    transition: transform .5s ease, filter .3s;
  }
  .prod-card:hover .prod-img img { transform: scale(1.04); filter: grayscale(0%) contrast(1.12); }

  .prod-img::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(8,10,18,.75) 100%);
  }

  .prod-img-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
  .cat-section--light .prod-img-placeholder svg { color: rgba(51,96,184,.3);  width: 44px; height: 44px; }
  .cat-section--dark  .prod-img-placeholder svg { color: rgba(8,56,146,.25); width: 44px; height: 44px; }

  .prod-series {
    position: absolute; top: 10px; left: 10px; z-index: 2;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase;
    background: rgba(192,24,30,.9); color: #ffffff;
    padding: 3px 8px; backdrop-filter: blur(4px);
  }

  /* ── Card body ── */
  .prod-body {
    display: flex; flex-direction: column; flex: 1;
    padding: clamp(14px, 2vw, 22px); gap: 0;
  }

  .prod-category {
    font-family: var(--font-mono); font-size: 9px;
    letter-spacing: .14em; text-transform: uppercase; margin-bottom: 6px;
  }
  .cat-section--light .prod-category { color: #5580cc; }
  .cat-section--dark  .prod-category { color: rgba(8,56,146,.7); }

  .prod-name {
    font-family: var(--font-head); font-weight: 700;
    font-size: clamp(15px, 1.8vw, 20px);
    text-transform: uppercase; letter-spacing: .04em;
    line-height: 1.1; margin-bottom: 8px;
  }
  .cat-section--light .prod-name { color: #ffffff; }
  .cat-section--dark  .prod-name { color: #1a1d24; }

  .prod-desc {
    font-family: var(--font-body); font-size: 14px;
    font-weight: 300; line-height: 1.6; margin-bottom: 12px; flex: 1;
  }
  .cat-section--light .prod-desc { color: #e2ecf8; }
  .cat-section--dark  .prod-desc { color: #4a5068; }

  /* App pills */
  .prod-apps { display: flex; flex-wrap: wrap; gap: 5px; list-style: none; padding: 0; margin: 0 0 14px; }
  .prod-app {
    font-family: var(--font-mono); font-size: 9px;
    letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px;
  }
  .cat-section--light .prod-app { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.65); }
  .cat-section--dark  .prod-app { background: rgba(8,56,146,.06);    border: 1px solid rgba(8,56,146,.14);   color: rgba(8,56,146,.7); }

  /* Footer */
  .prod-footer {
    display: flex; align-items: center;
    justify-content: space-between;
    padding-top: 12px; margin-top: auto;
  }
  .cat-section--light .prod-footer { border-top: 1px solid rgba(255,255,255,.12); }
  .cat-section--dark  .prod-footer { border-top: 1px solid rgba(8,56,146,.1); }

  .prod-rfq {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; transition: color .2s;
  }
  .prod-rfq svg { width: 11px; height: 12px; }
  .cat-section--light .prod-rfq       { color: #ff9090; }
  .cat-section--light .prod-rfq:hover { color: #ffffff;  }
  .cat-section--dark  .prod-rfq       { color: #c0181e;  }
  .cat-section--dark  .prod-rfq:hover { color: #1a1d24;  }

  .prod-detail-btn {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: .08em; text-transform: uppercase;
    background: none; border: none; cursor: pointer;
    padding: 0; transition: color .2s;
    min-height: 44px; padding-inline: 4px;
  }
  .prod-detail-btn svg { width: 12px; height: 12px; }
  .cat-section--light .prod-detail-btn       { color: rgba(255,255,255,.5); }
  .cat-section--light .prod-detail-btn:hover { color: #ffffff; }
  .cat-section--dark  .prod-detail-btn       { color: rgba(8,56,146,.6); }
  .cat-section--dark  .prod-detail-btn:hover { color: #1a1d24; }

  /* Hidden states */
  .prod-card[hidden]   { display: none; }
  .cat-section[hidden] { display: none; }
  .no-results {
    grid-column: 1/-1; text-align: center; padding: 48px 24px;
    font-family: var(--font-body); font-size: 15px;
  }
  .cat-section--light .no-results { color: #4a5068; }
  .cat-section--dark  .no-results { color: #e2ecf8; }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .prod-card { transition: border-left-color .3s; }
    .prod-card:hover { transform: none; }
  }
</style>

<script>
  const revealObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

  document.querySelectorAll<HTMLElement>('.prod-card').forEach((card, i) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(16px)';
    card.style.transition = `opacity .45s ease ${i * 35}ms, transform .45s ease ${i * 35}ms, border-left-color .3s, box-shadow .2s`;
    requestAnimationFrame(() => {
      setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; }, 80 + i * 35);
    });
  });

  const STICKY_OFFSET = 130;

  document.addEventListener('product-filter', (e: Event) => {
    const { cat, query } = (e as CustomEvent<{ cat: string; query: string }>).detail;
    const q = query.toLowerCase();
    let firstVisibleSection: Element | null = null;

    document.querySelectorAll<HTMLElement>('.cat-section').forEach(section => {
      const sectionCat = section.dataset.cat!;
      const catMatch   = cat === 'all' || cat === sectionCat;
      let   sectionHasVisible = false;

      section.querySelectorAll<HTMLElement>('.prod-card').forEach(card => {
        const show = catMatch && (!q || (card.dataset.search ?? '').includes(q));
        card.hidden = !show;
        if (show) sectionHasVisible = true;
      });

      section.hidden = !sectionHasVisible;
      if (sectionHasVisible && !firstVisibleSection) firstVisibleSection = section;

      const noResults = section.querySelector<HTMLElement>('.no-results');
      if (noResults) noResults.hidden = sectionHasVisible;
    });

    if (cat !== 'all' && !q && firstVisibleSection) {
      const top = (firstVisibleSection as HTMLElement).getBoundingClientRect().top + window.scrollY - STICKY_OFFSET;
      window.scrollTo({ top, behavior: 'smooth' });
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.prod-detail-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-product-modal', { detail: { id: btn.dataset.productId! } }));
    });
  });
</script>
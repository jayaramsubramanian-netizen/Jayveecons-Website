---
/**
 * ProductsRfqBand.astro — closing CTA band
 * WHITE + blue grid background (matches light product sections)
 * Trapezoidal buttons · E-3 typography · navy text on light bg
 */
---

<section class="rfq-section" aria-labelledby="rfq-heading">
  <div class="rfq-inner">

    <div class="rfq-copy reveal">
      <div class="rfq-eyebrow">Can't Find What You Need?</div>
      <h2 class="rfq-headline" id="rfq-heading">
        We Build to<br>
        <span class="accent">Your Specification</span>
      </h2>
      <p class="rfq-sub">
        Every plant is different. If your requirement doesn't match a standard catalogue item,
        our engineers will design it from scratch. Tell us your material, capacity, and site
        conditions — we'll take it from there.
      </p>
    </div>

    <div class="rfq-actions reveal">
      <a href="/contact" class="rfq-btn rfq-btn-primary">
        Request a Quote
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="/contact?type=technical" class="rfq-btn rfq-btn-secondary">
        Technical Enquiry
      </a>
    </div>

  </div>
</section>

<style>
  /* ── Section — white + blue grid ── */
  .rfq-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 9vh, 104px);
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    border-top: 1px solid rgba(8,56,146,.08);
  }

  /* Top crimson accent line */
  .rfq-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #c0181e 30%, #c0181e 70%, transparent);
    pointer-events: none;
  }

  /* ── Container ── */
  .rfq-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 480px)  { .rfq-inner { padding-inline: 20px; } }
  @media (min-width: 768px)  { .rfq-inner { padding-inline: 32px; } }
  @media (min-width: 1024px) {
    .rfq-inner {
      padding-inline: 48px;
      grid-template-columns: 1fr auto;
    }
  }

  /* ── Copy — dark text on light background ── */
  .rfq-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #c0181e;
    margin-bottom: 14px;
  }

  .rfq-headline {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(32px, 4.5vw, 58px);
    text-transform: uppercase;
    line-height: .97;
    color: rgba(8,56,146,.9);
    margin-bottom: 16px;
  }
  .rfq-headline .accent { color: #c0181e; }

  /* E-3 readability: 16px · 300 · dark navy */
  .rfq-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 300;
    color: #2a3550;
    line-height: 1.75;
    max-width: 580px;
  }

  /* ── Actions ── */
  .rfq-actions {
    display: flex;
    flex-direction: row;
    gap: clamp(20px, 3vw, 40px);
    flex-wrap: wrap;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .rfq-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }

  /* ════════════════════════════════════════
     TRAPEZOIDAL BUTTONS — matches AboutCTA
  ════════════════════════════════════════ */
  .rfq-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 44px;
    white-space: nowrap;
    cursor: pointer;
    border: none;
    transition: filter .2s, transform .2s;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    min-height: 48px;
  }
  .rfq-btn:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
  }
  .rfq-btn:focus-visible {
    outline: 2px solid #c0181e;
    outline-offset: 3px;
  }

  /* Primary — crimson fill */
  .rfq-btn-primary {
    background: #c0181e;
    color: #ffffff;
  }

  /* Secondary — navy fill (Option E dark, sits well on white bg) */
  .rfq-btn-secondary {
    background: #163060;
    color: #e2ecf8;
  }

  /* Mobile: stack full-width, remove trapezoid */
  @media (max-width: 560px) {
    .rfq-actions { flex-direction: column; gap: 10px; width: 100%; }
    .rfq-btn {
      clip-path: none;
      border-radius: 2px;
      width: 100%;
      justify-content: center;
    }
  }

  /* ── Reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .65s ease, transform .65s ease;
  }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.rfq-section .reveal').forEach(el => obs.observe(el));
</script>
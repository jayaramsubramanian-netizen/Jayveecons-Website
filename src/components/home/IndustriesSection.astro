---
/**
 * IndustriesSection.astro — LIGHT white + blue grid
 * Cards: navy gradient on light section
 * Mobile-first: 1 col → 2 col → 4 col
 */
const industries = [
  { status: 'served', name: 'Cement',                    desc: 'Integrated equipment solutions for VSK and rotary kiln cement plants, including vertical shaft kilns, grinding systems, material handling and feed systems.' },
  { status: 'served', name: 'Mining & Aggregates',       desc: 'Crushing, screening, and conveying systems for ore, limestone, and aggregate processing — high-throughput bulk material handling solutions.' },
  { status: 'served', name: 'Food Processing',           desc: 'Food-grade material handling and processing systems for dairy, agri-based, and processed food industries with hygienic operation and product integrity.' },
  { status: 'served', name: 'Waste Management',          desc: 'Robust handling and processing for municipal and industrial waste streams.' },
  { status: 'target', name: 'Oil & Gas',                 desc: 'Applying our enclosed conveying, pressure vessel, and abrasion-resistant fabrication experience to upstream and downstream bulk solids handling.' },
  { status: 'target', name: 'Pharmaceuticals',           desc: 'Our food-grade stainless fabrication capability — hygienic weld geometry, Ra surface finishes — translates directly to pharma powder handling.' },
  { status: 'target', name: 'Agri & Grain Processing',  desc: 'Large-scale post-harvest handling, drying, and storage drawing on our food-processing and bulk conveying experience.' },
  { status: 'served', name: 'Steel, Ceramics & Fertilizers', desc: 'High-temperature and abrasion-resistant systems for steel plants, ceramics, and specialty material processing.' },
];
---

<section class="ind-section" id="industries" aria-labelledby="ind-heading">
  <div class="ind-inner">

    <div class="ind-header">
      <div>
        <div class="section-tag reveal">
          <div class="tag-line"></div>
          <span>Markets</span>
        </div>
        <h2 class="section-headline reveal" id="ind-heading">
          Industries We <span class="accent">Serve</span>
        </h2>
        <p class="section-sub reveal">
          Jayveecons delivers purpose-built solutions that transform bulk aggregate materials into finished products — efficiently, reliably, and at scale.
        </p>
      </div>
      <div class="ind-legend reveal" aria-label="Card legend">
        <div class="legend-item">
          <div class="legend-dot served" aria-hidden="true"></div>
          <span>Currently serving</span>
        </div>
        <div class="legend-item">
          <div class="legend-dot target" aria-hidden="true"></div>
          <span>Diversifying into</span>
        </div>
      </div>
    </div>

    <!-- Mobile: 1 col → tablet: 2 col → desktop: 4 col -->
    <div class="ind-grid" role="list">
      {industries.map(ind => (
        <div class={`ind-card ${ind.status} reveal`} role="listitem">
          <div class="ind-badge">{ind.status === 'served' ? 'Active' : 'Diversifying'}</div>
          <h3 class="ind-name">{ind.name}</h3>
          <p class="ind-desc">{ind.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── WHITE + BLUE GRID BACKGROUND ── */
  .ind-section {
    padding: clamp(56px,8vh,96px) 0;
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    border-bottom: 1px solid rgba(8,56,146,.08);
    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;
  }

  .ind-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px,4vw,48px);
  }

  /* Header */
  .ind-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: clamp(24px,4vh,48px);
  }

  /* Section tag — crimson on light bg */
  .section-tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .tag-line    { width: 28px; height: 2px; background: #c0181e; flex-shrink: 0; }
  .section-tag span { font-family: var(--font-mono); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: #c0181e; }

  /* Headline — navy + red accent (light section) */
  .section-headline { font-family: var(--font-head); font-weight: 800; font-size:clamp(32px,4.5vw,56px); text-transform: uppercase; line-height: .97; color: rgba(8,56,146,.9); margin-bottom: 14px; }
  .accent { color: #c0181e; }

  .section-sub { font-size: clamp(13px,1.4vw,15px); font-weight: 400; color: #2a3550; line-height: 1.75; max-width: 560px; }

  /* Legend */
  .ind-legend { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
  .legend-item { display: flex; align-items: center; gap: 7px; }
  .legend-dot { width: 10px; height: 10px; border-top: 2px solid; }
  .legend-dot.served { border-color: #c0181e; }
  .legend-dot.target { border-color: var(--teal); }
  .legend-item span { font-size: 12px; color: #5a6a88; font-family: var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }

  /* Grid — mobile: 1 col → tablet: 2 col → desktop: 4 col */
  .ind-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 560px)  { .ind-grid { grid-template-columns: repeat(2,1fr); gap: 16px; } }
  @media (min-width: 1024px) { .ind-grid { grid-template-columns: repeat(4,1fr); gap: 20px; } }

  /* Card — navy gradient on light section (matches WhatWeDo node-card) */
  .ind-card {
    background:
      radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    padding: clamp(18px,2.5vw,26px);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.14);
    border-top: 3px solid transparent;
    transition: border-top-color .25s, box-shadow .25s, transform .25s;
  }
  .ind-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,.22); }
  .ind-card.served { border-top-color: var(--crimson); }
  .ind-card.target { border-top-color: var(--teal-l); }

  .ind-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: 3px 8px;
    margin-bottom: 10px;
    display: inline-block;
    border-radius: 2px;
  }
  .ind-card.served .ind-badge { background: rgba(192,24,30,.15); color: var(--crimson-l); }
  .ind-card.target .ind-badge { background: rgba(13,122,110,.15); color: var(--teal-l); }

  .ind-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(17px,2vw,22px);
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
    line-height: 1.1;
  }
  .ind-desc {
    font-size: clamp(12px,1.2vw,13px);
    font-weight: 300;
    color: var(--fog);
    line-height: 1.6;
    margin: 0;
  }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
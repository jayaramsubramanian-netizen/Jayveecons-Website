---
/**
 * ProductsSection.astro — DARK navy gradient
 * Cards: white background, navy titles, dark body text
 * Mobile-first: 1 col → 3 col at 900px
 */
const products = [
  {
    num:      '01 / 03',
    href:     '/products#handling-section',
    title:    'Material Handling Systems',
    subtitle: 'VECTOMEC™ Conveying Range',
    desc:     'Engineered for continuous, reliable bulk material movement across your entire process line.',
    items:    ['Screw Conveyors', 'Belt Conveyors', 'Bucket Elevators', 'Air Slides'],
    iconPath: 'M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z M4 22v-7',
  },
  {
    num:      '02 / 03',
    href:     '/products#processing-section',
    title:    'Material Processing Systems',
    subtitle: 'VECTOMEC™ Processing Range',
    desc:     'High-performance equipment for transforming raw bulk material into finished product.',
    items:    ['Kilns', 'Ball Mills & Grinding Mills', 'Crushers', 'Classifiers & Screens', 'Industrial Dryers'],
    iconPath: 'M12 9a3 3 0 100 6 3 3 0 000-6z M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14',
  },
  {
    num:      '03 / 03',
    href:     '/products#ancillary-section',
    title:    'Ancillary Equipment',
    subtitle: 'VECTOMEC™ Support Range',
    desc:     'Essential hardware that completes your system — precision-engineered to the same standard.',
    items:    ['Feeders & Hoppers', 'Silos & Storage Tanks', 'Pressure Vessels', 'Rotary Air Locks', 'Idler Rollers & Pulleys'],
    iconPath: 'M2 7h20v14H2z M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16',
  },
];
---

<section class="products-section" id="products" aria-labelledby="products-heading">
  <div class="products-inner">

    <div class="products-header">
      <div>
        <div class="section-tag reveal">
          <div class="tag-line"></div>
          <span>VECTOMEC™ Product Line</span>
        </div>
        <h2 class="section-headline reveal" id="products-heading">
          What We <span class="accent">Build</span>
        </h2>
      </div>
      <a href="/products" class="btn-outline reveal" aria-label="View the full VECTOMEC product catalogue">
        View Full Catalogue →
      </a>
    </div>

    <div class="products-grid" role="list">
      {products.map(p => (
        <a href={p.href} class="product-card reveal" role="listitem" aria-label={p.title}>
          <div class="pc-number">{p.num}</div>

          <svg class="pc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d={p.iconPath}/>
          </svg>

          <h3 class="pc-title">{p.title}</h3>
          <div class="pc-subtitle">{p.subtitle}</div>
          <p class="pc-desc">{p.desc}</p>

          <ul class="pc-items" aria-label={`${p.title} products`}>
            {p.items.map(item => <li>{item}</li>)}
          </ul>

          <div class="pc-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── DARK navy gradient ── */
  .products-section {
    padding: clamp(56px,8vh,96px) 0;
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;
  }

  .products-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px,4vw,48px);
  }

  /* Header row */
  .products-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: clamp(24px,4vh,40px);
  }

  /* Section tag — crimson on dark bg */
  .section-tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .tag-line    { width: 28px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .section-tag span { font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--crimson-l); }

  /* Headline — white + red accent (dark section) */
  .section-headline { font-family: var(--font-head); font-weight: 800; font-size: clamp(32px,4.5vw,56px); text-transform: uppercase; line-height: .97; color: var(--white); margin-bottom: 0; }
  .accent { color: var(--crimson-l); }

  /* Outline button — inverted for dark bg */
  .btn-outline {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    border: 1px solid rgba(208,212,220,.2);
    background: #c0181e;
    padding: 10px 20px;
    border-radius: 4px;
    transition: background .2s, color .2s, border-color .2s;
    min-height: 44px;
    white-space: nowrap;
  }
  .btn-outline:hover { color: var(--white); border-color: rgba(208,212,220,.5); }

  /* Grid — mobile: 1 col, tablet: 2 col, desktop: 3 col */
  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px)  { .products-grid { grid-template-columns: repeat(2,1fr); gap: 20px; } }
  @media (min-width: 1024px) { .products-grid { grid-template-columns: repeat(3,1fr); gap: 24px; } }

  /* Card — white on dark section */
  .product-card {
    background: #ffffff;
    padding: clamp(22px,3vw,36px) clamp(20px,2.5vw,30px);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,.2);
    border-top: 3px solid transparent;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: border-top-color .25s, box-shadow .25s, transform .25s;
  }
  .product-card:hover {
    border-top-color: #c0181e;
    box-shadow: 0 12px 36px rgba(0,0,0,.35);
    transform: translateY(-3px);
  }
  .product-card:focus-visible { outline: 2px solid #c0181e; outline-offset: 2px; }

  .pc-number {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .15em;
    color: rgba(192,24,30,.35);
    margin-bottom: 16px;
  }
  .pc-icon {
    width: 44px; height: 44px;
    margin-bottom: 18px;
    color: #c0181e;
    opacity: .85;
  }
  .pc-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(17px,2vw,22px);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: rgba(8,56,146,.9);
    margin-bottom: 4px;
    line-height: 1.1;
  }
  .pc-subtitle {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .12em;
    color: #c0181e;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .pc-desc {
    font-size: clamp(13px,1.3vw,14px);
    font-weight: 400;
    color: #3a4560;
    line-height: 1.65;
    margin-bottom: 18px;
    flex: 1;
  }
  .pc-items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }
  .pc-items li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: #4a5a78;
  }
  .pc-items li::before {
    content: '';
    width: 5px; height: 5px;
    background: #c0181e;
    flex-shrink: 0;
    clip-path: polygon(50% 0%,100% 50%,50% 100%,0% 50%);
  }
  .pc-arrow {
    position: absolute;
    bottom: clamp(18px,2vw,24px);
    right: clamp(18px,2vw,24px);
    width: 32px; height: 32px;
    border: 1px solid rgba(192,24,30,.3);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c0181e;
    transition: background .2s, color .2s;
  }
  .product-card:hover .pc-arrow { background: #c0181e; color: #fff; }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
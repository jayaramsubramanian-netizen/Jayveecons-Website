---
// ContactHero.astro — unified with CareersHero pattern
---

<section class="sph-section">

  <div class="ch-flow-col" aria-hidden="true">
    <div class="ch-flow-line"></div>
    <div class="ch-flow-glow" id="contact-flow-glow"></div>
  </div>

  <!-- Blueprint background image -->
  <div class="ch-blueprint" aria-hidden="true">
    <img src="/images/ScrewConv_blueprint.png" alt="" draggable="false" />
  </div>

  <div class="sph-inner">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current" aria-current="page">Contact Us</span>
    </nav>

    <div class="page-eyebrow">
      <div class="page-eyebrow-line"></div>
      <span>Get in Touch</span>
    </div>

    <h1 class="page-title">
      Let's Talk<br>
      <span class="accent">Engineering</span>
    </h1>

    <p class="page-sub">
      Have a project brief, a technical question, or equipment requirement ? <br>Explore what's possible — our engineering team is ready to help design the right solution.
    </p>

  </div>
</section>

<style>
  .sph-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(100px, 14vh, 140px) clamp(48px, 7vh, 80px);
  }
  .sph-section::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,24,30,.3) 50%, transparent);
    pointer-events: none;
  }

  /* ── Blueprint image ── */
  .ch-blueprint {
    position: absolute;
    /* Anchor to the right side, vertically centered */
    top: 30%;
    right: -10%;
    transform: translateY(-40%);
    /* Show roughly 55% of the image width — hides the title block on the right */
    width: clamp(380px, 52vw, 780px);
    z-index: 0;
    pointer-events: none;
    /* Fade out the left edge so it blends into the text area */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 20%, rgba(0,0,0,1) 50%);
    mask-image:         linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 20%, rgba(0,0,0,1) 50%);
  }
  .ch-blueprint img {
    display: block;
    width: 80%;
    height: auto;
    opacity: 0.35;          /* ← tweak between 0.15–0.20 to taste */
    object-fit: contain;
    /* Desaturate so it reads as a technical watermark, not a colour photo */
    filter: grayscale(30%) brightness(1.15);
    user-select: none;
  }

  /* Hide on narrow viewports — not enough room */
  @media (max-width: 700px) {
    .ch-blueprint { display: none; }
    .ch-flow-col {
      right:calc(clamp(48px, 6vw,96px)+200px - 180px);
    }
  }

  /* Flow column */
  .ch-flow-col {
    position: absolute;
    top: 0; bottom: 0;
    right: calc(clamp(48px, 6vw, 96px) + 200px);
    width: 2px;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 900px) { .ch-flow-col { display: block; } }

  .ch-flow-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(208,212,220,.12) 8%, rgba(208,212,220,.12) 92%, transparent 100%);
  }
  .ch-flow-glow {
    position: absolute;
    left: 50%; margin-left: -3px;
    top: 0; width: 6px; height: 100px; opacity: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(106,166,255,.12) 10%, rgba(106,166,255,.9) 40%, rgba(180,220,255,1) 50%, rgba(106,166,255,.9) 60%, rgba(106,166,255,.12) 90%, transparent 100%);
    border-radius: 3px; z-index: 3; will-change: top, opacity;
  }

  .sph-inner {
    position: relative; z-index: 1;
    width: 100%; max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    box-sizing: border-box;
  }

  .breadcrumb {
    display: flex; align-items: center; gap: 8px; margin-bottom: 28px;
    flex-wrap: wrap; font-family: var(--font-mono);
    font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
  }
  .breadcrumb a        { color: var(--mist); text-decoration: none; transition: color .2s; min-height: 44px; display: flex; align-items: center; }
  .breadcrumb a:hover  { color: var(--white); }
  .breadcrumb .sep     { color: var(--crimson); opacity: .6; }
  .breadcrumb .current { color: #ff7070; }

  .page-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; animation: fadeUp .7s ease .1s both; }
  .page-eyebrow-line { width: 40px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .page-eyebrow span { font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #ff7070; }

  .page-title {
    font-family: var(--font-head); font-weight: 800;
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase; line-height: .93; letter-spacing: -.01em;
    color: var(--white); margin-bottom: 22px; animation: fadeUp .7s ease .2s both;
  }
  .page-title .accent { color: var(--crimson-l); }

  .page-sub {
    font-family: var(--font-body); font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 300; color: var(--fog); max-width: 640px;
    line-height: 1.75; animation: fadeUp .7s ease .3s both;
  }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow, .page-title, .page-sub { animation: none; }
  }
</style>

<script>
(function () {
  const CYCLE_MS = 5500, FLOW_HEIGHT = 100;
  const section = document.querySelector('.sph-section');
  const col     = section?.querySelector('.ch-flow-col');
  const glow    = document.getElementById('contact-flow-glow');
  if (!section || !col || !glow) return;

  let rafId = null, startTime = null;
  function frame(now) {
    if (!startTime) startTime = now;
    const y = -FLOW_HEIGHT + (col.offsetHeight + FLOW_HEIGHT) * ((now - startTime) % CYCLE_MS / CYCLE_MS);
    glow.style.top = y + 'px';
    rafId = requestAnimationFrame(frame);
  }
  function start() { if (rafId) return; glow.style.opacity = '1'; startTime = null; rafId = requestAnimationFrame(frame); }
  function stop()  { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } glow.style.opacity = '0'; glow.style.top = '0px'; }

  new IntersectionObserver(e => { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.05 }).observe(section);
  document.addEventListener('astro:before-swap', stop);
})();
</script>
<style is:global>
  /* ── Section shell ── */
  .qc-section {
    padding-block: clamp(48px, 7vh, 88px);
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ── Headings ── */
  .qc-heading-wrap {
    margin-bottom: clamp(24px, 4vh, 40px);
    text-align: center;
  }
  .qc-section-headline {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(32px, 4.5vw, 56px);
    text-transform: uppercase;
    line-height: .97;
    color: rgba(8,56,146,.9);
    margin: 0;
  }
  .qc-section-headline .accent { color: #e02428; }

  /* ── Grid — same for both rows ── */
  .qc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    /* align-items: stretch is the default — all cards same height per row */
  }
  @media (min-width: 540px)  { .qc-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 900px)  { .qc-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  /* ══════════════════════════════════════════════════════
     SHARED CARD BASE — Option E gradient, metallic sheen
     Both .qc-card and .tc-card use identical shell styles
  ══════════════════════════════════════════════════════ */
  .qc-card,
  .tc-card {
    position: relative;          /* anchors ::before sheen */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 32px);
    border-radius: 12px;
    border-top: 3px solid rgba(192,24,30,.4);
    text-decoration: none;
    /* Option E gradient */
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.14) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.25) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    box-shadow:
      0 8px 28px rgba(0,0,0,.20),
      0 2px  6px rgba(0,0,0,.12),
      inset 0 1px 0 rgba(192,24,30,.15);
    transition: transform .25s, box-shadow .25s, border-top-color .25s;
  }

  /* Metallic sheen — sits ABOVE the border-top, below content */
  .qc-card::before,
  .tc-card::before {
    content: '';
    position: absolute;
    /* Push down so it doesn't sit on the icon — lives at 3px (below border-top) */
    top: 3px; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.30) 25%,
      rgba(200,225,255,.50) 50%,
      rgba(180,210,255,.30) 75%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* All direct children sit above the sheen */
  .qc-card > *,
  .tc-card > * { position: relative; z-index: 1; }

  .qc-card:hover,
  .tc-card:hover {
    transform: translateY(-3px);
    border-top-color: #c0181e;
    box-shadow:
      0 14px 36px rgba(0,0,0,.26),
      0 4px  10px rgba(0,0,0,.14),
      inset 0 1px 0 rgba(192,24,30,.25);
  }

  /* ══════════════════════════════════════════════════════
     TOP ROW — QUICK CONTACT CARDS
     Icon centred at top; label, value, note below
  ══════════════════════════════════════════════════════ */

  /* Icon wrapper — gives the icon breathing room below the sheen */
  .qc-icon-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
    padding-top: 8px;   /* clear the sheen line */
  }

  .qc-icon {
    width: 36px;
    height: 36px;
    color: #ff9090;
    opacity: .9;
    transition: opacity .2s;
  }
  .qc-card:hover .qc-icon { opacity: 1; color: #ffffff; }

  .qc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #ff9090;
    margin-bottom: 10px;
    text-align: center;
  }

  /* Unified value font — same size as tc-name */
  .qc-value {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 18px);
    color: #ffffff;
    letter-spacing: .02em;
    line-height: 1.35;
    margin-bottom: 10px;
    text-align: center;
    flex: 1;                 /* pushes .qc-note to the bottom */
  }

  /* Unified note font — same size as tc-dept */
  .qc-note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #e2ecf8;
    line-height: 1.55;
    text-align: center;
    margin-top: auto;
  }

  /* ══════════════════════════════════════════════════════
     BOTTOM ROW — TEAM CONTACT CARDS
     Role tag, name, dept, then contacts pushed to bottom
  ══════════════════════════════════════════════════════ */

  .tc-top {
    flex: 1;          /* pushes .tc-contact to the card bottom */
    padding-top: 8px; /* clear the sheen line */
  }

  .tc-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #ff9090;
    margin-bottom: 10px;
  }

  /* Unified name — same weight/size as qc-value */
  .tc-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 18px);
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #ffffff;
    margin-bottom: 8px;
  }

  /* Unified dept — same as qc-note */
  .tc-dept {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #e2ecf8;
    line-height: 1.55;
    margin-bottom: 20px;
  }

  /* Contact links sit at bottom, separated from copy above */
  .tc-contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid rgba(180,210,255,.12);
    margin-top: auto;
  }

  .tc-contact a {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #e2ecf8;
    text-decoration: none;
    transition: color .2s;
  }
  .tc-contact a:hover { color: #ffffff; }
  .tc-contact svg {
    width: 14px; height: 14px;
    flex-shrink: 0;
    color: #ff9090;
  }

  /* ── Reveal ── */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
<style>
  /* ── Section shell — light background as per original design ── */
  .qc-section {
    background: #f8fafc;
    padding-block: clamp(48px, 7vh, 88px);
  }

  /* ── Heading wrapper ── */
  .qc-heading-wrap {
    margin-bottom: clamp(24px, 4vh, 40px);
    text-align: center;
  }

  /* ── Section headline
     Blue base + red accent — your original palette.
     Font size matches site-wide h2 clamp scale.      ── */
  .qc-section-headline {
    font-family: var(--font-head);
    font-weight: 800; 
    font-size:clamp(32px,4.5vw,56px);
    text-transform: uppercase;
    line-height: .97;
    letter-spacing: -.01em;
    color: rgba(8, 56, 146, 0.9);   /* your original navy blue */
    margin: 0;
  }
  .qc-section-headline .accent {
    color: #e02428;                  /* your original red */
  }

  /* ── Card grid — mobile-first
       base  : 1 column  (phones)
       540px : 2 columns (large phones / small tablets)
       900px : 3 columns (tablets and up)
     Gap steps up with the container padding breakpoints ── */
  .qc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 0;                   /* heading wrapper carries the bottom margin */
  }
  @media (min-width: 540px)  { .qc-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 900px)  { .qc-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  @media (min-width: 1440px) { .qc-grid { gap: 32px; } }

  /* ── Shared card shell — your original gradient ── */
  .card {
    background:
      radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transition: transform .3s ease;
  }
  @media (min-width: 768px)  { .card { padding: 28px; } }
  @media (min-width: 1024px) { .card { padding: 32px; } }
  .card:hover { transform: translateY(-4px); }

  /* ── Kill underlines on all card links ── */
  .card a,
  .card a:link,
  .card a:visited,
  .card a:hover,
  .card a:active { text-decoration: none; }

  /* ── Quick contact card (full-card link) ── */
  .qc-card { display: block; text-decoration: none; }
  .qc-card:hover .qc-value { color: var(--fog); }
  .qc-card:hover .qc-note  { color: #a0b0c8; }
  .qc-card:hover .qc-label { color: #ff7070; }
  .qc-card:hover .qc-icon  { opacity: 1; }

  .qc-icon {
    width: 40px;
    height: 40px;
    color: var(--crimson-l);
    margin: 0 auto 18px;
    opacity: .85;
    display: block;
    transition: opacity .2s;
  }
  .qc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--crimson-l);
    margin-bottom: 8px;
    display: block;
    text-align: center;
    transition: color .2s;
  }
  .qc-value {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(15px, 1.6vw, 20px);
    color: var(--white);
    letter-spacing: .02em;
    line-height: 1.3;
    margin-bottom: 6px;
    display: block;
    text-align: center;
    transition: color .2s;
  }
  .qc-note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #8898b0;
    line-height: 1.5;
    display: block;
    text-align: center;
    transition: color .2s;
  }

  /* ── Team contact card ── */
  .tc-card { display: flex; flex-direction: column; }
  .tc-role {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #ff7070;
    margin-bottom: 8px;
  }
  .tc-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--white);
    margin-bottom: 4px;
  }
  .tc-dept {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #8898b0;
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .tc-contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }
  .tc-contact a {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #9098b0;
    transition: color .2s;
  }
  .tc-contact a:hover { color: var(--fog); }
  .tc-contact svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--crimson-l);
  }
</style>
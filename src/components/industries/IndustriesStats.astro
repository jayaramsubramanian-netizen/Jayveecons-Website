---
// IndustriesStats.astro
// 4-up stat section — styled to match QuickContactCards.astro exactly:
//   • #f8fafc light section background
//   • page-container token for layout
//   • Dark navy gradient cards with border-radius:12px, box-shadow, hover lift
//   • Section headline: navy + crimson accent
---

<style>
  /* ── Section shell — matches qc-section ── */
  .stat-section {
    
    padding-block: clamp(48px, 7vh, 88px);
    background-color: #f8fafc;
background-image:
  linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
  linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
background-size: 60px 60px;
  }

  /* ── Heading wrapper — matches qc-heading-wrap ── */
  .stat-heading-wrap {
    margin-bottom: clamp(24px, 4vh, 40px);
    text-align: center;
  }

  /* ── Section headline — matches qc-section-headline ── */
  .stat-section-headline {
    font-family: var(--font-head);
    font-weight: 800; 
    font-size:clamp(32px,4.5vw,56px);
    text-transform: uppercase;
    line-height: .97;
    letter-spacing: -.01em;
    color: rgba(8, 56, 146, 0.9);
    margin: 0;
  }
  .stat-section-headline .accent { color: #e02428; }

  /* ── Card grid — matches qc-grid breakpoints exactly ── */
  .stat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 540px)  { .stat-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 900px)  { .stat-grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  @media (min-width: 1440px) { .stat-grid { gap: 32px; } }

  /* ── Stat card — exact .card gradient, radius, shadow, hover from QuickContactCards ── */
  .stat-card {
    background:
      radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transition: transform .3s ease;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px)  { .stat-card { padding: 28px; } }
  @media (min-width: 1024px) { .stat-card { padding: 32px; } }
  .stat-card:hover { transform: translateY(-4px); }

  /* ── Number — large, white, same weight as qc-value ── */
  .stat-num {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    color: var(--white);
    letter-spacing: -.02em;
    margin-bottom: 8px;
  }
  .stat-num .u {
    font-size: .5em;
    color: #ff7070;
  }

  /* ── Label — matches tc-role / qc-label mono style ── */
  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
  }

  /* ── Detail — matches tc-dept / qc-note body style ── */
  .stat-detail {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #8898b0;
    line-height: 1.5;
    margin-top: auto;
  }
</style>

<section class="stat-section" aria-label="Key statistics">
  <div class="page-container">

    <div class="stat-heading-wrap reveal">
      <h2 class="stat-section-headline">
        Four Decades. <span class="accent">Five Sectors.</span>
      </h2>
    </div>

    <div class="stat-grid">

      <div class="stat-card reveal">
        <div class="stat-num">5<span class="u">+</span></div>
        <div class="stat-label">Active Industries</div>
        <div class="stat-detail">Cement · Mining · Food &amp; Agri · Waste · Steel &amp; Fertilizers</div>
      </div>

      <div class="stat-card reveal">
        <div class="stat-num">3</div>
        <div class="stat-label">Growth Sectors</div>
        <div class="stat-detail">Oil &amp; Gas · Pharmaceuticals · Agriculture Processing</div>
      </div>

      <div class="stat-card reveal">
        <div class="stat-num" id="ind-years">39<span class="u">+</span></div>
        <div class="stat-label">Years Domain Experience</div>
        <div class="stat-detail">Cross-sector bulk material expertise since 1987</div>
      </div>

      <div class="stat-card reveal">
        <div class="stat-num">4</div>
        <div class="stat-label">VECTOMEC™ Product Lines</div>
        <div class="stat-detail">Handling · Processing · Ancillary · Parts &amp; Spares</div>
      </div>

    </div>
  </div>
</section>

<script>
  const el = document.getElementById('ind-years');
  if (el) {
    const yr = new Date().getFullYear() - 1987;
    el.innerHTML = `${yr}<span class="u">+</span>`;
  }
</script>
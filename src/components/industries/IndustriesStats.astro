---
// IndustriesStats.astro
---

<style>
  .stat-section {
    padding-block: clamp(48px, 7vh, 88px);
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .stat-heading-wrap {
    margin-bottom: clamp(24px, 4vh, 40px);
    text-align: center;
  }

  .stat-section-headline {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(32px, 4.5vw, 56px);
    text-transform: uppercase;
    line-height: .97;
    letter-spacing: -.01em;
    color: rgba(8, 56, 146, 0.9);
    margin: 0;
  }
  .stat-section-headline .accent { color: #e02428; }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 540px)  { .stat-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 900px)  { .stat-grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  @media (min-width: 1440px) { .stat-grid { gap: 32px; } }

  .stat-card {
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.14) 0%, transparent 55%),
      radial-gradient(ellipse 60%  80% at 90% 110%, rgba(8,56,146,.25) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transition: transform .3s ease;
    display: flex;
    flex-direction: column;
  }
  /* metallic-sheen */
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }
  @media (min-width: 768px)  { .stat-card { padding: 28px; }
  /* metallic-sheen */
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  } }
  @media (min-width: 1024px) { .stat-card { padding: 32px; }
  /* metallic-sheen */
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  } }
  .stat-card:hover { transform: translateY(-4px); }

  /* FIX: .stat-num sets the base size. .u is always relative to it — consistent across all cards */
  .stat-num {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    color: var(--white);
    letter-spacing: -.02em;
    margin-bottom: 8px;
  }
  /* FIX: explicit font-size so it never inherits a shrunken context,
     and explicit color so it's always red regardless of how the element is rendered */
  .stat-num .u{color: #ff7070;},
  #ind-years .u{color: #ff7070;},
  #ind-years span {
    font-size: clamp(40px, 5vw, 56px);
    color: #ff7070 !important;
    font-weight: 800;
    vertical-align: baseline;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .stat-detail {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: #8898b0;
    line-height: 1.5;
    margin-top: auto;
  }
</style>

<section class="stat-section" aria-label="Key statistics">
  <div class="page-container">

    <div class="stat-heading-wrap reveal">
      <h2 class="stat-section-headline">
        Four Decades. <span class="accent">Five Sectors.</span>
      </h2>
    </div>

    <div class="stat-grid">

      <div class="stat-card reveal">
        <!-- FIX: suffix rendered as sibling span, not nested inside .u -->
        <div class="stat-num">5<span class="u">+</span></div>
        <div class="stat-label">Active Industries</div>
        <div class="stat-detail">Cement · Mining · Food &amp; Agri · Waste · Steel &amp; Fertilizers</div>
      </div>

      <div class="stat-card reveal">
        <div class="stat-num">3</div>
        <div class="stat-label">Growth Sectors</div>
        <div class="stat-detail">Oil &amp; Gas · Pharmaceuticals · Agriculture Processing</div>
      </div>

      <!-- FIX: id present, script will replace with calculated year -->
      <div class="stat-card reveal">
        <div class="stat-num" id="ind-years"></div>
        <div class="stat-label">Years Domain Experience</div>
        <div class="stat-detail">Cross-sector bulk material expertise since 1987</div>
      </div>

      <div class="stat-card reveal">
        <div class="stat-num">4</div>
        <div class="stat-label">VECTOMEC™ Product Lines</div>
        <div class="stat-detail">Handling · Processing · Ancillary · Parts &amp; Spares</div>
      </div>

    </div>
  </div>
</section>

<script>
  const el = document.getElementById('ind-years');
  if (el) {
    const yr = new Date().getFullYear() - 1987;
    el.innerHTML = `${yr}`;
  }
</script>
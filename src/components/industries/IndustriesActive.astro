<!-- Reveal observer -->
<script>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.07 });
  document.querySelectorAll('.ind-active-section .reveal').forEach(el => obs.observe(el));

  // Wire buttons to modal
  document.querySelectorAll('.ind-card-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-industry-id');
      document.dispatchEvent(new CustomEvent('open-industry-modal', { detail: { id } }));
    });
  });
</script>

<style>
  /* ── DARK navy gradient ── */
  .ind-active-section {
    width: 100%;
    background:
      radial-gradient(ellipse 90% 70% at 65% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 5%  90%, rgba(192,24,30,.07) 0%, transparent 50%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(52px,7vh,88px);
    border-left: 4px solid transparent;
    transition: border-left-color .3s;
    isolation: isolate;
    overflow: hidden;
  }
  .ind-active-section:hover { border-left-color: var(--crimson); }

  .ind-active-inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px,4vw,48px);
  }

  /* Section tag */
  .section-tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .line        { width: 28px; height: 2px; background: var(--crimson); flex-shrink: 0; }
  .section-tag span { font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--crimson-l); }

  /* Headline — white + red accent (dark section) */
  .section-headline { font-family: var(--font-head); font-weight: 800; font-size: clamp(30px,4vw,52px); text-transform: uppercase; line-height: .97; color: var(--white); margin-bottom: clamp(28px,4vh,44px); }
  .accent { color: var(--crimson-l); }

  /* Card grid — 1 col → 2 col → 3 col */
  .ind-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px)  { .ind-card-grid { grid-template-columns: repeat(2,1fr); gap: 20px; } }
  @media (min-width: 1024px) { .ind-card-grid { grid-template-columns: repeat(3,1fr); gap: 24px; } }

  /* Card — white on dark section */
  .ind-card {
    background: #ffffff;
    padding: clamp(20px,2.5vw,28px);
    border-radius: 12px;
    border-top: 3px solid transparent;
    box-shadow: 0 4px 20px rgba(0,0,0,.2);
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: border-top-color .25s, box-shadow .25s, transform .25s;
  }
  /* metallic-sheen */
  .ind-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }
  .ind-card:hover {
    border-top-color: #c0181e;
    box-shadow: 0 10px 32px rgba(0,0,0,.32);
    transform: translateY(-3px);
  }

  .ind-card-num {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .15em;
    color: rgba(192,24,30,.35);
    margin-bottom: 8px;
  }

  .ind-card-status {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: rgba(192,24,30,.15);
    color: var(--crimson-l);
    border: 1px solid rgba(192,24,30,.25);
    padding: 3px 8px;
    border-radius: 2px;
    display: inline-block;
    margin-bottom: 12px;
    align-self: flex-start;
  }

  .ind-card-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(18px,2vw,22px);
    text-transform: uppercase;
    color: rgba(8,56,146,.9);
    margin-bottom: 10px;
    line-height: 1.1;
  }

  .ind-card-desc {
    font-size: clamp(12px,1.3vw,14px);
    font-weight: 400;
    color: #3a4560;
    line-height: 1.65;
    margin-bottom: 14px;
    flex: 1;
  }

  /* Subsector pills */
  .ind-card-subsectors {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 16px;
  }
  .ind-card-subsectors span {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: rgba(8,56,146,.06);
    border: 1px solid rgba(8,56,146,.16);
    color: rgba(8,56,146,.75);
    padding: 3px 8px;
    border-radius: 2px;
  }

  /* Card footer */
  .ind-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(8,56,146,.1);
    margin-top: auto;
  }

  .ind-card-prod-count {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    color: rgba(8,56,146,.45);
    text-transform: uppercase;
  }

  .ind-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: none;
    border: none;
    cursor: pointer;
    color: #c0181e;
    transition: color .2s;
    padding: 0;
    min-height: 44px;
  }
  .ind-card-btn:hover { color: rgba(8,56,146,.9); }
  .ind-card-btn:focus-visible { outline: 2px solid var(--crimson); outline-offset: 2px; border-radius: 2px; }
  .ind-card-btn svg { width: 14px; height: 14px; }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
---
// IndustriesActive.astro — industry card grid + modal pattern
// Matches ProductGrid/ProductModal architecture exactly.
// 5 cards in white+grid section → navy gradient cards
// Clicking "View Details" opens IndustryModal with full content.
---

<section class="ind-active-section" id="active" aria-labelledby="active-heading">
  <div class="ind-active-inner">

    <div class="section-tag reveal">
      <div class="line"></div>
      <span>Currently Serving</span>
    </div>
    <h2 class="section-headline reveal" id="active-heading">
      Active <span class="accent">Industries</span>
    </h2>

    <div class="ind-card-grid" role="list">

      <!-- 01 CEMENT -->
      <article class="ind-card reveal" role="listitem" data-industry-id="cement">
        <div class="ind-card-num">01 / 05</div>
        <div class="ind-card-status">Active — Core Sector Since 1987</div>
        <h3 class="ind-card-name">Cement</h3>
        <p class="ind-card-desc">Our founding industry. From VSK complete systems to grinding mills, classifiers, and bulk handling — we serve the full cement process chain.</p>
        <div class="ind-card-subsectors">
          <span>VSK Systems</span><span>Kilns</span><span>Grinding</span><span>Handling</span>
        </div>
        <div class="ind-card-footer">
          <span class="ind-card-prod-count">11 Products</span>
          <button class="ind-card-btn" data-industry-id="cement" aria-label="View details for Cement industry" aria-haspopup="dialog">
            View Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </article>

      <!-- 02 MINING -->
      <article class="ind-card reveal" role="listitem" data-industry-id="mining">
        <div class="ind-card-num">02 / 05</div>
        <div class="ind-card-status">Active</div>
        <h3 class="ind-card-name">Mining &amp; Aggregates</h3>
        <p class="ind-card-desc">Crushing, screening, and conveying for ore, limestone, and aggregate processing. AR wear parts standard across all equipment.</p>
        <div class="ind-card-subsectors">
          <span>Mining Ops</span><span>Aggregates</span><span>Ore Processing</span><span>Handling</span>
        </div>
        <div class="ind-card-footer">
          <span class="ind-card-prod-count">9 Products</span>
          <button class="ind-card-btn" data-industry-id="mining" aria-label="View details for Mining industry" aria-haspopup="dialog">
            View Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </article>

      <!-- 03 FOOD -->
      <article class="ind-card reveal" role="listitem" data-industry-id="food">
        <div class="ind-card-num">03 / 05</div>
        <div class="ind-card-status">Active</div>
        <h3 class="ind-card-name">Food Processing</h3>
        <p class="ind-card-desc">Stainless steel conveying, screening, storage, and drying for grains, pulses, spices, sugar, and processed food. Full cleanability standard.</p>
        <div class="ind-card-subsectors">
          <span>Grains</span><span>Pulses</span><span>Spices</span><span>Sugar</span><span>Processed Foods</span>
        </div>
        <div class="ind-card-footer">
          <span class="ind-card-prod-count">7 Products</span>
          <button class="ind-card-btn" data-industry-id="food" aria-label="View details for Food Processing industry" aria-haspopup="dialog">
            View Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </article>

      <!-- 04 WASTE -->
      <article class="ind-card reveal" role="listitem" data-industry-id="waste">
        <div class="ind-card-num">04 / 05</div>
        <div class="ind-card-status">Active — Integrated Equipment Solutions</div>
        <h3 class="ind-card-name">Waste Management</h3>
        <p class="ind-card-desc">Integrated handling and processing for municipal and industrial waste. Proven in KCDC Karnataka municipal projects for biodegradable recovery.</p>
        <div class="ind-card-subsectors">
          <span>Municipal Waste</span><span>Industrial Waste</span><span>Organic Recovery</span><span>Value Outputs</span>
        </div>
        <div class="ind-card-footer">
          <span class="ind-card-prod-count">7 Products</span>
          <button class="ind-card-btn" data-industry-id="waste" aria-label="View details for Waste Management industry" aria-haspopup="dialog">
            View Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </article>

      <!-- 05 STEEL -->
      <article class="ind-card reveal" role="listitem" data-industry-id="steel">
        <div class="ind-card-num">05 / 05</div>
        <div class="ind-card-status">Active — Built for Extreme Conditions</div>
        <h3 class="ind-card-name">Steel, Coal &amp; Fertilizers</h3>
        <p class="ind-card-desc">High-temperature and abrasion-resistant systems for steel, coal, refractory, and fertilizer operations. Continuous heavy-duty performance.</p>
        <div class="ind-card-subsectors">
          <span>Steel Plants</span><span>Coal</span><span>Refractory</span><span>Fertilizers</span>
        </div>
        <div class="ind-card-footer">
          <span class="ind-card-prod-count">10 Products</span>
          <button class="ind-card-btn" data-industry-id="steel" aria-label="View details for Steel industry" aria-haspopup="dialog">
            View Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      </article>

    </div>
  </div>
</section>


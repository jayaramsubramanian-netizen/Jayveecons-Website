  { icon: `<path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/><path d="M12 6v6l4 2"/>`,                                                                          label: 'Grains' },
  { icon: `<circle cx="12" cy="12" r="3"/><circle cx="6" cy="7" r="2"/><circle cx="18" cy="7" r="2"/>`,                                                       label: 'Pulses' },
  { icon: `<path d="M12 2L8 8H4l3.5 3-1.5 5L12 13l6 3-1.5-5L20 8h-4z"/>`,                                                                                    label: 'Spices' },
  { icon: `<path d="M3 6h18v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6zM3 6l2-4h14l2 4"/>`,                                                                            label: 'Sugar' },
  { icon: `<path d="M20 7H4a1 1 0 00-1 1v10a1 1 0 001 1h16a1 1 0 001-1V8a1 1 0 00-1-1zM16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>`,                          label: 'Processed<br>Foods' },
];
const wasteSubsectors = [
  { icon: `<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/>`,                                                                                                  label: 'Municipal<br>Waste' },
  { icon: `<path d="M3 21h18M3 3h18v4H3zM7 7v14M17 7v14"/>`,                                                                                                 label: 'Industrial<br>Waste' },
  { icon: `<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"/>`, label: 'Organic<br>Recovery' },
  { icon: `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,                                                                             label: 'Value Added<br>Outputs' },

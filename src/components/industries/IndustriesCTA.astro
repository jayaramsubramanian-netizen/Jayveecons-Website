---
// IndustriesCTA.astro
// Background: WHITE + blue square grid (light section)
// All text, accents and buttons updated for light background
---

<style>
  /* ── WHITE + BLUE GRID BACKGROUND ── */
  .cta-band {
    padding-block: clamp(56px, 9vh, 104px);
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    border-top: 1px solid rgba(8,56,146,.08);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .cta-inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  /* Eyebrow — crimson on light */
  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    color: #c0181e;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  /* Headline — navy base + red accent (light section) */
  .cta-headline {
    font-family: var(--font-head);
    font-weight: 800;
    font-size:clamp(32px,4.5vw,56px);
    text-transform: uppercase;
    line-height: .97;
    color: rgba(8,56,146,.9);
    margin-bottom: 14px;
  }
  .cta-headline .accent { color: #c0181e; }

  /* Sub copy — dark on light */
  .cta-sub {
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 400;
    color: #2a3550;
    line-height: 1.65;
    max-width: 560px;
  }

  /* Buttons row */
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  @media (min-width: 640px) {
    .cta-actions { flex-direction: row; align-items: center; }
  }
  @media (min-width: 1024px) {
    .cta-inner   { grid-template-columns: 1fr auto; }
    .cta-actions { flex-direction: column; align-items: flex-end; }
  }

  /* Primary button — crimson, unchanged */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #c0181e;
    color: #ffffff;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 13px 30px;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transition: background .2s, transform .2s;
    white-space: nowrap;
    min-height: 44px;
  }
  .btn-primary:hover { background: var(--crimson-l); transform: translateX(2px); }
  .btn-primary svg { flex-shrink: 0; }

  /* Secondary button — navy border on light bg */
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background:  rgba(8,56,146,.9);
    color: #ffffff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 30px;
    border: 1px solid rgba(8,56,146,.25);
    border-radius: 2px;
    transition: background .2s, color .2s, border-color .2s;
    white-space: nowrap;
    min-height: 44px;
  }
  .btn-secondary:hover {
    background: rgba(8,56,146,.06);
    color: rgba(8,56,146,1);
    border-color: rgba(8,56,146,.45);
  }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="cta-inner">

    <div class="reveal">
      <div class="cta-eyebrow">Let's Talk About Your Industry</div>
      <h2 class="cta-headline" id="cta-heading">
        Your Domain.<br>Our <span class="accent">Engineered Solutions.</span>
      </h2>
      <p class="cta-sub">
        Whether you're in an industry we've served for decades or a sector we're entering
        for the first time — tell us about your material, your capacity, and your challenge.
        Our engineers will respond within 24 hours.
      </p>
    </div>

    <div class="cta-actions reveal">
      <a href="/contact" class="btn-primary" aria-label="Request a quote from Jayveecons">
        Request a Quote
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="/products" class="btn-secondary" aria-label="View VECTOMEC product catalogue">
        View Products →
      </a>
    </div>

  </div>
</section>
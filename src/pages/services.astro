---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesPageHeader  from '../components/services/ServicesPageHeader.astro';
import DeliveryOverview    from '../components/services/DeliveryOverview.astro';
import ServicesList        from '../components/services/ServicesList.astro';
import ServicePromise      from '../components/services/ServicePromise.astro';
import ServicesCta         from '../components/services/ServicesCta.astro';
import ServicesYearScript  from '../components/services/ServicesYearScript.astro';

const seo = {
  title: 'Services — Jayveecons Group',
  description: 'Jayveecons engineering services — design, fabrication, erection and commissioning, parts and spares, and repair and refurbishment for material handling and processing equipment.',
  keywords: [
    'Jayveecons engineering services',
    'industrial equipment design India',
    'bulk material handling fabrication',
    'conveyor erection commissioning',
    'industrial equipment parts and spares',
    'material handling equipment repair',
    'equipment refurbishment Karnataka',
  ].join(', '),
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  currentPath="/services"
>
  <ServicesPageHeader />   <!-- dark navy gradient — matches ContactHero -->
  <DeliveryOverview />     <!-- white + blue grid — alternates -->
  <ServicesList />         <!-- dark navy gradient -->
  <ServicePromise />       <!-- white + blue grid -->
  <ServicesCta />          <!-- dark navy gradient -->
  <ServicesYearScript />
</BaseLayout>
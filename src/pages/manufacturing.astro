---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Manufacturing Capability — Coming Soon | Jayveecons Group"
  description="Explore Jayveecons and AkshayVipra El-Mec manufacturing capability in Malur, Karnataka, including fabrication, machining, quality standards, and production capacity."
  keywords="AkshayVipra El-Mec, industrial fabrication, machining facility, manufacturing capability, Jayveecons, Malur Karnataka"
  currentPath="/manufacturing"
>
  <section style="
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(48px,8vh,96px) 24px;
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
  ">
    <div style="max-width: 560px;">

      <p style="
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: #c0181e;
        margin-bottom: 16px;
      ">Jayveecons Group · Malur, Karnataka</p>

      <h1 style="
        font-family: var(--font-head);
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 800;
        text-transform: uppercase;
        line-height: .97;
        color: rgba(8,56,146,.9);
        margin-bottom: 20px;
      ">
        Manufacturing<br>
        <span style="color: #c0181e;">Capability</span>
      </h1>

      <p style="
        font-size: 16px;
        font-weight: 300;
        color: #2a3550;
        line-height: 1.75;
        margin-bottom: 12px;
      ">
        A dedicated section covering our 90,000 sq.ft fabrication and machining
        facility — equipment, processes, quality standards, and production
        capacity — is currently being prepared.
      </p>

      <p style="
        font-size: 14px;
        font-weight: 300;
        color: #5a6a88;
        line-height: 1.7;
        margin-bottom: 36px;
      ">
        For manufacturing enquiries, facility audits, or vendor qualification
        requests, contact us directly.
      </p>

      <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" style="
          display: inline-flex;
          align-items: center;
          gap: 10px;
          background: #c0181e;
          color: #fff;
          font-family: var(--font-head);
          font-weight: 700;
          font-size: 14px;
          letter-spacing: .1em;
          text-transform: uppercase;
          padding: 16px 44px;
          text-decoration: none;
          clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
          white-space: nowrap;
        ">Contact Us →</a>

        <a href="/about" style="
          display: inline-flex;
          align-items: center;
          gap: 10px;
          background: #163060;
          color: #e2ecf8;
          font-family: var(--font-head);
          font-weight: 700;
          font-size: 14px;
          letter-spacing: .1em;
          text-transform: uppercase;
          padding: 16px 44px;
          text-decoration: none;
          clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
          white-space: nowrap;
        ">About Us</a>
      </div>

    </div>
  </section>
</BaseLayout>

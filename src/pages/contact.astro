---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactHero from "../components/contact/ContactHero.astro";
import QuickContactCards from "../components/contact/QuickContactCards.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ResponsePromise from "../components/contact/ResponsePromise.astro";
import MapEmbed from "../components/contact/MapEmbed.astro";

const seo = {
  title: "Contact Jayveecons | Bulk Material Handling Equipment Manufacturer — Malur, Karnataka",
  description: "Contact the Jayveecons engineering team for VECTOMEC™ bulk material handling equipment — screw conveyors, bucket elevators, VSK kilns, ball mills, crushers, and storage silos. Request a quote or technical consultation. Est. 1987. Malur, Karnataka, India.",
  keywords: [
    "bulk material handling equipment manufacturer India",
    "screw conveyor manufacturer Karnataka",
    "bucket elevator manufacturer India",
    "VSK vertical shaft kiln manufacturer",
    "ball mill manufacturer India",
    "belt conveyor manufacturer Karnataka",
    "crusher manufacturer India",
    "nodulizer manufacturer",
    "air slide manufacturer",
    "dust collector manufacturer India",
    "storage silo manufacturer India",
    "cement plant equipment manufacturer India",
    "mining equipment manufacturer India",
    "food grade conveyor manufacturer India",
    "waste management equipment India",
    "steel plant material handling",
    "fertilizer plant equipment manufacturer",
    "Jayveecons Group",
    "VECTOMEC equipment",
    "industrial equipment manufacturer Malur",
    "industrial equipment manufacturer Karnataka",
    "bulk material handling Bengaluru",
    "engineering equipment manufacturer India 1987",
    "request quote material handling equipment",
    "bulk handling equipment RFQ India",
    "industrial conveyor quote India",
    "contact cement plant equipment supplier",
  ].join(", "),
};
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} currentPath="/contact">

  <ContactHero />
  <QuickContactCards />

  <section class="contact-section">
    <div class="page-container contact-grid">
      <ResponsePromise />
      <ContactForm />
    </div>
  </section>

  <MapEmbed />

  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.jayveecons.com/#org",
        "name": "Jayveecons Group",
        "alternateName": "Jayveecons",
        "url": "https://www.jayveecons.com",
        "foundingDate": "1987",
        "description": "Manufacturer of VECTOMEC™ bulk material handling and processing equipment for cement, mining, food, waste management, steel and fertilizer industries.",
        "logo": "https://www.jayveecons.com/images/logo.png",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "1st Phase, Plot 87/D2, Mcnally Road, Industrial Estate",
          "addressLocality": "Malur",
          "addressRegion": "Karnataka",
          "postalCode": "563130",
          "addressCountry": "IN"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+91-94480-88230",
            "contactType": "sales",
            "areaServed": "IN",
            "availableLanguage": ["English", "Kannada", "Hindi"],
            "hoursAvailable": {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
              "opens": "09:00",
              "closes": "18:00"
            }
          },
          {
            "@type": "ContactPoint",
            "email": "sales@jayveecons.com",
            "contactType": "sales"
          },
          {
            "@type": "ContactPoint",
            "email": "engineering@jayveecons.com",
            "contactType": "technical support"
          },
          {
            "@type": "ContactPoint",
            "telephone": "+91-95388-87101",
            "email": "service@jayveecons.com",
            "contactType": "customer service"
          }
        ],
        "sameAs": []
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.jayveecons.com" },
          { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.jayveecons.com/contact" }
        ]
      }
    ]
  })}</script>

</BaseLayout>

<style>
/* ══════════════════════════════════════════════════
   CONTAINER TOKEN
   Single source of truth for max-width + padding.
   ── Copy the block marked GLOBAL into BaseLayout
      so every component shares it automatically.
   ══════════════════════════════════════════════════

   GLOBAL — paste into BaseLayout <style is:global>:

   .page-container {
     width: 100%;
     margin-inline: auto;
     padding-inline: 16px;
     box-sizing: border-box;
   }
   @media (min-width: 480px)  { .page-container { padding-inline: 20px; } }
   @media (min-width: 768px)  { .page-container { padding-inline: 32px; } }
   @media (min-width: 1024px) { .page-container { padding-inline: 48px; } }
   @media (min-width: 1440px) { .page-container { max-width: 1440px; padding-inline: 48px; } }

   ══════════════════════════════════════════════════ */

/* Local copy (remove once added to BaseLayout global) */
.page-container {
  width: 100%;
  margin-inline: auto;
  padding-inline: 16px;
  box-sizing: border-box;
}
@media (min-width: 480px)  { .page-container { padding-inline: 20px; } }
@media (min-width: 768px)  { .page-container { padding-inline: 32px; } }
@media (min-width: 1024px) { .page-container { padding-inline: 48px; } }
@media (min-width: 1440px) { .page-container { max-width: 1440px; padding-inline: 48px; } }

/* ══════════════════════════════════════════════════
   CONTACT SECTION
   Mobile-first: single column → two columns at 1024px
   ══════════════════════════════════════════════════ */
.contact-section {
  background:
    radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.85) 0%, transparent 60%),
    radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
    linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
  padding-block: clamp(40px, 7vh, 88px);
}

/* Mobile default: stack vertically */
.contact-grid {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Tablet: increase gap, still stacked */
@media (min-width: 768px) {
  .contact-grid { gap: 40px; }
}

/* Desktop: two-column side-by-side, form slightly wider */
@media (min-width: 1024px) {
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
}
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Industries — Jayveecons Group"
  description="Jayveecons serves cement, mining, food & agriculture, waste management, and steel & ceramics industries with VECTOMEC™ material handling and processing systems."
  currentPath="/industries"
>

<style>
/* PAGE HEADER */
.page-header{position:relative;padding:130px 0 72px;overflow:hidden;background:linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%)}
.page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 60% 50%,rgba(26,50,96,.6),transparent 65%)}
.page-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.page-header-inner{position:relative;z-index:1;max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:18px;font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.breadcrumb a{color:#7a8499;text-decoration:none;transition:color .2s}
.breadcrumb a:hover{color:var(--fog)}
.breadcrumb .sep{color:#3a4255}
.breadcrumb .current{color:#ff7070}
.page-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:14px;animation:fadeUp .7s ease .1s both}
.page-eyebrow-line{width:40px;height:2px;background:var(--crimson)}
.page-eyebrow span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.page-title{font-family:var(--font-head);font-weight:800;font-size:clamp(44px,6.5vw,84px);text-transform:uppercase;line-height:.93;letter-spacing:-.01em;margin-bottom:16px;animation:fadeUp .7s ease .2s both}
.page-title .accent{color:var(--crimson-l)}
.page-title .chrome{background:linear-gradient(135deg,var(--chrome-l),var(--chrome));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.page-sub{font-size:clamp(14px,1.7vw,17px);font-weight:300;color:var(--fog);max-width:640px;line-height:1.75;animation:fadeUp .7s ease .3s both}

/* COMMON */
section{position:relative;z-index:1}
.section-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.section-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:12px}
.section-tag .line{width:28px;height:2px;background:var(--crimson)}
.section-tag span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.section-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(34px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:14px}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--crimson);color:var(--white);font-family:var(--font-head);font-weight:700;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:13px 30px;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:background .2s,transform .2s;white-space:nowrap}
.btn-primary:hover{background:var(--crimson-l);transform:translateX(2px)}
.btn-secondary{display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--chrome);font-family:var(--font-head);font-weight:600;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:12px 30px;border:1px solid rgba(208,212,220,.2);transition:color .2s,border-color .2s;white-space:nowrap}
.btn-secondary:hover{color:var(--white);border-color:rgba(208,212,220,.5)}

/* SECTOR INTRO STAT BAR */
.stat-bar{padding:clamp(32px,5vh,52px) 0;background:var(--navy-deep);border-bottom:1px solid rgba(51,96,184,.15)}
.stat-bar-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px);display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
.stat-item{background:rgba(10,12,18,.6);padding:clamp(18px,2.5vw,28px);border-top:2px solid transparent;transition:border-top-color .3s}
.stat-item:hover{border-top-color:var(--crimson)}
.stat-num{font-family:var(--font-head);font-weight:800;font-size:clamp(36px,5vw,52px);line-height:1;color:var(--white);letter-spacing:-.02em}
.stat-num .u{font-size:.5em;color:#ff7070}
.stat-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7a8aaa;margin-top:5px;margin-bottom:4px}
.stat-detail{font-size:12px;font-weight:300;color:#8898b0;line-height:1.5}
@media(max-width:768px){.stat-bar-inner{grid-template-columns:1fr 1fr}}
@media(max-width:420px){.stat-bar-inner{grid-template-columns:1fr}}

/* ACTIVE SECTORS SECTION */
.active-sectors{padding:clamp(56px,8vh,96px) 0;background:var(--ink-2)}

/* Large industry card */
.ind-card-large{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;
  background:var(--ink-3);
  margin-bottom:2px;
  overflow:hidden;
  border-left:4px solid var(--crimson);
  transition:border-left-color .3s;
}
.ind-card-large:hover{border-left-color:var(--crimson-l)}
.ind-card-large.reverse{direction:rtl}
.ind-card-large.reverse > *{direction:ltr}

.ind-img{
  position:relative;
  overflow:hidden;
  min-height:clamp(220px,30vh,340px);
}
.ind-img img{
  width:100%;height:100%;
  object-fit:cover;
  filter:grayscale(25%) contrast(1.1);
  transition:transform .6s ease,filter .4s;
  display:block;
}
.ind-card-large:hover .ind-img img{transform:scale(1.04);filter:grayscale(10%) contrast(1.15)}
.ind-img::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent 40%,rgba(10,12,18,.85) 100%);
}
.ind-card-large.reverse .ind-img::after{
  background:linear-gradient(270deg,transparent 40%,rgba(10,12,18,.85) 100%);
}

.ind-body{padding:clamp(28px,4vw,52px);display:flex;flex-direction:column;justify-content:center;gap:0}
.ind-status{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px}
.ind-status-dot{width:8px;height:8px;border-radius:50%;background:var(--crimson);flex-shrink:0}
.ind-status-dot.target{background:var(--teal-l)}
.ind-status span{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#ff7070}
.ind-status span.target{color:var(--teal-l)}
.ind-name{font-family:var(--font-head);font-weight:800;font-size:clamp(28px,4vw,46px);text-transform:uppercase;letter-spacing:.01em;color:var(--white);line-height:.95;margin-bottom:14px}
.ind-desc{font-size:clamp(14px,1.5vw,15px);font-weight:300;color: #e2ecf8;line-height:1.8;margin-bottom:20px}
.ind-products-title{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#ff7070;margin-bottom:10px}
.ind-products{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:22px}
.ind-product-tag{font-family:var(--font-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;background:rgba(13,26,58,.8);border:1px solid rgba(51,96,184,.3);color:#7ab0ff;padding:4px 10px}
.ind-cta{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--crimson-l);text-decoration:none;transition:color .2s}
.ind-cta:hover{color:var(--white)}
.ind-cta svg{width:12px;height:12px}

/* TARGET SECTORS */
.target-sectors{padding:clamp(56px,8vh,96px) 0;background:var(--ink)}
.target-intro{max-width:800px;margin-bottom:clamp(32px,4vh,52px)}
.target-intro p{font-size:clamp(15px,1.6vw,17px);font-weight:300;color:var(--fog);line-height:1.8;margin-top:16px}

.target-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.target-card{
  background:var(--ink-2);padding:clamp(24px,3vw,36px);
  border-top:2px solid var(--teal-l);
  position:relative;overflow:hidden;
  transition:background .3s;
}
  /* metallic-sheen */
  .target-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(180,210,255,.35) 25%,
      rgba(200,225,255,.55) 50%,
      rgba(180,210,255,.35) 75%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }
.target-card:hover{background:rgba(13,122,110,.06)}
.target-card::before{
  content:'';position:absolute;top:0;right:0;
  width:60px;height:60px;
  background:radial-gradient(circle at top right,rgba(20,168,152,.08),transparent 70%);
  pointer-events:none;
}
.tc-icon{width:40px;height:40px;color:var(--teal-l);margin-bottom:18px;opacity:.85}
.tc-name{font-family:var(--font-head);font-weight:700;font-size:clamp(20px,2.5vw,26px);text-transform:uppercase;letter-spacing:.04em;color:var(--white);margin-bottom:8px}
.tc-status{font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;background:rgba(20,168,152,.12);color:var(--teal-l);padding:3px 8px;display:inline-block;margin-bottom:14px}
.tc-desc{font-size:clamp(13px,1.4vw,14px);font-weight:300;color:#9098b0;line-height:1.7;margin-bottom:16px}
.tc-opportunity{font-size:12px;font-weight:300;color:#7a8aaa;line-height:1.6;border-top:1px solid rgba(20,168,152,.1);padding-top:14px;margin-top:4px}
.tc-opportunity strong{color:var(--teal-l);font-weight:500}

/* WHY JAYVEECONS ACROSS SECTORS */
.cross-sector{padding:clamp(56px,8vh,96px) 0;background:var(--navy-deep)}
.cross-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,5vw,80px);align-items:center}
.cross-copy{}
.cross-copy p{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.8;margin-bottom:16px}
.cross-copy p strong{color:var(--white);font-weight:500}
.cross-points{display:flex;flex-direction:column;gap:2px}
.cross-point{background:rgba(10,12,18,.7);padding:clamp(16px,2vw,22px);display:flex;gap:16px;align-items:flex-start;border-left:3px solid transparent;transition:border-left-color .25s,background .25s}
.cross-point:hover{background:rgba(13,26,58,.5);border-left-color:var(--crimson)}
.cp-icon{width:36px;height:36px;background:rgba(192,24,30,.12);border:1px solid rgba(192,24,30,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--crimson-l)}
.cp-icon svg{width:18px;height:18px}
.cp-title{font-family:var(--font-head);font-weight:700;font-size:16px;text-transform:uppercase;letter-spacing:.05em;color:var(--chrome);margin-bottom:4px}
.cp-desc{font-size:13px;font-weight:300;color:#8898b0;line-height:1.6}

/* CTA BAND */
.cta-band{padding:clamp(64px,9vh,104px) 0;background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 60%);position:relative;overflow:hidden}
.cta-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 110%,rgba(192,24,30,.1),transparent 60%)}
.cta-band::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.cta-inner{position:relative;z-index:1;max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px);display:grid;grid-template-columns:1fr auto;gap:clamp(24px,4vw,56px);align-items:center}
.cta-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;color:#ff7070;text-transform:uppercase;margin-bottom:12px}
.cta-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:10px}
.cta-headline .accent{color:var(--crimson-l)}
.cta-sub{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.65;max-width:560px}
.cta-actions{display:flex;flex-direction:column;gap:12px;align-items:flex-end}

/* FOOTER */
footer{background:var(--black);border-top:1px solid rgba(51,96,184,.14);padding:clamp(44px,6vh,60px) 0 26px}
.footer-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.footer-top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:clamp(24px,4vw,56px);margin-bottom:40px}
.footer-logo-wrap{display:flex;align-items:center;gap:11px;margin-bottom:9px}
.footer-logo-img{height:38px;width:auto}
.footer-logo-name{font-family:var(--font-head);font-weight:800;font-size:19px;letter-spacing:.1em;text-transform:uppercase;color:var(--white)}
.footer-tagline{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:#ff7070;text-transform:uppercase;margin-bottom:13px}
.footer-desc{font-size:14px;font-weight:300;color:#9098ac;line-height:1.75;max-width:260px}
.footer-heading{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#ff7070;margin-bottom:16px}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:8px}
.footer-links a{font-size:14px;color:#a0a8bc;text-decoration:none;transition:color .2s;font-weight:400}
.footer-links a:hover{color:var(--chrome)}
.footer-contact-item{display:flex;flex-direction:column;gap:2px;margin-bottom:11px}
.footer-contact-item .label{font-family:var(--font-mono);font-size:10px;letter-spacing:.15em;color:#5580cc;text-transform:uppercase}
.footer-contact-item .value{font-size:14px;color:#c0c8d8;font-weight:400}
.footer-bottom{border-top:1px solid rgba(51,96,184,.1);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.footer-copy{font-size:13px;color:#7a8499;font-weight:300}
.footer-copy a{color:var(--teal-l);text-decoration:none}
.footer-legal{display:flex;gap:16px;flex-wrap:wrap}
.footer-legal a{font-size:13px;color:#7a8499;text-decoration:none;transition:color .2s}
.footer-legal a:hover{color:var(--fog)}

/* RESPONSIVE */
@media(max-width:1024px){
  .ind-card-large{grid-template-columns:1fr}
  .ind-card-large.reverse{direction:ltr}
  .ind-img{min-height:240px}
  .ind-img::after,.ind-card-large.reverse .ind-img::after{background:linear-gradient(180deg,transparent 40%,rgba(10,12,18,.9) 100%)}
  .cross-grid{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr 1fr;gap:28px}
  .cta-inner{grid-template-columns:1fr}
  .cta-actions{align-items:flex-start;flex-direction:row}
}
@media(max-width:768px){
  .target-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
  .target-grid{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr}
  .cta-actions{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  .reveal{opacity:1;transform:none}
}
</style>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="breadcrumb"><a href="/">Home</a><span class="sep">/</span><span class="current">Industries</span></div>
    <div class="page-eyebrow"><div class="page-eyebrow-line"></div><span>Markets We Serve</span></div>
    <h1 class="page-title">Decades of<br><span class="accent">Process</span> <span class="chrome">Depth</span></h1>
    <p class="page-sub">The Jayveecons Group has built domain knowledge across five industrial sectors — each with its own material characteristics, operating conditions, and engineering demands. That breadth of cross-sector experience is what makes our solutions better, not just broader.</p>
  </div>
</div>

<!-- STAT BAR -->
<div class="stat-bar">
  <div class="stat-bar-inner">
    <div class="stat-item reveal"><div class="stat-num">5<span class="u">+</span></div><div class="stat-label">Active Industries</div><div class="stat-detail">Cement · Mining &amp; Ore Processing · Food · Waste · Steel</div></div>
    <div class="stat-item reveal"><div class="stat-num">3</div><div class="stat-label">Sectors We Are Growing Into</div><div class="stat-detail">Oil &amp; Gas · Pharmaceuticals · Agriculture Processing</div></div>
    <div class="stat-item reveal"><div class="stat-num" id="ind-years">39<span class="u">+</span></div><div class="stat-label">Years of Domain Experience</div><div class="stat-detail">Cross-sector bulk material expertise since 1987</div></div>
    <div class="stat-item reveal"><div class="stat-num">4</div><div class="stat-label">Product Lines</div><div class="stat-detail">Handling · Processing · Ancillary · Parts</div></div>
  </div>
</div>

<!-- ACTIVE SECTORS -->
<section class="active-sectors" id="active">
  <div class="section-inner">
    <div class="section-tag reveal"><div class="line"></div><span>Currently Serving</span></div>
    <h2 class="section-headline reveal">Active Industries</h2>

    <!-- CEMENT -->
    <div class="ind-card-large reveal" id="cement">
      <div class="ind-img">
        <img src="images/cement_plant.jpeg" alt="Cement Plant" loading="lazy">
      </div>
      <div class="ind-body">
        <div class="ind-status"><div class="ind-status-dot"></div><span>Active — Core Sector</span></div>
        <div class="ind-name">Cement</div>
        <p class="ind-desc">Cement is Jayveecons' founding industry — we were established in 1987 specifically to serve small-scale cement plants using Vertical Shaft Kiln technology. Nearly four decades later, cement remains our deepest area of expertise, spanning VSK systems, kilns and kiln components, raw material handling, clinker processing, and finished cement packaging and storage. We understand the full cement process chain from quarry to despatch silo.</p>
        <div class="ind-products-title">VECTOMEC™ Equipment for Cement</div>
        <div class="ind-products">
          <span class="ind-product-tag">VSK — Complete System</span>
          <span class="ind-product-tag">Kiln Components</span>
          <span class="ind-product-tag">Crushers</span>
          <span class="ind-product-tag">Nodulizer</span>
          <span class="ind-product-tag">Grinding Mills</span>
          <span class="ind-product-tag">Screw Conveyors</span>
          <span class="ind-product-tag">Bucket Elevators</span>
          <span class="ind-product-tag">Classifiers</span>
          <span class="ind-product-tag">Air Slides</span>
          <span class="ind-product-tag">Dust Collectors</span>
          <span class="ind-product-tag">Storage Silos</span>
        </div>
        <a href="/contact?industry=cement" class="ind-cta">Discuss your cement project <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>

    <!-- MINING -->
    <div class="ind-card-large reverse reveal" id="mining">
      <div class="ind-img">
        <img src="images/Mining.jpg" alt="Mining Industry" style="height: 770px" loading="lazy">
      </div>
      <div class="ind-body">
        <div class="ind-status"><div class="ind-status-dot"></div><span>Active</span></div>
        <div class="ind-name">Mining, Ore<br>Processing &amp;<br>Aggregates</div>
        <p class="ind-desc">While the mining and materials industry is vast, Jayveecons focuses on three distinct engineering challenges, addressing each with specialized equipment. Run-of-mine extraction and aggregates production demand heavy-duty conveying, primary and secondary crushing, and scalping screens that can handle large, irregular, abrasive feed. Ore processing — particularly for limestone, bauxite, iron ore, and mineral sands — adds classification, grinding, and thermal treatment steps where precise particle size control is critical. Finished aggregate handling requires high-throughput belt conveyors, elevated stockpile systems, and efficient load-out infrastructure. Jayveecons has engineered equipment for all three phases, and we understand that each has different wear rates, duty cycles, and maintenance access requirements.</p>
        <div class="ind-products-title">VECTOMEC™ Equipment for Mining &amp; Ore Processing</div>
        <div class="ind-products">
          <span class="ind-product-tag">Crusher — Primary &amp; Secondary</span>
          <span class="ind-product-tag">Vibrating Screen</span>
          <span class="ind-product-tag">Belt Conveyor — Heavy Duty</span>
          <span class="ind-product-tag">Bucket Elevator — Chain Type</span>
          <span class="ind-product-tag">Ball Mill — Ore Grinding</span>
          <span class="ind-product-tag">Classifier</span>
          <span class="ind-product-tag">Hopper &amp; Bins</span>
          <span class="ind-product-tag">AR Wear Parts &amp; Liners</span>
          <span class="ind-product-tag">Industrial Dryer</span>
        </div>
        <a href="/contact?industry=mining" class="ind-cta">Discuss your mining project <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>

    <!-- FOOD & AGRI -->
    <div class="ind-card-large reveal" id="food">
      <div class="ind-img">
        <img src="images/food-processing.jpg" alt="Food and Agriculture Industry" loading="lazy">
      </div>
      <div class="ind-body">
        <div class="ind-status"><div class="ind-status-dot"></div><span>Active</span></div>
        <div class="ind-name">Food &amp;<br>Agriculture</div>
        <p class="ind-desc">Food processing demands handling systems that are hygienic, gentle on product, and constructed to food-safety standards. Jayveecons supplies stainless steel screw conveyors, bucket elevators, and storage systems for grain, pulses, spices, sugar, and processed food operations. All food-grade equipment is designed with full-flush cleanability, food-approved materials, and smooth internal surfaces that meet applicable hygiene codes.</p>
        <div class="ind-products-title">VECTOMEC™ Equipment for Food &amp; Agri</div>
        <div class="ind-products">
          <span class="ind-product-tag">Screw Conveyor — SS</span>
          <span class="ind-product-tag">Bucket Elevator — Food Grade</span>
          <span class="ind-product-tag">Belt Conveyor</span>
          <span class="ind-product-tag">Vibrating Screen</span>
          <span class="ind-product-tag">Feeder</span>
          <span class="ind-product-tag">Silo &amp; Storage</span>
          <span class="ind-product-tag">Industrial Dryer</span>
        </div>

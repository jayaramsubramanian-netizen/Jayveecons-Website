---
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = "Industries Served — Jayveecons VECTOMEC™ Bulk Material Handling Equipment";
const seoDesc  = "Jayveecons supplies VECTOMEC™ material handling and processing equipment to cement, mining, food & agriculture, waste management, steel, fertilizer, and ceramics industries. Bengaluru, India. Est. 1987.";
const seoKeywords = "bulk material handling equipment, cement plant equipment India, VSK vertical shaft kiln, screw conveyor manufacturer India, bucket elevator manufacturer, ball mill supplier, belt conveyor India, mining equipment India, food grade conveyor India, waste management equipment, industrial dryer, vibrating screen, rotary kiln components, Jayveecons, VECTOMEC, Bengaluru, Karnataka";
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  currentPath="/industries"
>

<!-- ═══════════════════════════════════════════
     HEAD SEO — injected via slot or BaseLayout
     (add these to your BaseLayout <head> if not
     already reading title/description props)
════════════════════════════════════════════ -->
<!-- Structured data: Organization + breadcrumb -->
<script type="application/ld+json" is:inline>{JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://jayveecons.com/#org",
      "name": "Jayveecons Group",
      "url": "https://jayveecons.com",
      "foundingDate": "1987",
      "description": "Manufacturer of VECTOMEC™ bulk material handling and processing equipment for cement, mining, food, waste, and steel industries.",
      "address": { "@type": "PostalAddress", "addressLocality": "Malur", "addressRegion": "Karnataka", "addressCountry": "IN" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jayveecons.com" },
        { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://jayveecons.com/industries" }
      ]
    },
    {
      "@type": "WebPage",
      "name": seoTitle,
      "description": seoDesc,
      "keywords": seoKeywords,
      "url": "https://jayveecons.com/industries",
      "inLanguage": "en-IN",
      "isPartOf": { "@id": "https://jayveecons.com/#org" }
    }
  ]
})}</script>

<style>
/* ═══ KEYFRAMES ═══ */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ═══ LASER BORDER ANIMATION ═══ */
@keyframes laser-h {
  0%   { width: 0;   opacity: 1; }
  55%  { width: 55%; opacity: 1; }
  85%  { width: 55%; opacity: .4; }
  100% { width: 0;   opacity: 0; }
}
@keyframes laser-v {
  0%   { height: 0;   opacity: 1; }
  55%  { height: 55%; opacity: 1; }
  85%  { height: 55%; opacity: .4; }
  100% { height: 0;   opacity: 0; }
}
@keyframes laser-h-rev {
  0%   { width: 0;   opacity: 1; }
  55%  { width: 55%; opacity: 1; }
  85%  { width: 55%; opacity: .4; }
  100% { width: 0;   opacity: 0; }
}

.ind-block::before,
.ind-block::after {
  content: '';
  position: absolute;
  z-index: 10;
  pointer-events: none;
  background: #e02428;
}
/* Horizontal beam — shoots right from top-left corner */
.ind-block::before {
  top: 0; left: 0;
  height: 2px; width: 0;
  box-shadow: 0 0 10px 2px rgba(192,24,30,.65), 0 0 24px 4px rgba(192,24,30,.3);
  animation: laser-h 1.4s cubic-bezier(.4,0,.2,1) 0.3s both;
}
/* Vertical beam — shoots down from top-left corner */
.ind-block::after {
  top: 0; left: 0;
  width: 2px; height: 0;
  box-shadow: 2px 0 10px 2px rgba(192,24,30,.65), 4px 0 24px 4px rgba(192,24,30,.3);
  animation: laser-v 1.4s cubic-bezier(.4,0,.2,1) 0.3s both;
}
/* Reverse cards: laser shoots from top-right corner */
.ind-block.reverse::before {
  left: auto; right: 0;
  animation: laser-h-rev 1.4s cubic-bezier(.4,0,.2,1) 0.3s both;
}
.ind-block.reverse::after {
  left: auto; right: 0;
  box-shadow: -2px 0 10px 2px rgba(192,24,30,.65), -4px 0 24px 4px rgba(192,24,30,.3);
}
/* Re-trigger on hover */
.ind-block:hover::before,
.ind-block:hover::after {
  animation-play-state: running;
  animation-iteration-count: infinite;
  animation-delay: 0s;
}
/* Per-card load stagger */
#cement::before, #cement::after { animation-delay: 0.2s; }
#mining::before, #mining::after { animation-delay: 0.1s; }
#food::before,   #food::after   { animation-delay: 0.15s; }
#waste::before,  #waste::after  { animation-delay: 0.1s; }
#steel::before,  #steel::after  { animation-delay: 0.15s; }

/* ═══ PAGE HEADER ═══ */
.page-header{position:relative;padding:130px 0 72px;overflow:hidden;background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 55%,var(--black) 100%)}
.page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 60% 50%,rgba(26,50,96,.6),transparent 65%)}
.page-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.page-header-inner{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:18px;font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.breadcrumb a{color:#7a8499;text-decoration:none;transition:color .2s}
.breadcrumb a:hover{color:var(--fog)}
.breadcrumb .sep{color:#3a4255}
.breadcrumb .current{color:#ff7070}
.page-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:14px;animation:fadeUp .7s ease .1s both}
.page-eyebrow-line{width:40px;height:2px;background: #e02428}
.page-eyebrow span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.page-title{font-family:var(--font-head);font-weight:800;font-size:clamp(44px,6.5vw,84px);text-transform:uppercase;line-height:.93;letter-spacing:-.01em;margin-bottom:16px;animation:fadeUp .7s ease .2s both}
.page-title .accent{color: #e02428}
.page-title .chrome{background:linear-gradient(135deg,var(--chrome-l),var(--chrome));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.page-sub{font-size:clamp(14px,1.7vw,17px);font-weight:300;color:var(--fog);max-width:640px;line-height:1.75;animation:fadeUp .7s ease .3s both}

/* ═══ COMMON ═══ */
section{position:relative;z-index:1}
.section-inner{max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.section-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:12px}
.section-tag .line{width:28px;height:2px;background: #e02428}
.section-tag span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background: #e02428;color:var(--white);font-family:var(--font-head);font-weight:700;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:13px 30px;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:background .2s,transform .2s;white-space:nowrap}
.btn-primary:hover{background: #e02428;transform:translateX(2px)}
.btn-secondary{display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--chrome);font-family:var(--font-head);font-weight:600;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:12px 30px;border:1px solid rgba(208,212,220,.2);transition:color .2s,border-color .2s;white-space:nowrap}
.btn-secondary:hover{color:var(--white);border-color:rgba(208,212,220,.5)}

/* ═══ STAT BAR ═══ */
.stat-bar{padding:clamp(32px,5vh,52px) 0;background:var(--navy-deep);border-bottom:1px solid rgba(51,96,184,.15)}
.stat-bar-inner{max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px);display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
.stat-item{background:rgba(10,12,18,.6);padding:clamp(18px,2.5vw,28px);border-top:2px solid transparent;transition:border-top-color .3s}
.stat-item:hover{border-top-color: #e02428}
.stat-num{font-family:var(--font-head);font-weight:800;font-size:clamp(36px,5vw,52px);line-height:1;color:var(--white);letter-spacing:-.02em}
.stat-num .u{font-size:.5em;color:#ff7070}
.stat-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7a8aaa;margin-top:5px;margin-bottom:4px}
.stat-detail{font-size:12px;font-weight:300;color:#8898b0;line-height:1.5}

/* ═══ CEMENT FLAGSHIP OVERRIDES ═══ */
.ind-cement-flagship{position:relative}
.ind-cement-flagship .ind-copy{
  background:linear-gradient(160deg,var(--ink-3) 0%,rgba(13,26,58,.5) 100%);
}
.ind-desc-em{
  font-family:var(--font-mono);font-size:11px;letter-spacing:.18em;
  text-transform:uppercase;color:#ff7070;
  margin-bottom:12px;margin-top:-6px;
}
.cement-stats{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:1px;margin-bottom:18px;
  background:rgba(51,96,184,.1);
}
.cement-stat{
  background:rgba(10,12,18,.7);
  padding:12px 10px;
  display:flex;flex-direction:column;align-items:center;
  text-align:center;gap:5px;
  transition:background .25s;
}
.cement-stat:hover{background:rgba(13,26,58,.7)}
.cement-stat svg{width:18px;height:18px;color:#ff7070;opacity:.8}
.cement-stat-num{
  font-family:var(--font-head);font-weight:800;
  font-size:clamp(15px,1.6vw,19px);
  color:var(--white);line-height:1;letter-spacing:.04em;
}
.cement-stat-label{
  font-family:var(--font-mono);font-size:8px;letter-spacing:.09em;
  text-transform:uppercase;color:#7a8aaa;line-height:1.4;
}
@media(max-width:768px){.cement-stats{grid-template-columns:repeat(2,1fr)}}

.active-sectors{
  padding:clamp(48px,7vh,80px) 0;
  background:var(--ink-2);
}
.active-sectors .section-inner{padding-bottom:clamp(16px,3vh,32px)}

/* Outer wrapper */
.ind-blocks-wrap{
  max-width:1440px;
  margin:0 auto;
  padding:0 clamp(18px,4vw,48px);
  display:flex;
  flex-direction:column;
  gap:24px;
}

/* ── Industry block ── */
.ind-block{
  display:grid;
  grid-template-columns:38fr 62fr;
  height:560px;
  overflow:hidden;
  position:relative;
}
.ind-block.reverse{grid-template-columns:62fr 38fr}
.ind-block.reverse .ind-copy{order:2}
.ind-block.reverse .ind-visual{order:1}

/* ── Copy panel — NO static border ── */
.ind-copy{
  background:var(--ink-3);
  border-left:none;
  padding:32px 36px;
  display:flex;flex-direction:column;justify-content:flex-start;
  position:relative;
  overflow-y:auto;
  scrollbar-width:thin;
  scrollbar-color:rgba(192,24,30,.3) transparent;
}
.ind-copy::-webkit-scrollbar{width:3px}
.ind-copy::-webkit-scrollbar-thumb{background:rgba(192,24,30,.3);border-radius:2px}
.ind-block.reverse .ind-copy{border-left:none;border-right:none}

/* Watermark number */
.ind-copy::before{
  content:attr(data-num);
  position:absolute;bottom:-20px;right:-10px;
  font-family:var(--font-head);font-weight:800;
  font-size:180px;line-height:1;
  color:rgba(51,96,184,.05);
  pointer-events:none;user-select:none;
}

.ind-sector-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:10px;flex-shrink:0}
.ind-sector-line{width:28px;height:2px;background: #e02428}
.ind-sector-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}

.ind-status{display:inline-flex;align-items:center;gap:8px;margin-bottom:8px;flex-shrink:0}
.ind-status-dot{width:7px;height:7px;border-radius:50%;background: #e02428;flex-shrink:0;box-shadow:0 0 6px #e02428}
.ind-status span{font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#ff7070}

.ind-headline{
  font-family:var(--font-head);font-weight:800;
  font-size:clamp(20px,2.2vw,30px);
  text-transform:uppercase;line-height:.97;letter-spacing:-.01em;
  color:var(--white);margin-bottom:12px;flex-shrink:0;
}
.ind-headline .sub-hl{display:block;color:var(--chrome-l)}

.ind-desc{font-size:13px;font-weight:300;color:var(--fog);line-height:1.75;margin-bottom:10px}

/* Sub-sectors icon row */
.ind-subsectors{
  display:flex;align-items:flex-start;gap:0;
  margin-bottom:12px;flex-shrink:0;
  border-top:1px solid rgba(51,96,184,.12);
  border-bottom:1px solid rgba(51,96,184,.12);
  padding:8px 0;
}
.ind-sub{
  display:flex;flex-direction:column;align-items:center;gap:4px;
  flex:1;padding:3px 4px;
  border-right:1px solid rgba(51,96,184,.12);
}
.ind-sub:last-child{border-right:none}
.ind-sub svg{width:18px;height:18px;color:#7ab0ff;opacity:.8}
.ind-sub-label{font-family:var(--font-mono);font-size:8px;letter-spacing:.09em;text-transform:uppercase;color:#7a8aaa;text-align:center;line-height:1.3}

/* Trust badge */
.ind-trust{
  display:flex;align-items:flex-start;gap:10px;flex-shrink:0;
  background:rgba(13,26,58,.7);border:1px solid rgba(51,96,184,.2);
  border-left:3px solid #e02428;
  padding:9px 12px;margin-bottom:12px;
}
.ind-trust svg{width:16px;height:16px;color: #e02428;flex-shrink:0;margin-top:1px}
.ind-trust-text{font-family:var(--font-mono);font-size:9px;letter-spacing:.09em;text-transform:uppercase;color:#a0b8d8;line-height:1.5}

.ind-products-title{font-family:var(--font-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#ff7070;margin-bottom:6px;flex-shrink:0}
.ind-products{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px}
.ind-product-tag{font-family:var(--font-mono);font-size:8px;letter-spacing:.07em;text-transform:uppercase;background:rgba(13,26,58,.8);border:1px solid rgba(51,96,184,.25);color:#7ab0ff;padding:2px 7px}

.ind-cta{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  color: #e02428;text-decoration:none;transition:color .2s;
  margin-top:auto;flex-shrink:0;padding-top:8px;
}
.ind-cta:hover{color:var(--white)}
.ind-cta svg{width:12px;height:12px}

/* ── Visual panel: fills block height, image covers completely ── */
.ind-visual{
  position:relative;
  overflow:hidden;
  background:var(--navy-deep);
  height:100%;
  align-self:stretch;
}
.ind-visual img{
  position:absolute;
  top:0;left:0;
  width:100%;height:100%;
  object-fit:cover;
  object-position:center center;
  display:block;
  transition:transform .7s ease,filter .4s;
  filter:saturate(1.05) contrast(1.05);
}
.ind-block:hover .ind-visual img{transform:scale(1.03)}

.ind-visual::after{
  content:'';position:absolute;inset:0;z-index:1;
  background:linear-gradient(270deg,transparent 55%,rgba(10,12,18,.45) 100%);
  pointer-events:none;
}
.ind-block.reverse .ind-visual::after{
  background:linear-gradient(90deg,transparent 55%,rgba(10,12,18,.45) 100%);
}

/* ═══ EXPANDING SECTORS ═══ */
.target-sectors{padding:clamp(56px,8vh,96px) 0;background:var(--ink)}
.target-intro{max-width:800px;margin-bottom:clamp(32px,4vh,52px)}
.target-intro p{font-size:clamp(15px,1.6vw,17px);font-weight:300;color:var(--fog);line-height:1.8;margin-top:16px}
.target-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.target-card{background:var(--ink-2);padding:clamp(24px,3vw,36px);border-top:2px solid var(--teal-l);position:relative;overflow:hidden;transition:background .3s}
.target-card:hover{background:rgba(13,122,110,.06)}
.target-card::before{content:'';position:absolute;top:0;right:0;width:60px;height:60px;background:radial-gradient(circle at top right,rgba(20,168,152,.08),transparent 70%);pointer-events:none}
.tc-icon{width:40px;height:40px;color:var(--teal-l);margin-bottom:18px;opacity:.85}
.tc-name{font-family:var(--font-head);font-weight:700;font-size:clamp(20px,2.5vw,26px);text-transform:uppercase;letter-spacing:.04em;color:var(--white);margin-bottom:8px}
.tc-status{font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;background:rgba(20,168,152,.12);color:var(--teal-l);padding:3px 8px;display:inline-block;margin-bottom:14px}
.tc-desc{font-size:clamp(13px,1.4vw,14px);font-weight:300;color:#9098b0;line-height:1.7;margin-bottom:16px}
.tc-opportunity{font-size:12px;font-weight:300;color:#7a8aaa;line-height:1.6;border-top:1px solid rgba(20,168,152,.1);padding-top:14px;margin-top:4px}
.tc-opportunity strong{color:var(--teal-l);font-weight:500}

/* ═══ CROSS-SECTOR ═══ */
.cross-sector{padding:clamp(56px,8vh,96px) 0;background:var(--navy-deep)}
.cross-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,5vw,80px);align-items:center}
.cross-copy p{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.8;margin-bottom:16px}
.cross-copy p strong{color:var(--white);font-weight:500}
.cross-points{display:flex;flex-direction:column;gap:2px}
.cross-point{background:rgba(10,12,18,.7);padding:clamp(16px,2vw,22px);display:flex;gap:16px;align-items:flex-start;border-left:3px solid transparent;transition:border-left-color .25s,background .25s}
.cross-point:hover{background:rgba(13,26,58,.5);border-left-color: #e02428}
.cp-icon{width:36px;height:36px;background:rgba(192,24,30,.12);border:1px solid rgba(192,24,30,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;color: #e02428}
.cp-icon svg{width:18px;height:18px}
.cp-title{font-family:var(--font-head);font-weight:700;font-size:16px;text-transform:uppercase;letter-spacing:.05em;color:var(--chrome);margin-bottom:4px}
.cp-desc{font-size:13px;font-weight:300;color:#8898b0;line-height:1.6}

/* ═══ CTA BAND ═══ */
.cta-band{padding:clamp(64px,9vh,104px) 0;background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 60%);position:relative;overflow:hidden}
.cta-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 110%,rgba(192,24,30,.1),transparent 60%)}
.cta-band::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.cta-inner{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px);display:grid;grid-template-columns:1fr auto;gap:clamp(24px,4vw,56px);align-items:center}
.cta-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;color:#ff7070;text-transform:uppercase;margin-bottom:12px}
.cta-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:10px}
.cta-headline .accent{color: #e02428}
.cta-sub{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.65;max-width:560px}
.cta-actions{display:flex;flex-direction:column;gap:12px;align-items:flex-end}

/* ═══ RESPONSIVE ═══ */

/* 1440px */
@media(max-width:1440px){
  .ind-block{height:520px}
  .ind-copy{padding:28px 30px}
}

/* 1024px — stack to single column */
@media(max-width:1024px){
  .ind-blocks-wrap{padding:0 clamp(18px,4vw,32px);gap:20px}

  .ind-block,
  .ind-block.reverse{
    grid-template-columns:1fr;
    grid-template-rows:300px auto;
    height:auto;
  }

  .ind-block .ind-visual{order:1;height:300px}
  .ind-block .ind-copy{order:2}
  .ind-block.reverse .ind-visual{order:1;height:300px}
  .ind-block.reverse .ind-copy{
    order:2;
    border-right:none;
    border-left:none;
  }

  .ind-visual img{
    position:absolute;
    top:0;left:0;
    width:100%;height:100%;
    object-fit:cover;object-position:center center;
  }

  .ind-visual::after,
  .ind-block.reverse .ind-visual::after{
    background:linear-gradient(180deg,transparent 40%,rgba(10,12,18,.7) 100%);
  }

  .ind-copy{padding:28px 28px 32px;overflow-y:visible}
  .ind-headline{font-size:clamp(22px,3.5vw,36px)}

  .cross-grid{grid-template-columns:1fr}
  .cta-inner{grid-template-columns:1fr}
  .cta-actions{align-items:flex-start;flex-direction:row}
}

/* 768px */
@media(max-width:768px){
  .ind-blocks-wrap{padding:0 16px;gap:16px}
  .ind-block,
  .ind-block.reverse{grid-template-rows:260px auto}
  .ind-visual,
  .ind-block.reverse .ind-visual{height:260px}
  .ind-copy{padding:22px 20px 28px}
  .ind-headline{font-size:clamp(20px,5vw,28px)}
  .stat-bar-inner{grid-template-columns:1fr 1fr}
  .target-grid{grid-template-columns:1fr 1fr}
  .ind-subsectors{flex-wrap:wrap}
  .ind-sub{min-width:calc(50% - 1px);padding:6px 4px}
  .footer-top{grid-template-columns:1fr 1fr;gap:28px}
}

/* 520px */
@media(max-width:520px){
  .ind-blocks-wrap{padding:0 12px;gap:12px}
  .ind-block,
  .ind-block.reverse{grid-template-rows:220px auto}
  .ind-visual,
  .ind-block.reverse .ind-visual{height:220px}
  .ind-copy{padding:18px 16px 24px}
  .stat-bar-inner{grid-template-columns:1fr}
  .target-grid{grid-template-columns:1fr}
  .cta-actions{flex-direction:column}
  .footer-top{grid-template-columns:1fr}
  .cement-stats{grid-template-columns:repeat(2,1fr)}
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  .reveal{opacity:1;transform:none}
}

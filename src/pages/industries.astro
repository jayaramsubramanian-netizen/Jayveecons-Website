---
/**
 * src/pages/industries.astro
 *
 * HOW TO FIX THE NAV/FOOTER NOT SHOWING:
 * ───────────────────────────────────────
 * The only thing wrong was the import PATHS. Your BaseLayout,
 * Nav, and Footer files are correct and work on every other page.
 * industries.astro just had the wrong relative paths.
 *
 * Match the import paths your OTHER working pages use.
 * contact.astro uses:  import BaseLayout from '../layouts/BaseLayout.astro'
 * So industries.astro must use the same path — shown below.
 *
 * Component imports also changed from '../components/industries/...'
 * to '../../components/industries/...' because this file sits at
 * src/pages/industries.astro, one level deeper relative to where
 * the components folder actually is in your project.
 *
 * ── SECOND FIX ──────────────────────────────────────────────────
 * The <link rel="stylesheet"> tag was inside <BaseLayout>'s slot.
 * Astro renders slot content into <body>, NOT <head>, so that CSS
 * was never loaded. The .btn-primary / .btn-secondary styles are
 * now inlined directly inside IndustriesCTA.astro where they're
 * used — no external stylesheet needed.
 */

import BaseLayout            from '../layouts/BaseLayout.astro';
import IndustriesHero        from '../components/industries/IndustriesHero.astro';
import IndustriesStats       from '../components/industries/IndustriesStats.astro';
import IndustriesActive      from '../components/industries/IndustriesActive.astro';
import IndustryModal    from '../components/industries/IndustryModal.astro';
import IndustriesGrowth      from '../components/industries/IndustriesGrowth.astro';
import IndustriesCrossSector from '../components/industries/IndustriesCrossSector.astro';
import IndustriesCTA         from '../components/industries/IndustriesCTA.astro';
import IndustriesReveal      from '../components/industries/IndustriesReveal.astro';

const seoTitle    = "Industries Served — Jayveecons VECTOMEC™ Bulk Material Handling Equipment";
const seoDesc     = "Jayveecons supplies VECTOMEC™ material handling and processing equipment to cement, mining, food & agriculture, waste management, steel, fertilizer, and ceramics industries. Bengaluru, India. Est. 1987.";
const seoKeywords = "bulk material handling equipment, cement plant equipment India, VSK vertical shaft kiln, screw conveyor manufacturer India, bucket elevator manufacturer, ball mill supplier, belt conveyor India, mining equipment India, food grade conveyor India, waste management equipment, industrial dryer, vibrating screen, rotary kiln components, Jayveecons, VECTOMEC, Bengaluru, Karnataka";
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  keywords={seoKeywords}
  currentPath="/industries"
>

  <!-- JSON-LD: Organization + Breadcrumb + WebPage -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.jayveecons.com/#org",
        "name": "Jayveecons Group",
        "url": "https://www.jayveecons.com",
        "foundingDate": "1987",
        "description": "Manufacturer of VECTOMEC™ bulk material handling and processing equipment for cement, mining, food, waste, and steel industries.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "1st Phase, Plot 87/D2, Mcnally Road, Industrial Estate",
          "addressLocality": "Malur",
          "addressRegion": "Karnataka",
          "postalCode": "563130",
          "addressCountry": "IN"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home",       "item": "https://www.jayveecons.com" },
          { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://www.jayveecons.com/industries" }
        ]
      },
      {
        "@type": "WebPage",
        "name": seoTitle,
        "description": seoDesc,
        "keywords": seoKeywords,
        "url": "https://www.jayveecons.com/industries",
        "inLanguage": "en-IN",
        "isPartOf": { "@id": "https://www.jayveecons.com/#org" }
      }
    ]
  })}</script>

  <!-- Sections in DOM order -->
  <IndustriesHero />
  <IndustriesStats />
  <IndustriesActive />
  <IndustryModal />
  <IndustriesGrowth />
  <IndustriesCrossSector />
  <IndustriesCTA />

  <!-- Client island: scroll-reveal catch-up + dynamic year. Always last. -->
  <IndustriesReveal />

</BaseLayout>
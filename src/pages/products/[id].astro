---
// src/pages/products/[id].astro — individual product page
// Hero matches site hero style: text left · image right · gradient fade
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
import type { Product } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = products.find(p => p.id === id)!;

const related = products
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const categoryLabel: Record<string, string> = {
  handling:    'Material Handling',
  processing:  'Material Processing',
  ancillary:   'Ancillary Equipment',
  accessories: 'Accessories & Parts',
};
const catLabel = categoryLabel[product.category] ?? product.category;

// Split product name into two parts for white/crimson heading
// e.g. "Screw Conveyor" → ["Screw", "Conveyor"]
const nameParts = product.name.split(' ');
const nameFirst = nameParts.slice(0, Math.ceil(nameParts.length / 2)).join(' ');
const nameLast  = nameParts.slice(Math.ceil(nameParts.length / 2)).join(' ');
---

<BaseLayout
  title={`${product.name} — ${product.series} | Jayveecons Group`}
  description={product.shortDesc}
  currentPath="/products"
>

  <!-- ══ HERO — section clears fixed nav via inline margin-top ══ -->
  <!-- Spacer: pushes content below the 70px fixed nav. Physical height cannot be overridden. -->
  <div style="height:70px;"></div>
  <section class="ph-section">

    <!-- LEFT — dark navy, text content -->
    <div class="ph-left">

      
 <div class="ph-copy">
        <!-- Breadcrumb links — plain text, sits above eyebrow -->
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:12px;">
          <a href="/" style="font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;">Home</a>
          <span style="color:rgba(255,255,255,.25);">›</span>
          <a href="/products" style="font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;">Products</a>
          <span style="color:rgba(255,255,255,.25);">›</span>
          <a href={`/products#${product.category}-section`} style="font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;">{catLabel}</a>
          <span style="color:rgba(255,255,255,.25);">›</span>
          <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#c0181e;">{product.name}</span>
        </div>

        <!-- Eyebrow -->
        <div class="ph-eyebrow">
      
          <div class="ph-eyebrow-line" aria-hidden="true"></div>
          <span>{product.series} · {catLabel}</span>
        </div>

        <!-- Heading — white + crimson split -->
        <h1 class="ph-title">
          {nameFirst}<br>
          {nameLast && <span class="ph-accent">{nameLast}</span>}
        </h1>

        <!-- Short desc — 1–2 sentences max -->
        <p class="ph-sub">{product.shortDesc}</p>

        <!-- CTAs -->
        <div class="ph-actions">
          <a href={`/contact?product=${product.id}`} class="ph-btn-primary">
            Request a Quote
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#ph-specs" class="ph-btn-secondary">
            Specifications ↓
          </a>
        </div>
      </div>

      <!-- Back link at bottom -->
      <a href="/products" class="ph-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Products
      </a>
    </div>

    <!-- RIGHT — product image -->
    <div class="ph-right">
      {product.image
        ? <img
            src={`/${product.image.replace(/^\//, '')}`}
            alt={product.name}
            class="ph-img"
            loading="eager"
            decoding="async"
          />
        : <div class="ph-img-placeholder">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="4" y="12" width="56" height="40" rx="3"/>
              <path d="M4 36l14-10 12 8 10-14 20 18"/>
              <circle cx="20" cy="24" r="4"/>
            </svg>
            <span>{product.series}</span>
          </div>
      }
      <!-- Gradient fade — left edge blends into the dark left panel -->
      <div class="ph-img-fade" aria-hidden="true"></div>
    </div>

  </section>

  <!-- ══ BODY — full description + specs + apps ══ -->
  <section class="ph-body-section" id="ph-specs">
    <div class="ph-body-inner">

      <!-- Full description -->
      <div class="ph-fulldesc">
        <div class="ph-section-head">About this Product</div>
        <p class="ph-fulldesc-text">{product.fullDesc}</p>
      </div>

      <div class="ph-body-grid">

        <!-- LEFT: Specs -->
        <div>
          <div class="ph-section-head">Typical Specifications</div>
          <table class="ph-spec-table">
            <tbody>
              {product.specs.map(s => (
                <tr>
                  <td class="spec-key">{s.key}</td>
                  <td class="spec-val">{s.val}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- RIGHT: Applications + CTAs -->
        <div>
          <div class="ph-section-head">Industries &amp; Applications</div>
          <div class="ph-apps-pills">
            {product.modalApps.map(app => (
              <span class="ph-app-pill">{app}</span>
            ))}
          </div>
          <div class="ph-cta-row">
            <a href={`/contact?product=${product.id}`} class="ph-btn-primary">
              Request a Quote
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/contact" class="ph-btn-secondary">Technical Enquiry</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ APPLICATION CONFIGURATIONS ══ -->
  {(product as any).configs?.length > 0 && (
    <section class="ph-configs-section">
      <div class="ph-body-inner">
        <div class="ph-section-head ph-section-head--light">Application Configurations</div>
        <div class="ph-configs-grid">
          {(product as any).configs.map((c: any) => (
            <div class="ph-config-card">
              <div class="config-name">{c.name}</div>
              <div class="config-desc">{c.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ VECTRIX PLATFORM ══ -->
  {(product as any).platform && (
    <section class="ph-platform-section">
      <div class="ph-body-inner">
        <div class="ph-platform-inner">
          <div class="ph-platform-badge">VECTRIX™ Design Platform</div>
          <p class="ph-platform-text" set:html={(product as any).platform}></p>
        </div>
      </div>
    </section>
  )}

  <!-- ══ RELATED PRODUCTS ══ -->
  {related.length > 0 && (
    <section class="ph-related-section">
      <div class="ph-body-inner">
        <div class="ph-section-head ph-section-head--light">More in {catLabel}</div>
        <div class="ph-related-grid">
          {related.map(r => (
            <a href={`/products/${r.id}`} class="ph-related-card">
              <div class="ph-related-img">
                {r.image
                  ? <img src={`/${r.image.replace(/^\//, '')}`} alt={r.name} loading="lazy"/>
                  : <div class="ph-related-placeholder">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                      </svg>
                    </div>
                }
                <span class="ph-related-series">{r.series}</span>
              </div>
              <div class="ph-related-body">
                <div class="ph-related-name">{r.name}</div>
                <div class="ph-related-desc">{r.shortDesc}</div>
                <span class="ph-related-cta">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ CLOSING CTA ══ -->
  <section class="ph-cta-band">
    <div class="ph-body-inner" style="text-align:center;">
      <p class="ph-cta-eyebrow">Ready to Move Forward?</p>
      <h2 class="ph-cta-headline">
        Get a Quote for<br>
        <span class="ph-cta-accent">{product.name}</span>
      </h2>
      <div class="ph-cta-actions">
        <a href={`/contact?product=${product.id}`} class="ph-btn-primary">Request a Quote →</a>
        <a href="/products" class="ph-btn-secondary">Browse All Products</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>

  /* ══════════════════════════════════════════════════════
     HERO — mobile first
     Mobile:  text block on top, image block below
     Desktop: text 55% left, image 45% right, gradient fade
  ══════════════════════════════════════════════════════ */
  .ph-section {
    display: flex;
    flex-direction: column;        /* mobile: stack */
    min-height: clamp(500px, 80vh, 760px);
  }
  @media (min-width: 860px) {
    .ph-section {
      flex-direction: row;         /* desktop: side by side */
      min-height: clamp(480px, 70vh, 680px);
    }
  }

  /* ── LEFT PANEL — dark navy, text ── */
  .ph-left {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(32px,5vh,56px) clamp(20px,4vw,64px);
    background:
      radial-gradient(ellipse 100% 60% at 0% 30%, rgba(140,180,255,.12) 0%, transparent 60%),
      linear-gradient(145deg, #0e2454 0%, #163060 55%, #1a3875 100%);
    /* Metallic sheen */
    box-shadow: inset 0 1px 0 rgba(180,210,255,.12);
    flex: 0 0 100%;                /* mobile: full width */
  }
  @media (min-width: 860px) {
    .ph-left {
      flex: 0 0 52%;               /* desktop: 52% of width */
    }
  }

  /* ── BREADCRUMB — inside left panel, top ── */
  .ph-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: clamp(20px,3vh,32px);
    /* No dark strip — sits cleanly on the dark navy left panel */
  }
  .ph-left .ph-bc-link {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .12em; text-transform: uppercase;
    color: rgba(255,255,255,.75);
    text-decoration: none;
    transition: color .2s;
  }
  .ph-left .ph-bc-link:hover { color: #ffffff; }
  .ph-left .ph-bc-sep { color: rgba(255,255,255,.35); font-size: 11px; }
  .ph-left .ph-bc-current {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .12em; text-transform: uppercase;
    color: #c0181e;
  }

  /* ── COPY BLOCK ── */
  .ph-copy { flex: 1; }

  .ph-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    margin-bottom: clamp(10px,1.5vh,16px);
  }
  .ph-eyebrow-line {
    width: 28px; height: 2px;
    background: #c0181e; flex-shrink: 0;
  }
  .ph-eyebrow span {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
    color: #ff7070;
  }

  /* Heading — white with crimson second line */
  .ph-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: .95;
    letter-spacing: .01em;
    color: #ffffff;
    margin-bottom: clamp(12px,2vh,20px);
  }
  .ph-accent { color: #c0181e; }

  /* Short description */
  .ph-sub {
    font-family: var(--font-body);
    font-size: clamp(14px,1.5vw,16px);
    font-weight: 300;
    color: #e2ecf8;
    line-height: 1.75;
    max-width: 480px;
    margin-bottom: clamp(20px,3vh,32px);
  }

  /* Hero action buttons */
  .ph-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: clamp(20px,3vh,32px); }

  /* Back link pinned to bottom of left panel */
  .ph-back {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.4); text-decoration: none;
    margin-top: auto;
    transition: color .2s;
    padding-top: 12px;
  }
  .ph-back:hover { color: rgba(255,255,255,.85); }

  /* ── RIGHT PANEL — product image ── */
  .ph-right {
    position: relative;
    overflow: hidden;
    min-height: 260px;             /* mobile: fixed height */
    flex: 1;
    background: #0e2454;           /* fallback when no image */
  }
  @media (min-width: 860px) {
    .ph-right { min-height: unset; }
  }

  .ph-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .ph-img-placeholder {
    width: 100%; height: 100%;
    min-height: 260px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px;
    background:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 40px 40px;
    background-color: #0e2454;
  }
  .ph-img-placeholder svg { width: 56px; height: 56px; color: rgba(255,255,255,.15); }
  .ph-img-placeholder span {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase;
    color: rgba(255,255,255,.25);
  }

  /* Gradient fade — left edge of image bleeds into left dark panel */
  .ph-img-fade {
    position: absolute; inset: 0;
    background: linear-gradient(
      to right,
      #163060 0%,
      rgba(22,48,96,.92) 15%,
      rgba(22,48,96,.55) 38%,
      rgba(22,48,96,.18) 60%,
      transparent 82%
    );
    pointer-events: none;
  }
  @media (max-width: 859px) {
    /* On mobile, fade from top instead */
    .ph-img-fade {
      background: linear-gradient(
        to bottom,
        #163060 0%,
        rgba(22,48,96,.7) 25%,
        transparent 60%
      );
    }
  }

  /* ══ SHARED INNER CONTAINER ══ */
  .ph-body-inner {
    max-width: 1440px; margin-inline: auto;
    padding-inline: clamp(16px,4vw,48px);
  }

  /* ══ SECTION HEADINGS ══ */
  .ph-section-head {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
    color: #c0181e;
    padding-bottom: 10px;
    border-bottom: 2px solid rgba(192,24,30,.2);
    margin-bottom: 20px;
  }
  .ph-section-head--light {
    color: #ff7070;
    border-bottom-color: rgba(192,24,30,.3);
  }

  /* ══ BODY SECTION — white grid ══ */
  .ph-body-section {
    background-color: #f8fafc;
    background-image:
      linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    padding-block: clamp(48px,7vh,80px);
    border-bottom: 1px solid rgba(8,56,146,.07);
  }

  .ph-fulldesc { margin-bottom: clamp(32px,5vh,48px); }
  .ph-fulldesc-text {
    font-family: var(--font-body);
    font-size: clamp(14px,1.5vw,16px);
    font-weight: 300; color: #2a3550;
    line-height: 1.8; max-width: 900px;
  }

  .ph-body-grid {
    display: grid; grid-template-columns: 1fr;
    gap: clamp(32px,5vw,64px); align-items: start;
  }
  @media (min-width: 768px) { .ph-body-grid { grid-template-columns: 1.2fr 1fr; } }

  /* Spec table */
  .ph-spec-table { width: 100%; border-collapse: collapse; }
  .ph-spec-table tr:nth-child(even) td { background: rgba(8,56,146,.03); }
  .ph-spec-table td { padding: 10px 12px; border-bottom: 1px solid rgba(8,56,146,.07); font-size: 14px; vertical-align: top; line-height: 1.5; }
  .ph-spec-table tr:last-child td { border-bottom: none; }
  .spec-key { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; color: #5a6a88; font-weight: 600; width: 40%; white-space: nowrap; padding-right: 16px; }
  .spec-val { font-family: var(--font-body); font-weight: 300; color: #2a3350; }

  /* App pills */
  .ph-apps-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .ph-app-pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .1em; text-transform: uppercase;
    background: rgba(8,56,146,.06); border: 1px solid rgba(8,56,146,.15);
    color: rgba(8,56,146,.8); padding: 6px 14px;
  }
  .ph-app-pill::before { content: ''; width: 5px; height: 5px; flex-shrink: 0; background: #c0181e; clip-path: polygon(50% 0%,100% 50%,50% 100%,0% 50%); }

  .ph-cta-row { display: flex; gap: clamp(12px,2vw,20px); flex-wrap: wrap; align-items: center; }

  /* ══ BUTTONS ══ */
  .ph-btn-primary {
    display: inline-flex; align-items: center; gap: 10px;
    background: #c0181e; color: #ffffff;
    font-family: var(--font-head); font-weight: 700;
    font-size: 14px; letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; padding: 14px 36px;
    clip-path: polygon(12px 0%,100% 0%,calc(100% - 12px) 100%,0% 100%);
    transition: filter .2s, transform .2s; white-space: nowrap;
  }
  .ph-btn-primary:hover { filter: brightness(1.1); transform: translateY(-2px); }

  .ph-btn-secondary {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,.1); color: #e2ecf8;
    font-family: var(--font-head); font-weight: 700;
    font-size: 14px; letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; padding: 14px 36px;
    border: 1px solid rgba(255,255,255,.2);
    clip-path: polygon(12px 0%,100% 0%,calc(100% - 12px) 100%,0% 100%);
    transition: background .2s, transform .2s; white-space: nowrap;
  }
  .ph-btn-secondary:hover { background: rgba(255,255,255,.18); transform: translateY(-2px); }

  /* In light sections, secondary button needs dark colours */
  .ph-body-section .ph-btn-secondary,
  .ph-cta-band .ph-btn-secondary {
    background: #163060; color: #e2ecf8;
    border: none;
  }
  .ph-body-section .ph-btn-secondary:hover,
  .ph-cta-band .ph-btn-secondary:hover { filter: brightness(1.15); }

  /* ══ CONFIGS ══ */
  .ph-configs-section {
    background:
      radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.12) 0%, transparent 55%),
      linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(48px,7vh,80px);
  }
  .ph-configs-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-top: 4px; }
  @media (min-width: 900px) { .ph-configs-grid { grid-template-columns: repeat(3,1fr); } }
  .ph-config-card { background: #ffffff; border-top: 3px solid rgba(8,56,146,.15); border-radius: 4px; padding: 16px 18px; transition: border-top-color .2s; }
  .ph-config-card:hover { border-top-color: #c0181e; }
  .config-name { font-family: var(--font-head); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: rgba(8,56,146,.9); margin-bottom: 6px; }
  .config-desc { font-family: var(--font-body); font-size: 13px; font-weight: 300; color: #4a5068; line-height: 1.55; }

  /* ══ VECTRIX ══ */
  .ph-platform-section {
    background-color: #f8fafc;
    background-image: linear-gradient(rgba(8,56,146,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(8,56,146,.06) 1px, transparent 1px);
    background-size: 60px 60px;
    padding-block: clamp(40px,6vh,64px);
    border-bottom: 1px solid rgba(8,56,146,.07);
  }
  .ph-platform-inner { background: rgba(8,56,146,.04); border-left: 4px solid rgba(8,56,146,.35); border-radius: 0 4px 4px 0; padding: clamp(16px,2.5vw,24px) clamp(20px,3vw,32px); display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 640px) { .ph-platform-inner { flex-direction: row; align-items: flex-start; gap: 24px; } }
  .ph-platform-badge { font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: rgba(8,56,146,.9); background: rgba(8,56,146,.1); border: 1px solid rgba(8,56,146,.2); padding: 5px 12px; white-space: nowrap; align-self: flex-start; flex-shrink: 0; }
  .ph-platform-text { font-family: var(--font-body); font-size: 14px; font-weight: 300; color: #3a4560; line-height: 1.75; margin: 0; }
  .ph-platform-text strong { color: rgba(8,56,146,.9); font-weight: 600; }

  /* ══ RELATED ══ */
  .ph-related-section {
    background: radial-gradient(ellipse 100% 60% at 20% -10%, rgba(140,180,255,.10) 0%, transparent 55%), linear-gradient(145deg, #0e2454 0%, #163060 50%, #1a3875 100%);
    padding-block: clamp(48px,7vh,80px);
  }
  .ph-related-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 540px) { .ph-related-grid { grid-template-columns: repeat(2,1fr); } }
  @media (min-width: 900px) { .ph-related-grid { grid-template-columns: repeat(4,1fr); } }
  .ph-related-card { position: relative; overflow: hidden; background: #ffffff; border-top: 3px solid transparent; border-radius: 4px; text-decoration: none; display: flex; flex-direction: column; transition: border-top-color .25s, transform .25s, box-shadow .25s; box-shadow: 0 4px 16px rgba(0,0,0,.15); }
  .ph-related-card:hover { border-top-color: #c0181e; transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,.25); }

---
/**
 * src/pages/careers.astro — REFACTORED
 *
 * Thin orchestrator. This file owns:
 *   1. All JSON-LD schema (BreadcrumbList, Organization, JobPosting×6, FAQPage)
 *   2. SEO props passed to BaseLayout
 *   3. Component imports + assembly order
 *
 * It contains NO layout HTML and NO <style> blocks.
 * All visual content lives in the components below.
 *
 * Component tree:
 *   BaseLayout
 *   └── CareersHero        ← page header, H1, breadcrumb, answer-box
 *   └── WhySection         ← "Why work here" copy + feature points
 *   └── RolesGrid          ← job cards (static HTML, no JS)
 *   └── ExploreBand        ← 4 internal link cards
 *   └── CareersFaq         ← native <details> accordion, no JS
 *   └── ApplySection       ← application steps + HR contact block
 *
 * Astro Island summary:
 *   All components → static HTML (no client:* directives needed)
 *   The scroll-reveal JS in BaseLayout handles .reveal animations.
 */

import BaseLayout    from '../layouts/BaseLayout.astro';
import CareersHero   from '../components/careers/CareersHero.astro';
import WhySection    from '../components/careers/WhySection.astro';
import RolesGrid     from '../components/careers/RolesGrid.astro';
import ExploreBand   from '../components/careers/ExploreBand.astro';
import CareersFaq    from '../components/careers/CareersFaq.astro';
import ApplySection  from '../components/careers/ApplySection.astro';

// ─── Data ────────────────────────────────────────────────────────────────
// Single source of truth — all schema + component data from one file
import { roles, faqs, SITE_URL, PAGE_URL } from '../data/careers.ts';

const YEAR = new Date().getFullYear();

// ─── JSON-LD: BreadcrumbList ──────────────────────────────────────────────
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',    item: SITE_URL  },
    { '@type': 'ListItem', position: 2, name: 'Join Us', item: PAGE_URL  },
  ],
};

// ─── JSON-LD: Organization (employer identity for JobPosting) ─────────────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type':    'Organization',
  '@id':      `${SITE_URL}/#organization`,
  name:        'The Jayveecons Group',
  url:          SITE_URL,
  logo:        `${SITE_URL}/images/logo.png`,
  description: 'Engineering and manufacturing of bulk material handling and processing equipment. Founded 1987, Malur, Karnataka, India.',
  address: {
    '@type':         'PostalAddress',
    streetAddress:   '1st Phase, Plot 87/D2, Mcnally Rd, Industrial Estate',
    addressLocality: 'Malur',
    addressRegion:   'Karnataka',
    postalCode:      '563130',
    addressCountry:  'IN',
  },
  contactPoint: {
    '@type':           'ContactPoint',
    telephone:         '+91-95388-67139',
    contactType:       'Human Resources',
    email:             'hr@jayveecons.com',
    availableLanguage: 'English',
  },
};

// ─── JSON-LD: JobPosting × roles.length ───────────────────────────────────
// Generated from the same roles[] array used by RolesGrid — single source of truth
const jobPostingSchemas = roles.map(role => ({
  '@context':      'https://schema.org',
  '@type':         'JobPosting',
  title:            role.title,
  description:      role.desc,
  identifier: {
    '@type': 'PropertyValue',
    name:    'Jayveecons Group',
    value:    role.id,
  },
  datePosted:      `${YEAR}-01-01`,
  employmentType:   role.employmentType,
  hiringOrganization: {
    '@type': 'Organization',
    name:    'The Jayveecons Group',
    sameAs:   SITE_URL,
    logo:    `${SITE_URL}/images/logo.png`,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type':         'PostalAddress',
      streetAddress:   '1st Phase, Plot 87/D2, Mcnally Rd, Industrial Estate',
      addressLocality: 'Malur',
      addressRegion:   'Karnataka',
      postalCode:      '563130',
      addressCountry:  'IN',
    },
  },
  applicantLocationRequirements: {
    '@type': 'Country',
    name:    'India',
  },
  educationRequirements: {
    '@type':              'EducationalOccupationalCredential',
    credentialCategory:    role.education,
  },
  experienceRequirements: role.experience,
  industryIdentifier:     role.industry,
  applicationContact: {
    '@type':       'ContactPoint',
    email:         'hr@jayveecons.com',
    contactType:   'HR / Recruitment',
  },
}));

// ─── JSON-LD: FAQPage ─────────────────────────────────────────────────────
// Generated from the same faqs[] array used by CareersFaq — single source of truth
const faqSchema = {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  mainEntity:  faqs.map(faq => ({
    '@type': 'Question',
    name:     faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text:     faq.answer,   // plain text used here (schema can't render HTML)
    },
  })),
};
---

<BaseLayout
  title="Engineering Jobs in Malur | Jayveecons Careers"
  description="Mechanical, process, fabrication and commissioning engineering roles at Jayveecons Group — bulk material handling equipment manufacturer in Malur, Karnataka. Apply to hr@jayveecons.com."
  keywords="mechanical engineer jobs Malur, engineering jobs bulk material handling India, fabrication jobs Karnataka, process engineer jobs Bangalore, VSK engineer jobs, erection commissioning engineer India, Jayveecons careers"
  currentPath="/careers"
>

  <!--
    JSON-LD schema blocks injected into <head> via BaseLayout slot.
    All schema is generated server-side at build time — zero client JS.
  -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jobPostingSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ── Page sections (assembly order = visual order) ── -->

  <CareersHero />

  <WhySection />

  <RolesGrid roles={roles} />

  <ExploreBand />

  <CareersFaq faqs={faqs} />

  <ApplySection />

  <!--
    Stagger animation script — runs after all static HTML is painted.
    Targets career-specific grids not covered by BaseLayout's global observer.
    This is the ONLY JS on this page (< 200 bytes).
  -->
  <script>
    // Stagger role cards
    document.querySelectorAll('.role-card').forEach((card, i) => {
      (card as HTMLElement).style.transitionDelay = `${i * 60}ms`;
    });
    // Stagger explore cards
    document.querySelectorAll('.explore-card').forEach((card, i) => {
      (card as HTMLElement).style.transitionDelay = `${i * 80}ms`;
    });
  </script>

</BaseLayout>

<script>
/* ════════════════════════════════════════════════════
   3D GLOBE ENGINE
   The globe is a CSS sphere (border-radius:50%).
   Dots are positioned using spherical→CSS projection:
   given lat/lon, we compute the x,y percentage on the
   visible face of the sphere. Dots get opacity:0 when
   they're on the "back" of the globe (cos < 0).
   The zoom-out animation uses CSS transform scale()
   starting tight on India (SE of center) pulling back
   to full globe as era index advances.
════════════════════════════════════════════════════ */

// Globe rotation offset — we tilt the globe so India
// (77.6°E) is front-and-center on load
const GLOBE_LON_OFFSET = -77; // degrees — shifts India to front
const GLOBE_LAT_OFFSET = -13; // degrees — shifts Bengaluru to center

// Convert geographic coordinates to CSS % position on sphere face
function latLonToXY(lat, lon) {
  // Apply rotation offset
  const adjLon = (lon + GLOBE_LON_OFFSET) * Math.PI / 180;
  const adjLat = (lat + GLOBE_LAT_OFFSET) * Math.PI / 180;
  // 3D unit vector
  const x3 = Math.cos(adjLat) * Math.sin(adjLon);
  const y3 = -Math.sin(adjLat);
  const z3 = Math.cos(adjLat) * Math.cos(adjLon);
  // Orthographic projection: x,y in [-1,1], z is depth
  // Convert to percentage: center is 50%, radius is 50%
  const px = 50 + x3 * 45; // % — slightly inside edge for labels
  const py = 50 + y3 * 45;
  return { px, py, visible: z3 > -0.1 };
}

// Era data: locations with real lat/lon
const GLOBE_ERAS = [
  {
    name: '1987–1995',
    desc: 'Bengaluru, Karnataka · Founding',
    zoom: 2.6,    // zoomed tight on India
    zoomX: -12,   // translateX % to center India
    zoomY: 6,
    locs: [
      { lat:12.97, lon:77.59, type:'home', label:'Bengaluru' },
    ]
  },
  {
    name: '1996–2005',
    desc: 'South & Central India · Manufacturing begins',
    zoom: 1.9,
    zoomX: -8,
    zoomY: 4,
    locs: [
      { lat:12.97, lon:77.59, type:'home',  label:'Bengaluru' },
      { lat:13.08, lon:80.27, type:'india', label:'Chennai' },
      { lat:17.38, lon:78.48, type:'india', label:'Hyderabad' },
      { lat:19.07, lon:72.87, type:'india', label:'Mumbai' },
      { lat:18.52, lon:73.86, type:'india', label:'Pune' },
    ]
  },
  {
    name: '2006–2015',
    desc: 'Pan-India · First exports',
    zoom: 1.3,
    zoomX: -5,
    zoomY: 2,
    locs: [
      { lat:12.97, lon:77.59, type:'home',  label:'Bengaluru' },
      { lat:13.08, lon:80.27, type:'india', label:'Chennai' },
      { lat:17.38, lon:78.48, type:'india', label:'Hyderabad' },
      { lat:19.07, lon:72.87, type:'india', label:'Mumbai' },
      { lat:28.61, lon:77.21, type:'india', label:'Delhi' },
      { lat:22.57, lon:88.36, type:'india', label:'Kolkata' },
      { lat:23.02, lon:72.57, type:'india', label:'Gujarat' },
      { lat:25.31, lon:55.37, type:'intl',  label:'Gulf Region' },
    ]
  },
  {
    name: '2016–Present',
    desc: 'India + International',
    zoom: 1.0,
    zoomX: 0,
    zoomY: 0,
    locs: [
      { lat:12.97, lon:77.59, type:'home',  label:'Bengaluru' },
      { lat:13.08, lon:80.27, type:'india', label:'Chennai' },
      { lat:17.38, lon:78.48, type:'india', label:'Hyderabad' },
      { lat:19.07, lon:72.87, type:'india', label:'Mumbai' },
      { lat:28.61, lon:77.21, type:'india', label:'Delhi' },
      { lat:25.31, lon:55.37, type:'intl',  label:'Gulf' },
      { lat: 7.87, lon:80.77, type:'intl',  label:'Sri Lanka' },
      { lat:23.68, lon:90.35, type:'intl',  label:'Bangladesh' },
      { lat:-1.29, lon:36.82, type:'intl',  label:'East Africa' },
    ]
  },
  {
    name: 'Future Targets',
    desc: 'Global · Oil & Gas · Pharma · Agri',
    zoom: 1.0,
    zoomX: 0,
    zoomY: 0,
    locs: [
      { lat:12.97, lon:77.59, type:'home',   label:'Bengaluru' },
      { lat:25.31, lon:55.37, type:'intl',   label:'Gulf' },
      { lat:48.86, lon: 2.35, type:'target', label:'Europe' },
      { lat:37.77, lon:-122.4,type:'target', label:'N. America' },
      { lat:14.06, lon:108.27,type:'target', label:'SE Asia' },
      { lat:-33.87,lon:151.21,type:'target', label:'Australia' },
      { lat:-1.29, lon:36.82, type:'target', label:'Africa' },
    ]
  }
];

let currentEraIdx = 0;
let globeAutoTimer = null;

function renderGlobe(idx, animate) {
  const era = GLOBE_ERAS[idx];
  const dotsEl = document.getElementById('globe-dots');
  dotsEl.innerHTML = '';

  // Update zoom transform
  const zoom = document.getElementById('globe-zoom');
  zoom.style.transform = `scale(${era.zoom}) translate(${era.zoomX}%, ${era.zoomY}%)`;

  // Render dots
  era.locs.forEach((loc, i) => {
    const pos = latLonToXY(loc.lat, loc.lon);
    if (!pos.visible) return;

    const wrap = document.createElement('div');
    wrap.className = 'g-dot';
    wrap.style.left = pos.px + '%';
    wrap.style.top  = pos.py + '%';
    if (animate) {
      wrap.style.opacity = '0';
      setTimeout(() => { wrap.style.opacity = '1'; }, i * 120 + 80);
    } else {
      wrap.style.opacity = '1';
    }

    const core = document.createElement('div');
    core.className = `core ${loc.type}`;
    if (animate) core.style.animation = `dotPop .4s cubic-bezier(.34,1.56,.64,1) ${i*120+80}ms both`;
    wrap.appendChild(core);

    if (loc.type === 'home' || loc.type === 'intl') {
      const rip = document.createElement('div');
      rip.className = 'ripple';
      rip.style.background = loc.type === 'home' ? 'rgba(233, 8, 15, 0.92)' : 'var(--teal-l)';
      rip.style.animationDelay = (i * 0.3) + 's';
      wrap.appendChild(rip);
      if (loc.type === 'home') {
        const rip2 = document.createElement('div');
        rip2.className = 'ripple ripple2';
        rip2.style.background = 'rgba(233, 8, 15, 0.92)';
        wrap.appendChild(rip2);
      }
    }

    // Label — only for visible dots, positioned to right
    const lbl = document.createElement('div');
    lbl.className = 'g-dot-label';
    lbl.textContent = loc.label;
    lbl.style.left = '12px';
    lbl.style.top = '-3px';
    // Invert label side if dot is on right half
    if (pos.px > 72) { lbl.style.left = 'auto'; lbl.style.right = '12px'; lbl.style.textAlign = 'right'; }
    wrap.appendChild(lbl);
    setTimeout(() => wrap.classList.add('visible'), i * 120 + 200);

    dotsEl.appendChild(wrap);
  });

  // Update era label and badge
  document.getElementById('globe-era-label').innerHTML =
    `<span class="era-name">${era.name}</span> · ${era.desc}`;
  document.getElementById('header-era-name').textContent = era.name + ' — ' + era.desc;

  // Update pip dots
  document.querySelectorAll('.era-pip').forEach((p, i) => p.classList.toggle('active', i === idx));
}

// Build pip controls
const pipContainer = document.getElementById('era-pips');
GLOBE_ERAS.forEach((era, i) => {
  const pip = document.createElement('button');
  pip.className = 'era-pip' + (i === 0 ? ' active' : '');
  pip.title = era.name;
  pip.setAttribute('aria-label', 'View era: ' + era.name);
  pip.addEventListener('click', () => {
    clearInterval(globeAutoTimer);
    globeAutoTimer = null;
    currentEraIdx = i;
    renderGlobe(i, true);
  });
  pipContainer.appendChild(pip);
});

// Initial render — no animation, era 0
renderGlobe(0, false);

// Auto-advance on page load after short delay
function startGlobeAuto() {
  globeAutoTimer = setInterval(() => {
    currentEraIdx = (currentEraIdx + 1) % GLOBE_ERAS.length;
    renderGlobe(currentEraIdx, true);
  }, 2800);
}
setTimeout(startGlobeAuto, 1400);

/* ════════ TIMELINE — scroll-activated diamond glow ════════ */
const tlItems = document.querySelectorAll('.tl-item');
const tlObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    entry.target.classList.toggle('tl-active', entry.isIntersecting);
  });
}, { threshold: 0.5, rootMargin: '-10% 0px -40% 0px' });

tlItems.forEach(item => tlObs.observe(item));

/* ════════ DYNAMIC YEAR ════════ */
const yr = new Date().getFullYear() - 1987;
document.getElementById('copy-year').textContent = new Date().getFullYear();
document.getElementById('hdr-years').textContent = yr + ' Years';
document.getElementById('cta-years-text').textContent = yr + ' years of engineering experience, at your project\'s service.';

</script>


---
/**
 * src/pages/about.astro
 * ─────────────────────
 * About Us page orchestrator.
 * Imports all section components and handles SEO/schema.
 *
 * FOLDER STRUCTURE:
 *   src/
 *     pages/
 *       about.astro                      ← this file
 *     components/
 *       about/
 *         AboutHero.astro
 *         AboutFounder.astro
 *         AboutTimeline.astro
 *         AboutMissionValues.astro
 *         AboutTeam.astro
 *         AboutRecognition.astro
 *         AboutCTA.astro
 *     styles/
 *       about-shared.css                 ← keyframes + shared tokens
 *       global.css                       ← already exists, unchanged
 */

import BaseLayout         from '../layouts/BaseLayout.astro';
import AboutHero          from '../components/about/AboutHero.astro';
import AboutFounder       from '../components/about/AboutFounder.astro';
import AboutTimeline      from '../components/about/AboutTimeline.astro';
import AboutMissionValues from '../components/about/AboutMissionValues.astro';
import AboutTeam          from '../components/about/AboutTeam.astro';
import AboutRecognition   from '../components/about/AboutRecognition.astro';
import AboutCTA           from '../components/about/AboutCTA.astro';
import '../styles/about-shared.css';

// ── Dynamic year for SEO strings ──────────────────
const currentYear   = new Date().getFullYear();
const yearsInBiz    = currentYear - 1987;

const seoTitle       = `About Jayveecons Group — ${yearsInBiz} Years of Bulk Material Handling Equipment Manufacturing`;
const seoDesc        = `Jayveecons Group was established in 1987 in Bengaluru, India as an engineering consultancy and has grown into a full-scale manufacturer of VECTOMEC™ bulk material handling and process equipment. Learn about our history, leadership, mission, and values.`;
const seoKeywords    = [
  'Jayveecons Group about us',
  'bulk material handling equipment manufacturer India',
  'industrial equipment manufacturer Bengaluru',
  'cement plant equipment manufacturer since 1987',
  'VSK vertical shaft kiln manufacturer India',
  'VECTOMEC equipment manufacturer',
  'VECTRIX design platform',
  'K R Subramanian Jayveecons',
  'Rama Subramanian Jayveecons',
  'engineering company Malur Karnataka',
  'material handling equipment manufacturer Bengaluru',
  'industrial fabrication company India',
  'Priyadarshini Award winner',
  'women entrepreneur award manufacturing India',
  'AkshayVipra El-Mec',
  'JV Group India',
  '90000 sqft fabrication facility Bengaluru',
].join(', ');

const ogImage = 'https://www.jayveecons.com/images/og-about.jpg';
const canonicalPath = '/about';
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  keywords={seoKeywords}
  currentPath={canonicalPath}
  ogImage={ogImage}
>

  <!-- ══════════════════════════════════════════════
       STRUCTURED DATA
       Organization (matches contact.astro schema)
       + BreadcrumbList + AboutPage + Person entities
  ══════════════════════════════════════════════ -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.jayveecons.com/#org",
        "name": "Jayveecons Group",
        "alternateName": "Jayveecons",
        "url": "https://www.jayveecons.com",
        "logo": "https://www.jayveecons.com/images/logo.png",
        "foundingDate": "1987",
        "foundingLocation": {
          "@type": "Place",
          "name": "Bengaluru, Karnataka, India"
        },
        "description": "Manufacturer of VECTOMEC™ bulk material handling and processing equipment for cement, mining, food, waste, steel and fertilizer industries. Est. 1987, Bengaluru, India.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "1st Phase, Plot 87/D2, Mcnally Road, Industrial Estate",
          "addressLocality": "Malur",
          "addressRegion": "Karnataka",
          "postalCode": "563130",
          "addressCountry": "IN"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+91-94480-88230",
          "email": "sales@jayveecons.com",
          "contactType": "sales",
          "areaServed": "IN",
          "availableLanguage": ["English", "Kannada", "Hindi"]
        },
        "numberOfEmployees": {
          "@type": "QuantitativeValue",
          "minValue": 50
        },
        "knowsAbout": [
          "Bulk material handling equipment",
          "Vertical Shaft Kiln systems",
          "Screw conveyors",
          "Bucket elevators",
          "Ball mills",
          "Belt conveyors",
          "Industrial crushers",
          "Storage silos",
          "Dust collectors"
        ],
        "award": [
          "Priyadarshini Award 2012",
          "Women Entrepreneur Award 2015 — NVDP Exhibition, Kolar"
        ],
        "sameAs": []
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://www.jayveecons.com" },
          { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://www.jayveecons.com/about" }
        ]
      },
      {
        "@type": "AboutPage",
        "@id": "https://www.jayveecons.com/about",
        "name": seoTitle,
        "description": seoDesc,
        "url": "https://www.jayveecons.com/about",
        "inLanguage": "en-IN",
        "isPartOf": { "@id": "https://www.jayveecons.com/#org" },
        "about": { "@id": "https://www.jayveecons.com/#org" },
        "dateModified": new Date().toISOString().split('T')[0]
      },
      {
        "@type": "Person",
        "@id": "https://www.jayveecons.com/#founder",
        "name": "K. R. Subramanian",
        "jobTitle": "Founder & Managing Director",
        "worksFor": { "@id": "https://www.jayveecons.com/#org" },
        "knowsAbout": ["Vertical Shaft Kiln technology", "Cement plant engineering", "Bulk material handling"]
      },
      {
        "@type": "Person",
        "name": "Rama Subramanian",
        "jobTitle": "Director",
        "worksFor": { "@id": "https://www.jayveecons.com/#org" },
        "award": [
          "Priyadarshini Award 2012",
          "Women Entrepreneur Award 2015"
        ]
      }
    ]
  })}</script>

  <!-- ══ SECTIONS — in DOM order ══ -->
  <AboutHero />
  <AboutFounder />
  <AboutTimeline />
  <AboutMissionValues />
  <AboutTeam />
  <AboutRecognition />
  <AboutCTA />

  <!-- ══ Scroll-reveal catch-up island ══ -->
  <script>
    (() => {
      // Re-observe any .reveal elements BaseLayout may have missed
      // (components that render after BaseLayout's DOMContentLoaded)
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.07, rootMargin: '0px 0px -28px 0px' }
      );
      document.querySelectorAll('.reveal:not(.visible)').forEach((el) => obs.observe(el));
    })();
  </script>

</BaseLayout>



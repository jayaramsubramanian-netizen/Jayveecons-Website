---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About Us — Jayveecons Group"
  description="About Jayveecons — our story, founding history, leadership team, mission, values and global reach since 1987. Bengaluru, India."
  currentPath="/about"
>

<style>
.page-header{
  position:relative;
  padding:110px 0 0;
  overflow:hidden;
  background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 55%,var(--black) 100%);
  min-height:100svh;
  display:flex;
  flex-direction:column;
}
.page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 70% 50%,rgba(26,50,96,.55),transparent 65%)}

.page-header-inner{
  position:relative;z-index:1;
  max-width:1440px;margin:0 auto;
  padding:clamp(20px,4vh,48px) clamp(18px,4vw,48px);
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(24px,4vw,64px);
  align-items:center;
  flex:1;
}

/* Left: headline + text */
.header-copy{}
.breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:20px;font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.breadcrumb a{color:#7a8499;text-decoration:none;transition:color .2s}
.breadcrumb a:hover{color:var(--fog)}
.breadcrumb .sep{color:#3a4255}
.breadcrumb .current{color:#ff7070}
.page-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:16px;animation:fadeUp .7s ease .1s both}
.page-eyebrow-line{width:40px;height:2px;background:var(--crimson)}
.page-eyebrow span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.page-title{font-family:var(--font-head);font-weight:800;font-size:clamp(44px,6.5vw,84px);text-transform:uppercase;line-height:.92;letter-spacing:-.01em;margin-bottom:22px;animation:fadeUp .7s ease .2s both}
.page-title .accent{color:var(--crimson-l)}
.page-title .chrome{background:linear-gradient(135deg,var(--chrome-l),var(--chrome));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.page-sub{font-size:clamp(14px,1.7vw,17px);font-weight:300;color:var(--fog);line-height:1.75;margin-bottom:28px;animation:fadeUp .7s ease .3s both}
.header-era-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(13,26,58,.6);border:1px solid rgba(192,24,30,.3);border-left:3px solid var(--crimson);padding:10px 16px;animation:fadeUp .7s ease .45s both}
.header-era-badge .label{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7a8aaa}
.header-era-badge .value{font-family:var(--font-head);font-weight:700;font-size:16px;color:var(--chrome);letter-spacing:.06em}
.header-era-badge .era-indicator{width:8px;height:8px;background:var(--crimson);border-radius:50%;animation:pulse 1.8s ease infinite}

/* Right: Globe */
.header-globe{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:16px;
  animation:fadeUp .8s ease .4s both;
}

/* ═══ 3D GLOBE ═══ */
.globe-wrap{
  position:relative;
  width:clamp(260px,35vw,440px);
  aspect-ratio:1;
  flex-shrink:0;
}
.globe-scene{
  width:100%;height:100%;
  perspective:800px;
  perspective-origin:50% 50%;
}
.globe-sphere{
  width:100%;height:100%;
  position:relative;
  transform-style:preserve-3d;
}
/* The actual sphere */
.globe-ball{
  width:100%;height:100%;
  border-radius:50%;
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 35% 35%, rgba(42,74,138,.9) 0%, rgba(17,34,71,.8) 40%, rgba(10,18,42,.95) 100%);
  box-shadow:
    inset -20px -20px 60px rgba(0,0,0,.7),
    inset 10px 10px 40px rgba(51,96,184,.2),
    0 0 60px rgba(13,26,58,.8),
    0 0 120px rgba(192,24,30,.08);
  overflow:hidden;
}
/* Latitude lines */
.globe-ball::before{
  content:'';
  position:absolute;inset:0;
  border-radius:50%;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,transparent calc(16.67% - 0.5px),
      rgba(51,96,184,.18) calc(16.67% - 0.5px),rgba(51,96,184,.18) 16.67%
    );
}
/* Longitude lines via conic */
.globe-ball::after{
  content:'';
  position:absolute;inset:0;
  border-radius:50%;
  background:
    repeating-conic-gradient(
      from 0deg,
      transparent 0deg,transparent 14.4deg,
      rgba(51,96,184,.12) 14.4deg,rgba(51,96,184,.12) 15deg
    );
}
/* Highlight sheen */
.globe-sheen{
  position:absolute;
  width:55%;height:45%;
  top:8%;left:18%;
  border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
  background:radial-gradient(ellipse,rgba(255,255,255,.1) 0%,transparent 70%);
  pointer-events:none;
  z-index:10;
}
/* Edge glow ring */
.globe-ring{
  position:absolute;inset:-3px;
  border-radius:50%;
  box-shadow:inset 0 0 0 1px rgba(51,96,184,.25), 0 0 40px rgba(51,96,184,.12);
  pointer-events:none;
  z-index:11;
}
/* Crimson equator accent */
.globe-equator{
  position:absolute;
  left:0;right:0;
  top:calc(50% - 0.5px);
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(192,24,30,.35) 30%,rgba(192,24,30,.5) 50%,rgba(192,24,30,.35) 70%,transparent);
  pointer-events:none;
  z-index:9;
}

/* Dots layer — positioned inside globe-ball */
.globe-dots{
  position:absolute;inset:0;
  border-radius:50%;
  overflow:hidden;
  z-index:8;
}
.g-dot{
  position:absolute;
  transform:translate(-50%,-50%);
  opacity:0;
  transition:opacity .5s ease;
}
.g-dot.visible{opacity:1}
.g-dot .core{
  width:8px;height:8px;
  border-radius:50%;
  position:relative;
  z-index:2;
  animation:dotPop .4s cubic-bezier(.34,1.56,.64,1) both;
}
.g-dot .core.home{background:#ff4444;width:10px;height:10px;box-shadow:0 0 12px rgba(255,68,68,.8)}
.g-dot .core.india{background:#e02428;box-shadow:0 0 8px rgba(224,36,40,.6)}
.g-dot .core.intl{background:var(--teal-l);box-shadow:0 0 8px rgba(20,168,152,.5)}
.g-dot .core.target{background:transparent;border:1.5px dashed rgba(20,168,152,.7);width:9px;height:9px}
.g-dot .ripple{
  position:absolute;
  width:100%;height:100%;
  border-radius:50%;
  background:inherit;
  top:0;left:0;
  opacity:0;
  transform:scale(1);
  animation:rippleDot 2s ease-out infinite;
}
.g-dot .ripple2{animation-delay:.8s}
/* Labels outside globe */
.g-dot-label{
  position:absolute;
  font-family:var(--font-mono);font-size:9px;
  color:#c8cdd8;letter-spacing:.06em;
  white-space:nowrap;pointer-events:none;
  opacity:0;transition:opacity .4s ease .2s;
  z-index:20;
}
.g-dot.visible .g-dot-label{opacity:1}

/* Globe zoom container — this is what animates */
#globe-zoom{
  width:100%;height:100%;
  transition:transform 1.2s cubic-bezier(.4,0,.2,1);
  transform-origin:center center;
}

/* Era label below globe */
.globe-era-label{
  font-family:var(--font-mono);
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:#7a8aaa;
  text-align:center;
  min-height:18px;
  transition:opacity .3s;
}
.globe-era-label .era-name{color:#ff7070;font-weight:500}

/* Era control dots */
.globe-era-dots{
  display:flex;gap:8px;align-items:center;
}
.era-pip{
  width:8px;height:8px;
  border-radius:50%;
  background:rgba(51,96,184,.3);
  border:1px solid rgba(51,96,184,.4);
  cursor:pointer;
  transition:background .25s,transform .25s;
}
.era-pip.active{background:var(--crimson);border-color:var(--crimson);transform:scale(1.3)}
.era-pip:hover{background:rgba(192,24,30,.5)}

/* ═══ COMMON ═══ */
section{position:relative;z-index:1}
.section-inner{max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.section-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:12px}
.section-tag .line{width:28px;height:2px;background:var(--crimson)}
.section-tag span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.section-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(34px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:14px}
.section-sub{font-size:clamp(14px,1.6vw,16px);font-weight:300;color:var(--fog);line-height:1.75;max-width:640px}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--crimson);color:var(--white);font-family:var(--font-head);font-weight:700;font-size:15px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:14px 32px;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:background .2s,transform .2s;white-space:nowrap}
.btn-primary:hover{background:var(--crimson-l);transform:translateX(3px)}
.btn-secondary{display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--chrome);font-family:var(--font-head);font-weight:600;font-size:15px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:13px 32px;border:1px solid rgba(208,212,220,.2);transition:color .2s,border-color .2s;white-space:nowrap}
.btn-secondary:hover{color:var(--white);border-color:rgba(208,212,220,.5)}

/* ═══ FOUNDER / OUR STORY ═══ */
.founder{padding:clamp(60px,8vh,96px) 0;background:linear-gradient(180deg,var(--ink-2) 0%,var(--ink) 100%)}

/* Full-width lead paragraph above cards */
.founder-lead-wrap{margin-bottom:clamp(32px,4vh,52px)}
.founder-lead-tag{margin-bottom:12px}
.founder-lead-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(36px,5vw,60px);text-transform:uppercase;line-height:.95;letter-spacing:-.01em;margin-bottom:24px}
.founder-lead-headline .accent{color:var(--crimson-l)}
.founder-lead-p{font-size:clamp(16px,2vw,20px);font-weight:400;color:var(--chrome);line-height:1.7;max-width:900px;margin-bottom:16px}
.founder-lead-divider{width:60px;height:2px;background:var(--crimson);margin-bottom:16px}
.founder-lead-sub{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.8;max-width:820px}

/* Two-column area below lead */
.founder-body{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(32px,5vw,72px);align-items:start}
.founder-copy p{font-size:clamp(14px,1.5vw,15px);font-weight:300;line-height:1.85;color:var(--fog);margin-bottom:16px}
.founder-copy p strong{color:var(--white);font-weight:500}
.founder-quote{border-left:3px solid var(--crimson);padding:18px 22px;background:rgba(13,26,58,.4);margin:20px 0}
.founder-quote p{font-size:clamp(14px,1.5vw,17px);font-style:italic;font-weight:300;color:var(--chrome-l);line-height:1.65}
.founder-quote cite{display:block;margin-top:10px;font-size:11px;font-family:var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:#ff7070;font-style:normal}

/* Engineering process cards — non-repetitive, different from homepage */
.process-cards{display:flex;flex-direction:column;gap:2px}
.proc-card{background:var(--ink-3);padding:clamp(16px,2.5vw,24px);display:flex;gap:16px;align-items:flex-start;border-left:3px solid transparent;transition:border-left-color .25s,background .25s}
.proc-card:hover{background:rgba(13,26,58,.5);border-left-color:var(--crimson)}
.proc-num{font-family:var(--font-head);font-weight:800;font-size:clamp(28px,4vw,40px);color:rgba(192,24,30,.25);line-height:1;flex-shrink:0;width:clamp(40px,5vw,60px);text-align:right}
.proc-content{}
.proc-title{font-family:var(--font-head);font-weight:700;font-size:clamp(14px,1.8vw,17px);text-transform:uppercase;letter-spacing:.05em;color:var(--chrome);margin-bottom:4px}
.proc-desc{font-size:12px;font-weight:300;color:#8898b0;line-height:1.55}
.partner-strip{margin-top:2px;background:rgba(13,26,58,.5);border:1px solid rgba(51,96,184,.2);border-left:3px solid var(--crimson);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.partner-strip .label{font-size:12px;color:var(--mist);font-weight:300}
.partner-strip a{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--teal-l);text-decoration:none;text-transform:uppercase;transition:color .2s}
.partner-strip a:hover{color:var(--white)}

/* ═══ TIMELINE — fixed layout ═══ */
.timeline-section{padding:clamp(60px,8vh,96px) 0;background:var(--ink)}
.timeline{
  position:relative;
  margin-top:clamp(32px,5vh,52px);
  /* No ::before pseudo — line is drawn differently now */
}

.tl-item{
  display:grid;
  /* year | gap+diamond+line | content */
  grid-template-columns:clamp(80px,10vw,130px) 48px 1fr;
  gap:0;
  margin-bottom:clamp(24px,4vh,44px);
  align-items:start;
  position:relative;
}

/* Year column */
.tl-year-col{
  text-align:right;
  padding-right:0;
  padding-top:6px;
}
.tl-year{font-family:var(--font-head);font-weight:800;font-size:clamp(16px,2.2vw,24px);color:var(--crimson-l);line-height:1;transition:color .3s}
.tl-era{font-family:var(--font-mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#5580cc;margin-top:3px;transition:color .3s}

/* Middle column: diamond + vertical line */
.tl-mid{
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.tl-diamond{
  width:16px;height:16px;
  background:var(--crimson);
  clip-path:polygon(50% 0%,100% 50%,50% 100%,0% 50%);
  flex-shrink:0;
  margin-top:5px;
  transition:transform .3s,background .3s;
  position:relative;
  z-index:2;
}
.tl-item.tl-active .tl-diamond{
  animation:diamondGlow 1.5s ease infinite;
}
.tl-item.tl-active .tl-year{color:#ff7070}
.tl-item.tl-active .tl-era{color:#7ab0ff}

/* Line between diamond and next diamond */
.tl-line{
  width:2px;
  flex:1;
  min-height:clamp(24px,3vh,40px);
  background:linear-gradient(180deg,rgba(233, 8, 15, 0.92),rgba(192,24,30,.15));
  margin-top:2px;
}
.tl-item:last-child .tl-line{display:none}

/* Content card */
.tl-content{
  background:var(--ink-2);
  border:1px solid rgba(51,96,184,.15);
  border-left:3px solid rgba(192,24,30,.3);
  padding:clamp(16px,2.5vw,26px);
  margin-left:clamp(8px,1.5vw,18px);
  transition:background .3s,border-left-color .3s;
}
.tl-item.tl-active .tl-content{
  background:rgba(13,26,58,.4);
  border-left-color:var(--crimson);
}
.tl-title{font-family:var(--font-head);font-weight:700;font-size:clamp(16px,2vw,20px);text-transform:uppercase;letter-spacing:.04em;color:var(--chrome);margin-bottom:8px}
.tl-text{font-size:clamp(13px,1.4vw,14px);font-weight:300;color:#9098b0;line-height:1.75}
.tl-tag{display:inline-block;margin-top:10px;font-family:var(--font-mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;background:rgba(192,24,30,.12);color:var(--crimson-l);padding:3px 8px}

/* ═══ MISSION / VALUES ═══ */
.mission-values{padding:clamp(60px,8vh,96px) 0;background:var(--ink-2)}
.mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,72px);margin-top:clamp(28px,4vh,48px)}
.mission-block .big-quote{font-family:var(--font-head);font-weight:800;font-size:clamp(22px,3vw,34px);text-transform:uppercase;line-height:1.05;color:var(--white);margin-bottom:20px;letter-spacing:.02em}
.mission-block .big-quote span{color:var(--crimson-l)}
.mission-block p{font-size:clamp(14px,1.5vw,15px);font-weight:300;line-height:1.8;color:var(--fog);margin-bottom:14px}
.values-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px}
.value-card{background:var(--ink-3);padding:clamp(18px,2.5vw,26px);border-bottom:2px solid transparent;transition:border-bottom-color .25s,background .25s}
.value-card:hover{background:rgba(13,26,58,.4);border-bottom-color:var(--crimson)}
.value-icon{width:32px;height:32px;color:var(--crimson-l);margin-bottom:12px;opacity:.85}
.value-name{font-family:var(--font-head);font-weight:700;font-size:16px;text-transform:uppercase;letter-spacing:.06em;color:var(--chrome);margin-bottom:6px}
.value-desc{font-size:12px;font-weight:300;color:#8898b0;line-height:1.55}

/* ═══ TEAM ═══ */
.team-section{padding:clamp(60px,8vh,96px) 0;background:var(--ink)}
.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;margin-top:clamp(28px,4vh,44px)}
.team-card{background:var(--ink-2);padding:clamp(20px,2.8vw,32px);border-top:2px solid transparent;transition:border-top-color .3s,background .3s}
.team-card:hover{background:rgba(13,26,58,.4);border-top-color:var(--crimson)}
.team-card.featured{border-top-color:var(--crimson);background:rgba(13,26,58,.3)}
.team-avatar{width:56px;height:56px;background:rgba(192,24,30,.15);border:2px solid rgba(192,24,30,.3);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.team-avatar span{font-family:var(--font-head);font-weight:800;font-size:18px;color:var(--crimson-l)}
.team-role{font-family:var(--font-mono);font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#ff7070;margin-bottom:6px}
.team-name{font-family:var(--font-head);font-weight:700;font-size:clamp(16px,2vw,20px);text-transform:uppercase;letter-spacing:.04em;color:var(--white);margin-bottom:4px;line-height:1.1}
.team-dept{font-size:13px;font-weight:300;color:#8898b0;margin-bottom:14px;line-height:1.4}
.team-tag{display:inline-block;background:rgba(13,26,58,.6);border:1px solid rgba(51,96,184,.25);font-family:var(--font-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#5580cc;padding:3px 8px}

/* ═══ RECOGNITION ═══ */
.recognition{padding:clamp(52px,7vh,80px) 0;background:var(--navy-deep);border-top:1px solid rgba(51,96,184,.15);border-bottom:1px solid rgba(51,96,184,.15)}
.rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:clamp(24px,4vh,40px)}
.rec-card{background:rgba(10,12,18,.7);padding:clamp(22px,3vw,34px);border-left:3px solid var(--crimson);transition:background .3s}
.rec-card:hover{background:rgba(13,26,58,.5)}
.rec-year{font-family:var(--font-head);font-weight:800;font-size:clamp(32px,5vw,48px);color:var(--crimson-l);line-height:1;margin-bottom:6px}
.rec-name{font-family:var(--font-head);font-weight:700;font-size:clamp(16px,2vw,20px);text-transform:uppercase;letter-spacing:.04em;color:var(--chrome);margin-bottom:4px}
.rec-org{font-size:13px;font-weight:300;color:#8898b0;margin-bottom:10px}
.rec-desc{font-size:13px;font-weight:300;color:#7a8499;line-height:1.6}
.rec-placeholder{background:rgba(10,12,18,.4);border:1px dashed rgba(192,24,30,.2);display:flex;align-items:center;justify-content:center;padding:32px;text-align:center}
.rec-placeholder span{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;color:rgba(192,24,30,.35);text-transform:uppercase}

/* ═══ CTA ═══ */
.cta-band{padding:clamp(72px,10vh,112px) 0;background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 60%);position:relative;overflow:hidden;text-align:center}
.cta-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 110%,rgba(192,24,30,.1),transparent 60%)}
.cta-band::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.cta-inner{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.cta-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;color:#ff7070;text-transform:uppercase;margin-bottom:18px}
.cta-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(36px,5.5vw,68px);text-transform:uppercase;line-height:.97;margin-bottom:16px}
.cta-headline .accent{color:var(--crimson-l)}
.cta-sub{font-size:clamp(14px,1.6vw,16px);font-weight:300;color:var(--fog);margin-bottom:40px;line-height:1.65}
.cta-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}


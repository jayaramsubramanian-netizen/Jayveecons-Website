   given lat/lon, we compute the x,y percentage on the
   visible face of the sphere. Dots get opacity:0 when
   they're on the "back" of the globe (cos < 0).
   The zoom-out animation uses CSS transform scale()
   starting tight on India (SE of center) pulling back
   to full globe as era index advances.
════════════════════════════════════════════════════ */

// Globe rotation offset — we tilt the globe so India
// (77.6°E) is front-and-center on load
const GLOBE_LON_OFFSET = -77; // degrees — shifts India to front
const GLOBE_LAT_OFFSET = -13; // degrees — shifts Bengaluru to center

// Convert geographic coordinates to CSS % position on sphere face
function latLonToXY(lat, lon) {
  // Apply rotation offset
  const adjLon = (lon + GLOBE_LON_OFFSET) * Math.PI / 180;
  const adjLat = (lat + GLOBE_LAT_OFFSET) * Math.PI / 180;
  // 3D unit vector
  const x3 = Math.cos(adjLat) * Math.sin(adjLon);
  const y3 = -Math.sin(adjLat);
  const z3 = Math.cos(adjLat) * Math.cos(adjLon);
  // Orthographic projection: x,y in [-1,1], z is depth
  // Convert to percentage: center is 50%, radius is 50%
  const px = 50 + x3 * 45; // % — slightly inside edge for labels
  const py = 50 + y3 * 45;
  return { px, py, visible: z3 > -0.1 };
}

// Era data: locations with real lat/lon
const GLOBE_ERAS = [
  {
    name: '1987–1995',
    desc: 'Bengaluru, Karnataka · Founding',
    zoom: 2.6,    // zoomed tight on India
    zoomX: -12,   // translateX % to center India
    zoomY: 6,
    locs: [
      { lat:12.97, lon:77.59, type:'home', label:'Bengaluru' },
    ]
  },
  {
    name: '1996–2005',
    desc: 'South & Central India · Manufacturing begins',
    zoom: 1.9,
    zoomX: -8,
    zoomY: 4,
    locs: [
      { lat:12.97, lon:77.59, type:'home',  label:'Bengaluru' },
      { lat:13.08, lon:80.27, type:'india', label:'Chennai' },

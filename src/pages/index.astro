---
/**
 * index.astro — HOME PAGE (rebuilt)
 * Owns: JSON-LD schema · SEO props · component assembly
 * No <style>. No HTML. Year computed server-side → zero hydration.
 */
import BaseLayout        from '../layouts/BaseLayout.astro';
import HeroSection       from '../components/home/HeroSection.astro';
import TrustBar          from '../components/home/TrustBar.astro';
import WhatWeDo          from '../components/home/WhatWeDo.astro';
import ProductsSection   from '../components/home/ProductsSection.astro';
import IndustriesSection from '../components/home/IndustriesSection.astro';
import WhyJayveecons     from '../components/home/WhyJayveecons.astro';
import TrackRecord       from '../components/home/TrackRecord.astro';
import CtaBand           from '../components/home/CtaBand.astro';

const YEAR     = new Date().getFullYear();
const yearsOld = YEAR - 1987;
const SITE_URL = 'https://www.jayveecons.com';

const orgSchema = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE_URL}/#org`,
  name: 'Jayveecons Group', url: SITE_URL, foundingDate: '1987',
  logo: `${SITE_URL}/images/logo.png`,
  description: `VECTOMEC™ bulk material handling and processing equipment manufacturer. Est. 1987, Malur, Karnataka, India. ${yearsOld}+ years of continuous operation.`,
  address: { '@type': 'PostalAddress', streetAddress: '1st Phase, Plot 87/D2, Mcnally Road, Industrial Estate', addressLocality: 'Malur', addressRegion: 'Karnataka', postalCode: '563130', addressCountry: 'IN' },
  contactPoint: [
    { '@type': 'ContactPoint', telephone: '+91-94480-88230', contactType: 'sales', email: 'sales@jayveecons.com' },
    { '@type': 'ContactPoint', telephone: '+91-95388-67139', contactType: 'customer support' },
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE_URL}/#website`,
  url: SITE_URL, name: 'Jayveecons Group', publisher: { '@id': `${SITE_URL}/#org` },
  potentialAction: { '@type': 'SearchAction', target: `${SITE_URL}/products?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
const webpageSchema = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${SITE_URL}/#webpage`,
  url: SITE_URL, name: 'Jayveecons Group — Engineering High-Performance Bulk Flow Systems',
  isPartOf: { '@id': `${SITE_URL}/#website` }, about: { '@id': `${SITE_URL}/#org` },
};
---

<BaseLayout
  title="Jayveecons Group — Engineering High-Performance Bulk Flow Systems"
  description="Jayveecons designs and manufactures VECTOMEC™ bulk material handling and processing equipment — screw conveyors, bucket elevators, VSK kilns, ball mills — for cement, mining, food and industrial sectors. Est. 1987, Malur, India."
  keywords="bulk material handling equipment India, screw conveyor manufacturer, bucket elevator, VSK kiln, VECTOMEC, cement plant equipment, ball mill, Jayveecons, Malur Karnataka"
  currentPath="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
  </Fragment>

  <HeroSection       yearsOld={yearsOld} />
  <TrustBar          yearsOld={yearsOld} />
  <WhatWeDo          />
  <ProductsSection   />
  <IndustriesSection />
  <WhyJayveecons     yearsOld={yearsOld} />
  <CtaBand           />
</BaseLayout>




<!-- FOOTER -->

<script>
// Dynamic year calculation — auto-updates every year
const yearsOld = new Date().getFullYear() - 1987;
document.querySelectorAll('#hero-years,#why-years,#track-years').forEach(el => {
  // preserve the <span class="unit"> child if present
  const unit = el.querySelector('.unit');
  el.childNodes[0].nodeValue = yearsOld;
  if (!unit) el.textContent = yearsOld;
});
const trustYears = document.getElementById('trust-years');
if (trustYears) trustYears.textContent = yearsOld + '+ Years · Est. 1987';

const pipelineNodes = document.querySelectorAll('.pipeline .node');
function revealPipeline() {
  const trigger = window.innerHeight * 0.85;
  pipelineNodes.forEach(node => {
    const top = node.getBoundingClientRect().top;
    if (top < trigger) node.classList.add('active');
  });
}
window.addEventListener('scroll', revealPipeline, { passive: true });
revealPipeline();
</script>


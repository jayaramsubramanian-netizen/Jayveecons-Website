---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Jayveecons Group— Engineering High-Performance Bulk Flow Systems"
  description="Jayveecons designs and manufactures precision material handling and integrated material processing systems — VECTOMEC™ conveyors, kilns, mills and more — for cement, mining, food and industrial sectors."
  currentPath="/"
>

<style>
/* ── HERO ── */
.hero{position:relative;min-height:82svh;display:flex;align-items:center;padding-top:64px;overflow:hidden}
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 90% 70% at 65% 40%,rgba(8, 56, 146, 0.9) 0%,transparent 60%),
    radial-gradient(ellipse 50% 60% at 5% 90%,rgba(192,24,30,.07) 0%,transparent 50%),
    linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 55%,var(--black) 100%);
  z-index:0;
}
.hero-bg::after{
  content:'';position:absolute;top:0;right:22%;width:1px;height:100%;
  background:linear-gradient(180deg,transparent 0%,rgba(208,212,220,.16) 30%,rgba(208,212,220,.06) 70%,transparent 100%);
}
.hero-inner{
  position:relative;z-index:1;width:100%;max-width:1440px;margin:0 auto;
  padding:clamp(28px,5vh,56px) clamp(24px,4vw,56px);
  display:grid;grid-template-columns:1.1fr minmax(280px,360px);gap:clamp(32px,4.5vw,72px);align-items:center;
}
.hero-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:22px;animation:fadeUp .8s ease .2s both}
.hero-eyebrow-line{width:44px;height:2px;background:var(--crimson);flex-shrink:0}
.hero-eyebrow span{font-family:var(--font-mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070;font-weight:500}
.hero-headline{
  font-family:var(--font-head);font-weight:800;
  font-size:clamp(46px,7.5vw,90px);line-height:.93;letter-spacing:-.01em;text-transform:uppercase;
  margin-bottom:26px;animation:fadeUp .8s ease .35s both;
}
.hero-headline .accent{color:var(--crimson-l)}
.hero-headline .chrome-grad{
  background:linear-gradient(135deg,var(--chrome-l) 0%,var(--chrome) 40%,var(--chrome-d) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-headline .block{display:block}
.hero-sub{font-size:clamp(14px,1.75vw,16px);font-weight:300;line-height:1.58;color:var(--fog);max-width:720px;margin-bottom:30px;animation:fadeUp .8s ease .5s both}
.hero-sub strong{color:var(--white);font-weight:500}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;animation:fadeUp .8s ease .65s both}

.btn-primary{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--crimson);color:var(--white);
  font-family:var(--font-head);font-weight:700;font-size:15px;letter-spacing:.1em;text-transform:uppercase;
  text-decoration:none;padding:14px 32px;
  clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);
  transition:background .2s,transform .2s;white-space:nowrap;
}
.btn-primary:hover{background:var(--crimson-l);transform:translateX(3px)}
.btn-primary svg{width:16px;height:16px;flex-shrink:0}
.btn-secondary{
  display:inline-flex;align-items:center;gap:9px;
  background:transparent;color:var(--chrome);
  font-family:var(--font-head);font-weight:600;font-size:15px;letter-spacing:.1em;text-transform:uppercase;
  text-decoration:none;padding:13px 32px;border:1px solid rgba(208,212,220,.2);
  transition:color .2s,border-color .2s;white-space:nowrap;
}
.btn-secondary:hover{color:var(--white);border-color:rgba(208,212,220,.5)}
.btn-lg{padding:18px 48px;font-size:16px}

.hero-stats{display:flex;flex-direction:column;gap:2px;animation:fadeIn 1s ease .8s both}
.hero-stat-card{
  background:rgba(13,26,58,.65);border:1px solid rgba(51,96,184,.2);border-left:3px solid transparent;
  padding:clamp(16px,2.5vh,26px) clamp(18px,2.5vw,30px);
  transition:border-color .3s,border-left-color .3s,background .3s;
}
.hero-stat-card:hover{background:rgba(17,34,71,.8);border-color:rgba(233, 8, 15, 0.92);border-left-color:var(--crimson)}
.stat-number{font-family:var(--font-head);font-weight:800;font-size:clamp(30px,4vw,42px);line-height:1;color:var(--white);letter-spacing:-.02em}
.stat-number .unit{font-size:.55em;color:#ff7070}
.stat-label{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#b8c0d0;margin-top:5px}
.stat-desc{font-size:13px;color:#8e9ab0;margin-top:2px;font-weight:300}

.hero-scroll{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:7px;animation:fadeIn 1s ease 1.3s both;z-index:1}
.hero-scroll span{font-family:var(--font-mono);font-size:9px;letter-spacing:.18em;color:var(--mist);text-transform:uppercase}
.scroll-line{width:1px;height:42px;background:linear-gradient(var(--crimson),transparent);animation:pulse 2s ease infinite}

/* ── TRUST BAR ── */
.trust-bar{position:relative;z-index:1;background:var(--crimson);overflow:hidden}
.trust-bar::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent 30%,rgba(255,255,255,.06) 50%,transparent 70%);
  background-size:200% 100%;animation:shimmer 5s linear infinite;
}
.trust-bar-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px);display:flex;align-items:center;flex-wrap:wrap;min-height:52px;position:relative;z-index:1}
.trust-item{display:flex;align-items:center;gap:8px;padding:13px clamp(12px,2vw,22px);border-right:1px solid rgba(255,255,255,.18);white-space:nowrap}
.trust-item:first-child{padding-left:0}
.trust-item:last-child{border-right:none}
.trust-item svg{width:14px;height:14px;flex-shrink:0;opacity:.85}
.trust-item span{font-family:var(--font-body);font-weight:600;font-size:12px;letter-spacing:.05em;color:var(--white);text-transform:uppercase}

/* ── COMMON SECTION ── */
section{position:relative;z-index:1;
background:
  radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
  radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
  linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);}
.section-inner{max-width:1440px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.section-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:12px}
.section-tag .line{width:30px;height:2px;background:var(--crimson);flex-shrink:0}
.section-tag span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--crimson-l)}
.section-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;line-height:.97;letter-spacing:.01em;margin-bottom:14px}
.section-sub{font-size:clamp(14px,1.6vw,16px);font-weight:300;color:var(--fog);line-height:1.75;max-width:600px}

/* ── WHAT WE DO ── */
.what-we-do{padding:clamp(56px,8vh,96px) 0;background:linear-gradient(180deg,var(--ink-2) 0%,var(--ink) 100%)}
.wwd-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center;margin-top:clamp(28px,4vh,52px)}
.wwd-copy{padding-right:clamp(12px,2vw,24px)}
.wwd-copy p{font-size:clamp(14px,1.5vw,16px);font-weight:300;line-height:1.8;color:var(--fog);margin-bottom:18px}
.wwd-copy p strong{color:var(--white);font-weight:500}
.vectomec-badge{display:inline-flex;flex-wrap:wrap;align-items:center;gap:10px;background:rgba(13,26,58,.6);border:1px solid rgba(192,24,30,.35);border-left:3px solid var(--crimson);padding:13px 18px;margin-top:6px}
.badge-label{font-family:var(--font-mono);font-size:14px;letter-spacing:.14em;color:var(--mist);text-transform:uppercase}
.badge-name{
  font-family:var(--font-head);font-weight:800;font-size:14px;letter-spacing:.12em;
  background:linear-gradient(135deg,var(--chrome-l),var(--chrome));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.badge-tm{font-size:10px;color:var(--chrome);-webkit-text-fill-color:var(--chrome);vertical-align:super}
.wwd-diagram{background:var(--ink-3);border:1px solid rgba(51,96,184,.18);padding:clamp(22px,3vw,38px);position:relative}
.wwd-diagram::before{content:'DELIVERY PROCESS';position:absolute;top:-1px;left:18px;background:var(--crimson);color:var(--white);font-family:var(--font-mono);font-size:9px;font-weight:500;letter-spacing:.16em;padding:3px 10px}
.flow-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.flow-row:last-of-type{margin-bottom:0}
.flow-box{flex:1;background:rgba(13,26,58,.5);border:1px solid rgba(51,96,184,.2);padding:13px 16px;text-align:center;transition:border-color .25s,background .25s}
.flow-box:hover{background:rgba(17,34,71,.8);border-color:rgba(192,24,30,.4)}
.fb-label{font-family:var(--font-mono);font-size:9px;letter-spacing:.12em;color:var(--crimson-l);text-transform:uppercase}
.fb-name{font-family:var(--font-head);font-weight:700;font-size:15px;color:var(--chrome);margin-top:3px}
.flow-arrow{color:var(--crimson);font-size:20px;opacity:.7;flex-shrink:0}
.partner-link{margin-top:16px;padding-top:13px;border-top:1px solid rgba(51,96,184,.15);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.partner-link span{font-size:12px;color:var(--mist);font-weight:300}
.partner-link a{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--teal-l);text-decoration:none;text-transform:uppercase;transition:color .2s}
.partner-link a:hover{color:var(--white)}

.wwd-pipeline{display:flex;align-items:center;justify-content:center;min-height:auto}
.pipeline{position:relative;max-width:520px;width:100%;margin:0;padding:0}
.pipeline::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,transparent,rgba(120,180,255,.25),transparent);transform:translateX(-50%)}
.flow{position:absolute;left:50%;top:0;width:4px;height:70px;background:linear-gradient(to bottom,transparent,#6aa6ff,transparent);transform:translateX(-50%);animation:moveFlow 3s linear infinite;opacity:.6}
@keyframes moveFlow{0%{top:0}100%{top:100%}}
.node{position:relative;display:flex;justify-content:flex-start;align-items:center;margin:32px 0;opacity:.25;transform:translateY(30px);transition:0.8s ease}
.node.active{opacity:1;transform:translateY(0)}
.node:nth-child(even){flex-direction:row-reverse}
.dot{width:14px;height:14px;border-radius:50%;background:var(--crimson);box-shadow:0 0 0 5px rgba(255,45,45,.15);position:absolute;left:50%;transform:translateX(-50%);z-index:2}
.content{width:100%;max-width:260px;position:relative;background:linear-gradient(145deg,#1b2433,#0e1420);padding:16px;border-radius:10px;border:1px solid rgba(255,255,255,.06);box-shadow:0 12px 32px rgba(0,0,0,.4)}
.phase{font-size:10px;letter-spacing:1.4px;color:#6aa6ff;text-transform:uppercase;margin-bottom:6px}
.title{font-family:var(--font-head);font-weight:700;font-size:14px;margin:5px 0 6px;color:var(--white)}
.desc{color:rgba(232,238,252,.75);line-height:1.4;font-size:11px}
.content::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.03) 1px,transparent 1px);background-size:16px 16px;opacity:.2;pointer-events:none;border-radius:10px}
@media(max-width:900px){.wwd-pipeline{min-height:auto}.node,.node:nth-child(even){flex-direction:column;align-items:flex-start}.content{width:100%;max-width:100%;margin-left:25px}.dot{left:12px}.pipeline{max-width:100%}.pipeline::before{left:12px}.wwd-grid{grid-template-columns:1fr}}

/* ── PRODUCTS ── */
.products{padding:clamp(56px,8vh,96px) 0;background:radial-gradient(ellipse 10% 30% at 35% 60%,rgba(8, 56, 146, 0.9) 0%,transparent 60%)}
.products-header{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:18px;margin-bottom:clamp(24px,3.5vh,40px)}
.products-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.product-card{
  background:var(--ink-2);padding:clamp(24px,3.5vw,42px) clamp(20px,3vw,34px);
  position:relative;overflow:hidden;cursor:pointer;
  text-decoration:none;display:block;color:inherit;
  border-left:3px solid transparent;
  transition:background .3s,border-left-color .3s;
}
.product-card:hover{background:var(--ink-3);border-left-color:var(--crimson)}
.product-card::before{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--crimson),var(--navy-glow));transform:scaleX(0);transform-origin:left;transition:transform .4s ease}
.product-card:hover::before{transform:scaleX(1)}
.product-card::after{content:'';position:absolute;top:0;right:0;width:55px;height:55px;background:linear-gradient(225deg,rgba(13,26,58,.45) 0%,transparent 60%);pointer-events:none}
.pc-number{font-family:var(--font-mono);font-size:10px;letter-spacing:.15em;color:var(--navy-glow);opacity:.7;margin-bottom:16px}
.pc-icon{width:46px;height:46px;margin-bottom:20px;color:var(--crimson-l);opacity:.85}
.pc-title{font-family:var(--font-head);font-weight:700;font-size:clamp(17px,2.2vw,23px);letter-spacing:.04em;text-transform:uppercase;color:var(--white);margin-bottom:5px;line-height:1.1}
.pc-subtitle{font-family:var(--font-mono);font-size:9px;letter-spacing:.12em;color:var(--navy-glow);text-transform:uppercase;margin-bottom:14px}
.pc-desc{font-size:clamp(12px,1.3vw,14px);font-weight:300;color:var(--mist);line-height:1.65;margin-bottom:22px}
.pc-items{list-style:none;display:flex;flex-direction:column;gap:7px}
.pc-items li{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--fog)}
.pc-items li::before{content:'';width:5px;height:5px;background:var(--crimson);flex-shrink:0;clip-path:polygon(50% 0%,100% 50%,50% 100%,0% 50%)}
.pc-arrow{position:absolute;bottom:clamp(18px,2.5vw,28px);right:clamp(18px,2.5vw,28px);width:32px;height:32px;border:1px solid rgba(192,24,30,.3);display:flex;align-items:center;justify-content:center;color:var(--crimson-l);transition:background .2s,transform .2s,border-color .2s}
.product-card:hover .pc-arrow{background:var(--crimson);color:var(--white);border-color:var(--crimson);transform:translate(3px,-3px)}

/* ── INDUSTRIES ── */
.industries{padding:clamp(56px,8vh,96px) 0;background:radial-gradient(ellipse 90% 70% at 65% 40%,rgba(8, 56, 146, 0.9) 0%,transparent 60%)/*background:linear-gradient(180deg,var(--navy-deep) 0%,var(--ink-2) 100%)*/}
.ind-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:clamp(24px,4vh,48px);flex-wrap:wrap;gap:20px}
.ind-legend{display:flex;gap:22px;flex-wrap:wrap}
.legend-item{display:flex;align-items:center;gap:7px}
.legend-dot{width:10px;height:10px;border-top:2px solid}
.legend-dot.served{border-color:var(--crimson)}
.legend-dot.target{border-color:var(--teal-l)}
.legend-item span{font-size:11px;color:var(--mist);font-family:var(--font-mono);letter-spacing:.1em;text-transform:uppercase}
.ind-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
.ind-card{background:rgba(10,12,18,.8);padding:clamp(20px,2.5vw,30px) clamp(16px,2vw,24px);border-top:2px solid transparent;transition:background .3s,border-top-color .3s}
.ind-card.served{border-top-color:var(--crimson)}
.ind-card.target{border-top-color:var(--teal-l);background:rgba(13,122,110,.04)}
.ind-card:hover{background:rgba(13,26,58,.5)}
.ind-badge{font-family:var(--font-mono);font-size:9px;letter-spacing:.15em;text-transform:uppercase;padding:3px 7px;margin-bottom:12px;display:inline-block}
.ind-card.served .ind-badge{background:rgba(192,24,30,.12);color:var(--crimson-l)}
.ind-card.target .ind-badge{background:rgba(13,122,110,.15);color:var(--teal-l)}
.ind-name{font-family:var(--font-head);font-weight:700;font-size:clamp(14px,1.8vw,17px);text-transform:uppercase;color:var(--chrome);margin-bottom:7px;line-height:1.1}
.ind-desc{font-size:12px;font-weight:300;color:var(--mist);line-height:1.5}

/* ── WHY ── */
.why{padding:clamp(56px,8vh,96px) 0;
background:
  radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
  radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
  linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);}
.why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;margin-top:clamp(24px,4vh,40px)}
.why-card{background:var(--ink-2);padding:clamp(26px,3.5vw,42px) clamp(20px,3vw,38px);position:relative;overflow:hidden;border-bottom:2px solid transparent;transition:border-bottom-color .3s,background .3s}
.why-card:hover{background:var(--ink-3);border-bottom-color:var(--crimson)}
.why-card::after{content:'';position:absolute;top:0;right:0;width:90px;height:90px;background:radial-gradient(circle at top right,rgba(13,26,58,.4),transparent 70%);pointer-events:none}
.why-num{font-family:var(--font-mono);font-size:11px;letter-spacing:.15em;color:var(--navy-glow);opacity:.6;margin-bottom:16px}
.why-icon{width:40px;height:40px;color:var(--crimson-l);margin-bottom:16px}
.why-title{font-family:var(--font-head);font-weight:700;font-size:clamp(17px,2vw,21px);text-transform:uppercase;letter-spacing:.04em;color:var(--chrome);margin-bottom:11px}
.why-text{font-size:clamp(13px,1.4vw,14px);font-weight:300;color:var(--fog);line-height:1.8}

/* ── TRACK RECORD (replaces awards) ── */
.track-record{padding:clamp(56px,7vh,88px) 0;background:radial-gradient(ellipse 90% 70% at 65% 40%,rgba(8, 56, 146, 0.9) 0%,transparent 60%);border-bottom:1px solid rgba(51,96,184,.15)}
.track-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.track-header{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:clamp(28px,4vh,48px)}
.track-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
.track-card{background:rgba(10,12,18,.7);padding:clamp(24px,3vw,36px) clamp(18px,2.5vw,28px);border-top:2px solid transparent;transition:border-top-color .3s,background .3s;position:relative;overflow:hidden}
.track-card:hover{background:rgba(13,26,58,.6);border-top-color:var(--crimson)}
.track-card::after{content:'';position:absolute;bottom:0;right:0;width:50px;height:50px;background:radial-gradient(circle at bottom right,rgba(51,96,184,.08),transparent 70%);pointer-events:none}
.track-number{font-family:var(--font-head);font-weight:800;font-size:clamp(38px,5vw,56px);line-height:1;letter-spacing:-.02em;color:var(--white);margin-bottom:4px}
.track-number .t-unit{font-size:.5em;color:#ff7070;font-weight:700}
.track-metric{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#7a8aaa;margin-bottom:10px}
.track-desc{font-size:13px;font-weight:300;color:#9098b0;line-height:1.6}
@media(max-width:900px){.track-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.track-grid{grid-template-columns:1fr 1fr}}

/* ── CTA ── */
.cta-band{padding:clamp(72px,11vh,112px) 0;
background:
  radial-gradient(ellipse 90% 70% at 35% 40%, rgba(8,56,146,0.9) 0%, transparent 60%),
  radial-gradient(ellipse 50% 60% at 95% 90%, rgba(192,24,30,.07) 0%, transparent 50%),
  linear-gradient(155deg, var(--navy-deep) 0%, var(--ink) 55%, var(--black) 100%);}
.cta-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 110%,rgba(192,24,30,.12),transparent 60%)}
.cta-band::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(208,212,220,.12) 40%,rgba(192,24,30,.3) 50%,rgba(208,212,220,.12) 60%,transparent)}
.cta-band-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px);text-align:center;position:relative;z-index:1}
.cta-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;color:var(--crimson-l);text-transform:uppercase;margin-bottom:18px}
.cta-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(36px,5.5vw,70px);text-transform:uppercase;line-height:.97;margin-bottom:16px}
.cta-headline .accent{color:var(--crimson-l)}
.cta-headline .chrome-grad{background:linear-gradient(135deg,var(--chrome-l),var(--chrome));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Products — VECTOMEC™ Equipment | Jayveecons Group"
  description="Explore Jayveecons VECTOMEC™ bulk material handling and processing equipment. Contact our Malur, Karnataka engineering team for product information, specifications, and a quote."
  keywords="VECTOMEC equipment, bulk material handling equipment India, screw conveyor, bucket elevator, ball mill, Jayveecons products"
  currentPath="/products"
>
  <section style="min-height:60vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:48px 24px; background:#f8fafc;">
    <div>
      <p style="font-family:var(--font-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#c0181e; margin-bottom:16px;">VECTOMEC™ Equipment Line</p>
      <h1 style="font-family:var(--font-head); font-size:clamp(32px,5vw,56px); font-weight:800; text-transform:uppercase; color:rgba(8,56,146,.9); margin-bottom:16px;">Product Catalogue<br><span style="color:#c0181e;">Coming Soon</span></h1>
      <p style="font-size:16px; font-weight:300; color:#2a3550; max-width:480px; line-height:1.7; margin-bottom:32px;">We are preparing a full interactive catalogue of VECTOMEC™ equipment. In the meantime, contact us directly for product information and quotes.</p>
      <a href="/contact" style="display:inline-flex; align-items:center; gap:10px; background:#c0181e; color:#fff; font-family:var(--font-head); font-weight:700; font-size:14px; letter-spacing:.1em; text-transform:uppercase; padding:16px 44px; text-decoration:none; clip-path:polygon(16px 0%,100% 0%,calc(100% - 16px) 100%,0% 100%);">Request a Quote →</a>
    </div>
  </section>
</BaseLayout>

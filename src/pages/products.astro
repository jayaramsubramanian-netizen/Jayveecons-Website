---
import BaseLayout          from '../layouts/BaseLayout.astro';
import ProductsPageHeader  from '../components/products/ProductsPageHeader.astro';
import ProductFilterBar    from '../components/products/ProductFilterBar.astro';
import ProductGrid         from '../components/products/ProductGrid.astro';
import ProductsRfqBand     from '../components/products/ProductsRfqBand.astro';
import ProductModal        from '../components/products/ProductModal.astro';
import { products }        from '../data/products';

const seo = {
  title: 'Products — VECTOMEC™ Equipment Line | Jayveecons Group',
  description: 'The complete VECTOMEC™ catalogue — material handling systems, processing equipment, and ancillary hardware for cement, mining, food, and waste management industries. Est. 1987, Bengaluru, India.',
  keywords: [
    'bulk material handling equipment India',
    'screw conveyor manufacturer India',
    'bucket elevator manufacturer India',
    'belt conveyor manufacturer Karnataka',
    'VSK vertical shaft kiln India',
    'ball mill manufacturer India',
    'crusher manufacturer India',
    'VECTOMEC equipment',
    'Jayveecons products',
    'industrial equipment Bengaluru',
  ].join(', '),
};

// Build category counts at build time — zero client JS needed
const categories = ['handling', 'processing', 'ancillary', 'accessories'] as const;
type Cat = typeof categories[number];
const counts = categories.reduce<Record<Cat, number>>((acc, c) => {
  acc[c] = products.filter(p => p.category === c).length;
  return acc;
}, {} as Record<Cat, number>);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  currentPath="/products"
>
  <!-- 1. Page header — DARK navy gradient -->
  <ProductsPageHeader />

  <!-- 2. Sticky filter bar + search — thin dark bar -->
  <ProductFilterBar counts={counts} />

  <!-- 3. All product cards — alternating dark/light by category -->
  <ProductGrid products={products} />

  <!-- 4. RFQ closing band — DARK navy gradient -->
  <ProductsRfqBand />

  <!--
    5. Modal — single instance, populated by JS on card click.
       Rendered once in the DOM; content swapped via data attributes.
       client:load so the dialog JS is available immediately after paint.
  -->
  <ProductModal />

  <!-- JSON-LD structured data — rendered at build time -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "VECTOMEC™ Equipment Catalogue — Jayveecons Group",
    "description": seo.description,
    "url": "https://www.jayveecons.com/products",
    "numberOfItems": products.length,
    "itemListElement": products.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": p.name,
      "description": p.shortDesc,
      "url": `https://www.jayveecons.com/products#${p.id}`,
    }))
  })}</script>

</BaseLayout>




---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Products — Jayveecons"
  description="The complete VECTOMEC™ catalogue — material handling systems, processing equipment, and ancillary hardware for every stage of your bulk processing operation."
  currentPath="/products"
>

<style>
.page-header{position:relative;padding:130px 0 60px;overflow:hidden;background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 55%,var(--black) 100%)}
.page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 60% 50%,rgba(26,50,96,.6),transparent 65%)}
.page-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.page-header-inner{position:relative;z-index:1;max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:18px;font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.breadcrumb a{color:#7a8499;text-decoration:none;transition:color .2s}
.breadcrumb a:hover{color:var(--fog)}
.breadcrumb .sep{color:#3a4255}
.breadcrumb .current{color:#ff7070}
.page-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:14px;animation:fadeUp .7s ease .1s both}
.page-eyebrow-line{width:40px;height:2px;background:var(--crimson)}
.page-eyebrow span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.page-title{font-family:var(--font-head);font-weight:800;font-size:clamp(44px,6.5vw,84px);text-transform:uppercase;line-height:.93;letter-spacing:-.01em;margin-bottom:16px;animation:fadeUp .7s ease .2s both}
.page-title .accent{color:var(--crimson-l)}
.page-title .chrome{background:linear-gradient(135deg,var(--chrome-l),var(--chrome));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.page-sub{font-size:clamp(14px,1.7vw,17px);font-weight:300;color:var(--fog);max-width:600px;line-height:1.75;animation:fadeUp .7s ease .3s both}

/* Vectomec badge in header */
.vectomec-header-badge{
  display:inline-flex;align-items:center;gap:12px;
  margin-top:20px;
  background:rgba(13,26,58,.6);border:1px solid rgba(192,24,30,.3);border-left:3px solid var(--crimson);
  padding:12px 20px;
  animation:fadeUp .7s ease .4s both;
}
.vhb-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:#7a8aaa;text-transform:uppercase}
.vhb-name{
  font-family:var(--font-head);font-weight:800;font-size:22px;letter-spacing:.12em;
  background:linear-gradient(135deg,var(--chrome-l),var(--chrome));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.vhb-desc{font-size:13px;font-weight:300;color:var(--mist)}

/* ═══ COMMON ═══ */
section{position:relative;z-index:1}
.section-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.section-tag{display:inline-flex;align-items:center;gap:10px;margin-bottom:12px}
.section-tag .line{width:28px;height:2px;background:var(--crimson)}
.section-tag span{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#ff7070}
.section-headline{font-family:var(--font-head);font-weight:font-weight: 800; font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:14px}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--crimson);color:var(--white);font-family:var(--font-head);font-weight:700;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:12px 28px;clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);transition:background .2s,transform .2s;white-space:nowrap;border:none;cursor:pointer}
.btn-primary:hover{background:var(--crimson-l);transform:translateX(2px)}
.btn-secondary{display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--chrome);font-family:var(--font-head);font-weight:600;font-size:14px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 28px;border:1px solid rgba(208,212,220,.2);transition:color .2s,border-color .2s;white-space:nowrap}
.btn-secondary:hover{color:var(--white);border-color:rgba(208,212,220,.5)}

/* ═══ CATEGORY FILTER TABS ═══ */
.filter-section{
  position:sticky;top:70px;z-index:50;
  background:rgba(6,7,10,.96);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(51,96,184,.15);
  padding:0 clamp(18px,4vw,48px);
}
.filter-inner{
  max-width:1280px;margin:0 auto;
  display:flex;align-items:stretch;gap:0;
  overflow-x:auto;
  scrollbar-width:none;
}
.filter-inner::-webkit-scrollbar{display:none}
.filter-tab{
  display:flex;align-items:center;gap:8px;
  padding:16px clamp(12px,2.5vw,28px);
  font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
  color:#7a8aaa;background:none;border:none;cursor:pointer;
  border-bottom:2px solid transparent;
  transition:color .2s,border-color .2s;
  white-space:nowrap;flex-shrink:0;
}
.filter-tab:hover{color:var(--fog)}
.filter-tab.active{color:var(--white);border-bottom-color:var(--crimson)}
.filter-tab .tab-count{
  font-size:10px;
  background:rgba(192,24,30,.15);
  color:var(--crimson-l);
  padding:2px 6px;
  border-radius:20px;
}
.filter-tab.active .tab-count{background:var(--crimson);color:var(--white)}
.filter-search{
  margin-left:auto;
  padding:10px 16px;
  display:flex;align-items:center;gap:8px;
  flex-shrink:0;
}
.filter-search input{
  background:rgba(13,26,58,.5);
  border:1px solid rgba(51,96,184,.25);
  color:var(--white);
  font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;
  padding:8px 14px;
  width:200px;
  outline:none;transition:border-color .2s;
}
.filter-search input::placeholder{color:#3d4660}
.filter-search input:focus{border-color:rgba(192,24,30,.5)}
.filter-search svg{width:14px;height:14px;color:var(--mist);flex-shrink:0}

/* ═══ PRODUCT GRID ═══ */
.products-section{padding:clamp(40px,6vh,72px) 0}
.products-section + .products-section{padding-top:0}

/* Category header */
.cat-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  flex-wrap:wrap;gap:16px;
  margin-bottom:clamp(20px,3vh,36px);
  padding-bottom:16px;
  border-bottom:1px solid rgba(51,96,184,.15);
}
.cat-header-left{}
.cat-label{font-family:var(--font-mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#ff7070;margin-bottom:4px}
.cat-title{font-family:var(--font-head);font-weight:font-weight: 800; font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;letter-spacing:.02em;color:var(--white);line-height:1}
.cat-desc{font-size:14px;font-weight:300;color:var(--mist);margin-top:6px;max-width:600px;line-height:1.6}
.cat-badge{
  font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;
  background:rgba(13,26,58,.6);border:1px solid rgba(51,96,184,.25);
  color:#5580cc;padding:6px 14px;white-space:nowrap;align-self:flex-start;
}

/* Grid */
.prod-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(clamp(260px, 28vw, 340px), 1fr));
  gap:2px;
}

/* Product card */
.prod-card{
  background:var(--ink-2);
  display:flex;flex-direction:column;
  border-left:3px solid transparent;
  transition:background .3s,border-left-color .3s;
  position:relative;overflow:hidden;
  cursor:pointer;
}
.prod-card:hover{background:var(--ink-3);border-left-color:var(--crimson)}
.prod-card.hidden{display:none}

/* Image area */
.prod-img{
  position:relative;
  height:clamp(160px,20vw,220px);
  overflow:hidden;
  background:var(--navy-deep);
  flex-shrink:0;
}
.prod-img img{
  width:100%;height:100%;
  object-fit:cover;
  filter:grayscale(30%) contrast(1.1);
  transition:transform .5s ease,filter .3s;
  display:block;
}
.prod-card:hover .prod-img img{transform:scale(1.05);filter:grayscale(10%) contrast(1.15)}
/* Placeholder for cards without images */
.prod-img-placeholder{
  width:100%;height:100%;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--navy-deep),var(--ink-3));
}
.prod-img-placeholder svg{width:52px;height:52px;color:rgba(51,96,184,.35)}
/* Gradient overlay on image */
.prod-img::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,transparent 50%,rgba(10,12,18,.9) 100%);
}
/* Series badge on image */
.prod-series{
  position:absolute;top:10px;left:10px;z-index:2;
  font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  background:rgba(192,24,30,.85);color:var(--white);
  padding:3px 8px;backdrop-filter:blur(4px);
}

/* Card body */
.prod-body{padding:clamp(16px,2.5vw,24px);display:flex;flex-direction:column;flex:1;gap:0}
.prod-category{font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#5580cc;margin-bottom:6px}
.prod-name{font-family:var(--font-head);font-weight:700;font-size:clamp(17px,2.2vw,22px);text-transform:uppercase;letter-spacing:.04em;color:var(--white);margin-bottom:8px;line-height:1.1}
.prod-desc{font-size:13px;font-weight:300;color:#9098b0;line-height:1.6;margin-bottom:14px;flex:1}

/* Applications pills */
.prod-apps{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:16px}
.prod-app{
  font-family:var(--font-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  background:rgba(13,26,58,.7);border:1px solid rgba(51,96,184,.2);
  color:#7a8aaa;padding:3px 8px;
}
/* Card footer */
.prod-footer{
  display:flex;align-items:center;justify-content:space-between;
  padding-top:12px;border-top:1px solid rgba(51,96,184,.12);
}
.prod-rfq{
  font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--crimson-l);text-decoration:none;
  display:flex;align-items:center;gap:6px;
  transition:color .2s;
}
.prod-rfq:hover{color:var(--white)}
.prod-rfq svg{width:12px;height:12px}
.prod-detail-btn{
  font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;
  color:#5580cc;background:none;border:none;cursor:pointer;padding:0;
  transition:color .2s;display:flex;align-items:center;gap:5px;
}
.prod-detail-btn:hover{color:var(--fog)}
.prod-detail-btn svg{width:12px;height:12px}

/* ═══ FEATURED PRODUCT DETAIL ═══ */
.prod-detail-panel{
  display:none;
  background:rgba(13,26,58,.4);
  border:1px solid rgba(51,96,184,.2);
  border-left:3px solid var(--crimson);
  padding:clamp(24px,3vw,40px);
  margin-bottom:2px;
  grid-column:1/-1;
}
.prod-detail-panel.open{
  display:block;
  animation:cardIn .35s ease both;
}
.pdp-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(24px,4vw,56px);align-items:start}
.pdp-close{
  float:right;
  font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--mist);background:none;border:none;cursor:pointer;padding:0;
  transition:color .2s;display:flex;align-items:center;gap:5px;
}
.pdp-close:hover{color:var(--white)}
.pdp-close svg{width:12px;height:12px}
.pdp-name{font-family:var(--font-head);font-weight:800;font-size:clamp(24px,3.5vw,38px);text-transform:uppercase;letter-spacing:.02em;color:var(--white);margin-bottom:8px}
.pdp-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;background:var(--crimson);color:var(--white);padding:3px 10px;display:inline-block;margin-bottom:16px}
.pdp-desc{font-size:clamp(14px,1.5vw,15px);font-weight:300;color:var(--fog);line-height:1.8;margin-bottom:20px}
.pdp-specs-title{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#ff7070;margin-bottom:12px}
.pdp-specs{display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
.spec-row{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:8px 0;border-bottom:1px solid rgba(51,96,184,.1)}
.spec-row:last-child{border-bottom:none}
.spec-key{font-size:12px;font-weight:500;color:var(--chrome-d);flex-shrink:0;font-family:var(--font-mono);letter-spacing:.06em;min-width:120px}
.spec-val{font-size:13px;font-weight:300;color:var(--fog);text-align:right;line-height:1.4}
.pdp-apps-title{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#ff7070;margin-bottom:10px}
.pdp-apps-list{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:24px}
.pdp-app-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:rgba(13,26,58,.8);border:1px solid rgba(51,96,184,.3);color:#7ab0ff;padding:5px 12px}
.pdp-actions{display:flex;gap:12px;flex-wrap:wrap}

/* Detail panel anchor — panels are moved here by JS, outside the grid */
.detail-anchor{width:100%}
.detail-anchor .prod-detail-panel{display:none;width:100%;box-sizing:border-box}
.detail-anchor .prod-detail-panel.open{display:block;animation:cardIn .35s ease both}

/* ═══ NO RESULTS ═══ */
.no-results{
  grid-column:1/-1;
  text-align:center;padding:64px 24px;
  display:none;
}
.no-results.show{display:block}
.no-results p{font-size:15px;color:var(--mist);margin-bottom:16px}

/* ═══ RFQ CTA BAND ═══ */
.rfq-band{
  padding:clamp(60px,8vh,96px) 0;
  background:linear-gradient(155deg,var(--navy-deep) 0%,var(--ink) 60%);
  position:relative;overflow:hidden;
}
.rfq-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 110%,rgba(192,24,30,.1),transparent 60%)}
.rfq-band::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(192,24,30,.3) 50%,transparent)}
.rfq-band-inner{
  position:relative;z-index:1;
  max-width:1280px;margin:0 auto;
  padding:0 clamp(18px,4vw,48px);
  display:grid;grid-template-columns:1fr auto;
  gap:clamp(24px,4vw,56px);
  align-items:center;
}
.rfq-band-copy{}
.rfq-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;color:#ff7070;text-transform:uppercase;margin-bottom:12px}
.rfq-headline{font-family:var(--font-head);font-weight:800;font-size:clamp(32px,4.5vw,56px);text-transform:uppercase;line-height:.97;margin-bottom:10px}
.rfq-headline .accent{color:var(--crimson-l)}
.rfq-sub{font-size:clamp(14px,1.5vw,16px);font-weight:300;color:var(--fog);line-height:1.65;max-width:580px}
.rfq-actions{display:flex;flex-direction:column;gap:12px;align-items:flex-end}

/* ═══ FOOTER ═══ */
footer{background:var(--black);border-top:1px solid rgba(51,96,184,.14);padding:clamp(44px,6vh,60px) 0 26px}
.footer-inner{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,48px)}
.footer-top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:clamp(24px,4vw,56px);margin-bottom:40px}
.footer-logo-wrap{display:flex;align-items:center;gap:11px;margin-bottom:9px}
.footer-logo-img{height:38px;width:auto}
.footer-logo-name{font-family:var(--font-head);font-weight:800;font-size:19px;letter-spacing:.1em;text-transform:uppercase;color:var(--white)}
.footer-tagline{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:#ff7070;text-transform:uppercase;margin-bottom:13px}
.footer-desc{font-size:14px;font-weight:300;color:#9098ac;line-height:1.75;max-width:260px}
.footer-heading{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#ff7070;margin-bottom:16px}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:8px}
.footer-links a{font-size:14px;color:#a0a8bc;text-decoration:none;transition:color .2s;font-weight:400}
.footer-links a:hover{color:var(--chrome)}
.footer-contact-item{display:flex;flex-direction:column;gap:2px;margin-bottom:11px}
.footer-contact-item .label{font-family:var(--font-mono);font-size:10px;letter-spacing:.15em;color:#5580cc;text-transform:uppercase}
.footer-contact-item .value{font-size:14px;color:#c0c8d8;font-weight:400}
.footer-bottom{border-top:1px solid rgba(51,96,184,.1);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.footer-copy{font-size:13px;color:#7a8499;font-weight:300}
.footer-copy a{color:var(--teal-l);text-decoration:none}
.footer-legal{display:flex;gap:16px;flex-wrap:wrap}
.footer-legal a{font-size:13px;color:#7a8499;text-decoration:none;transition:color .2s}
.footer-legal a:hover{color:var(--fog)}

/* ═══ RESPONSIVE ═══ */
@media(max-width:1024px){
  .pdp-grid{grid-template-columns:1fr}
  .rfq-band-inner{grid-template-columns:1fr}
  .rfq-actions{align-items:flex-start;flex-direction:row}
  .footer-top{grid-template-columns:1fr 1fr;gap:28px}
}
@media(max-width:768px){
  .filter-search{display:none}
  .prod-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
  .prod-grid{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr}
  .rfq-actions{flex-direction:column}
}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(20px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes cardIn{
  from{opacity:0;transform:translateY(12px)}
  to{opacity:1;transform:translateY(0)}
}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  .reveal{opacity:1;transform:none}
}
</style>

<!-- PAGE HEADER -->
<div class="page-header">

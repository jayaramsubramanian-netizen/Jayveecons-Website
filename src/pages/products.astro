<script is:inline>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Scroll reveal ── */
  const revealObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

  /* ── Data ── */
  const allCards = Array.from(document.querySelectorAll('.prod-card'));
  const sections = {
    handling:    document.getElementById('handling-section'),
    processing:  document.getElementById('processing-section'),
    ancillary:   document.getElementById('ancillary-section'),
    accessories: document.getElementById('accessories-section'),
  };
  const STICKY_OFFSET = 110;

  /* ── Filter + scroll ── */
  function applyFilter(cat, query, shouldScroll) {
    let visibleCount = 0;
    const q = query.trim().toLowerCase();
    allCards.forEach(card => {
      const cardCat  = card.dataset.cat;
      const cardName = (card.dataset.name || '') + ' ' + (card.querySelector('.prod-name') ? card.querySelector('.prod-name').textContent : '');
      const catMatch = cat === 'all' || cardCat === cat;
      const qMatch   = !q || cardName.toLowerCase().includes(q);
      const show     = catMatch && qMatch;
      card.classList.toggle('hidden', !show);
      if (!show) {
        card.querySelectorAll('.prod-detail-panel').forEach(p => p.classList.remove('open'));
      }
      if (show) visibleCount++;
    });
    Object.entries(sections).forEach(function(entry) {
      const key = entry[0]; const sec = entry[1];
      if (!sec) return;
      const catMatch = cat === 'all' || cat === key;
      const hasCards = sec.querySelectorAll('.prod-card:not(.hidden)').length > 0;
      sec.style.display = (catMatch && hasCards) ? '' : 'none';
    });
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('show', visibleCount === 0 && q.length > 0);
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    const activeTab = document.querySelector('.filter-tab[data-cat="' + cat + '"]');
    if (activeTab) activeTab.classList.add('active');
    if (shouldScroll) {
      const targetSection = cat === 'all' ? sections.handling : (sections[cat] || null);
      if (targetSection) {
        const top = targetSection.getBoundingClientRect().top + window.scrollY - STICKY_OFFSET;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    }
  }

  /* ── Tab clicks ── */
  document.querySelectorAll('.filter-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      applyFilter(tab.dataset.cat, document.getElementById('search-input').value, true);
    });
  });

  /* ── Search input ── */
  var searchTimer;
  document.getElementById('search-input').addEventListener('input', function(e) {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function() {
      const activeTab = document.querySelector('.filter-tab.active');
      applyFilter(activeTab ? activeTab.dataset.cat : 'all', e.target.value, false);
    }, 180);
  });

  /* ── Move detail panels outside the grid so they display full-width ── */
  function setupPanels() {
    document.querySelectorAll('.prod-grid').forEach(function(grid) {
      var anchor = document.createElement('div');
      anchor.className = 'detail-anchor';
      grid.parentNode.insertBefore(anchor, grid.nextSibling);
      grid.querySelectorAll('.prod-detail-panel').forEach(function(panel) {
        anchor.appendChild(panel);
      });
    });
  }
  setupPanels();

  /* ── Toggle detail panel — exposed to window for onclick handlers ── */
  window.toggleDetail = function(id) {
    var panel = document.getElementById(id);
    if (!panel) return;
    var isOpen = panel.classList.contains('open');
    document.querySelectorAll('.prod-detail-panel.open').forEach(function(p) { p.classList.remove('open'); });
    if (!isOpen) {
      panel.classList.add('open');
      setTimeout(function() { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 80);
    }
  };

  /* ── Clear search — exposed to window for onclick handler ── */
  window.clearSearch = function() {
    document.getElementById('search-input').value = '';
    applyFilter('all', '', false);
  };

  /* ── Stagger card entrance animation ── */
  allCards.forEach(function(card, i) {
    card.style.opacity = '0';
    card.style.transform = 'translateY(18px)';
    card.style.transition = 'opacity .5s ease ' + (i * 40) + 'ms, transform .5s ease ' + (i * 40) + 'ms, background .3s, border-left-color .3s';
    setTimeout(function() {
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    }, 100 + i * 40);
  });

  /* ── Tab counts ── */
  var cats = { all: 0, handling: 0, processing: 0, ancillary: 0, accessories: 0 };
  allCards.forEach(function(c) {
    cats.all++;
    if (cats[c.dataset.cat] !== undefined) cats[c.dataset.cat]++;
  });
  Object.keys(cats).forEach(function(k) {
    var el = document.getElementById('count-' + k);
    if (el) el.textContent = cats[k];
  });

  /* ── Copy year ── */
  var copyYearEl = document.getElementById('copy-year');
  if (copyYearEl) copyYearEl.textContent = new Date().getFullYear();

}); // end DOMContentLoaded
</script>

